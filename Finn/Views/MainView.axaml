<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="clr-namespace:Finn.ViewModels"
			 xmlns:views="clr-namespace:Finn.Views"
			 xmlns:model="using:Finn.Model"
			 xmlns:mupdf="clr-namespace:MuPDFCore.MuPDFRenderer;assembly=MuPDFCore.MuPDFRenderer"
			 xmlns:converter="clr-namespace:Finn.Converters"
			 xmlns:controls="clr-namespace:Finn.Controls"
			 xmlns:ic="using:FluentIcons.Avalonia" 
			 mc:Ignorable="d"
             x:Class="Finn.Views.MainView"
             x:DataType="vm:MainViewModel"
             ClipToBounds="False">

	<Design.DataContext>
		<vm:MainViewModel />
	</Design.DataContext>

	<UserControl.Resources>
		<converter:AddOneConverter x:Key="AddOneConverter" />
		<converter:BitmapConverter x:Key="BitmapConverter" />
		<converter:ByteArrayToBitmapConverter x:Key="ByteArrayToBitmapConverter" />
		<converter:GridDefConverter x:Key="GridDefConverter" />
		<converter:RowDefConverter x:Key="RowDefConverter" />
		<converter:FolderModeIconConverter x:Key="FolderModeIconConverter" />

		<!-- Tag color palette — defined here so StaticResource resolves inside detached ContextMenus and flyouts -->
		<SolidColorBrush x:Key="TagColorYellow"  Color="#E5A820"/>
		<SolidColorBrush x:Key="TagColorOrange"  Color="#E06830"/>
		<SolidColorBrush x:Key="TagColorBrown"   Color="#9C6B3C"/>
		<SolidColorBrush x:Key="TagColorGreen"   Color="#3DA35F"/>
		<SolidColorBrush x:Key="TagColorBlue"    Color="#3B82D9"/>
		<SolidColorBrush x:Key="TagColorRed"     Color="#D64045"/>
		<SolidColorBrush x:Key="TagColorMagenta" Color="#9B5FC0"/>

		<FontFamily x:Key="Barlow">avares://Finn/Assets/Fonts#Barlow</FontFamily>
		<FontFamily x:Key="Fira Sans">avares://Finn/Assets/Fonts#Fira Sans</FontFamily>
		<FontFamily x:Key="IBM Plex Sans">avares://Finn/Assets/Fonts#IBM Plex Sans</FontFamily>
		<FontFamily x:Key="Jost">avares://Finn/Assets/Fonts#Jost</FontFamily>
		<FontFamily x:Key="Lato">avares://Finn/Assets/Fonts#Lato</FontFamily>
		<FontFamily x:Key="Lexend Deca">avares://Finn/Assets/Fonts#Lexend Deca</FontFamily>
		<FontFamily x:Key="Montserrat">avares://Finn/Assets/Fonts#Montserrat</FontFamily>
		<FontFamily x:Key="Nunito">avares://Finn/Assets/Fonts#Nunito</FontFamily>
		<FontFamily x:Key="Open Sans">avares://Finn/Assets/Fonts#Open Sans</FontFamily>
		<FontFamily x:Key="Quicksand">avares://Finn/Assets/Fonts#Quicksand</FontFamily>
		<FontFamily x:Key="Raleway">avares://Finn/Assets/Fonts#Raleway</FontFamily>
		<FontFamily x:Key="Recursive">avares://Finn/Assets/Fonts#Recursive</FontFamily>
		<FontFamily x:Key="Roboto">avares://Finn/Assets/Fonts#Roboto</FontFamily>
		<FontFamily x:Key="Rosario">avares://Finn/Assets/Fonts#Rosario</FontFamily>
		<FontFamily x:Key="Share Tech">avares://Finn/Assets/Fonts#Share Tech</FontFamily>
		<FontFamily x:Key="Source Code Pro">avares://Finn/Assets/Fonts#Source Code Pro</FontFamily>
		<FontFamily x:Key="Ubuntu">avares://Finn/Assets/Fonts#Ubuntu</FontFamily>
		<FontFamily x:Key="Urbanist">avares://Finn/Assets/Fonts#Urbanist</FontFamily>
		<FontFamily x:Key="Work Sans">avares://Finn/Assets/Fonts#Work Sans</FontFamily>

		<!-- Shared styles as reusable resources to reduce duplication -->
		<ControlTemplate x:Key="ThumbnailTooltipTemplate">
			<Panel Background="{DynamicResource AppFlyoutSurfaceBrush}">
				<Image Source="{Binding (model:FileData).ThumbnailSource, Converter={StaticResource BitmapConverter}, Mode=OneWay}"/>
			</Panel>
		</ControlTemplate>

		<ControlTheme x:Key="OverlayFlyout" TargetType="FlyoutPresenter" BasedOn="{StaticResource {x:Type FlyoutPresenter}}">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="MinWidth" Value="0"/>
			<Setter Property="MinHeight" Value="0"/>
			<Setter Property="CornerRadius" Value="0"/>
		</ControlTheme>

		<!-- Compact checkbox for use inside tight DataGrid rows -->
		<ControlTheme x:Key="CompactCheckBox" TargetType="CheckBox">
			<Setter Property="MinWidth" Value="0"/>
			<Setter Property="MinHeight" Value="0"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<ControlTemplate>
					<Border Name="Root" Width="14" Height="14" CornerRadius="2"
							BorderThickness="1.5"
							BorderBrush="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"
							Background="Transparent"
							HorizontalAlignment="Center" VerticalAlignment="Center">
						<Border Name="Fill" Width="8" Height="8" CornerRadius="1"
								IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"
								Background="{DynamicResource SystemControlForegroundAltHighBrush}"/>
					</Border>
				</ControlTemplate>
			</Setter>
			<Style Selector="^:checked /template/ Border#Root">
				<Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
				<Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
			</Style>
			<Style Selector="^:checked /template/ Border#Fill">
				<Setter Property="IsVisible" Value="True"/>
			</Style>
			<Style Selector="^:pointerover /template/ Border#Root">
				<Setter Property="Opacity" Value="0.8"/>
			</Style>
		</ControlTheme>

	</UserControl.Resources>

	<UserControl.Styles>
       <!-- Compact flyout presenter for toolbox popup -->
		<Style Selector="FlyoutPresenter.compact">
			<Setter Property="Padding" Value="2"/>
			<Setter Property="Margin" Value="0"/>
			<Setter Property="MinWidth" Value="0"/>
			<Setter Property="MinHeight" Value="30"/>
			<Setter Property="BorderThickness" Value="0"/>
		</Style>

		<!-- Global style: hide focus visual on all DataGridCells -->
		<Style Selector="DataGridCell:current /template/ Grid#FocusVisual">
			<Setter Property="IsVisible" Value="false"/>
		</Style>

		<!-- Thumbnail tooltip styles applied to any DataGrid with the ThumbnailGrid class -->
		<Style Selector="DataGrid.ThumbnailGrid ToolTip">
			<Setter Property="Template" Value="{StaticResource ThumbnailTooltipTemplate}"/>
			<Setter Property="MaxWidth" Value="500"/>
			<Setter Property="MaxHeight" Value="500"/>
		</Style>
		<Style Selector="DataGrid.ThumbnailGrid DataGridRow">
			<Setter Property="ToolTip.Tip" Value="{Binding (model:FileData).Namn}"/>
		</Style>

		<!-- Smooth opacity for toggled panels -->
		<Style Selector="Grid.AnimatedPanel">
			<Setter Property="Transitions">
				<Transitions>
					<DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
				</Transitions>
			</Setter>
		</Style>

		<!-- Fade-in for drag-and-drop overlays -->
		<Style Selector="Border.DropHint">
			<Setter Property="Opacity" Value="0"/>
			<Setter Property="IsHitTestVisible" Value="False"/>
			<Setter Property="Transitions">
				<Transitions>
					<DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut"/>
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="Border.DropHint.Active">
			<Setter Property="Opacity" Value="1"/>
		</Style>

		<!-- Empty state hint when DataGrid has no rows -->
		<Style Selector="DataGrid:empty /template/ Border#DataGridBorder">
			<Setter Property="Opacity" Value="0.6"/>
		</Style>

		<!-- Add to UserControl.Styles -->
		<Style Selector="DataGrid.ThumbnailGrid DataGridRow:pointerover">
			<Setter Property="Cursor" Value="Arrow"/>
		</Style>

		<!-- Disabled buttons: transparent background, faded foreground -->
		<!-- (Styles moved to App.axaml for global scope — applies to windowed previewer too) -->

		<!-- Accent tint on checked tray panel checkboxes -->
		<Style Selector="CheckBox.TrayToggle:checked">
			<Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}"/>
		</Style>

		<!-- Alternating row shading for DataGrids (toggled via UI setting) -->
		<Style Selector="DataGrid.AltRows DataGridRow:nth-child(2n)">
			<Setter Property="Background">
				<Setter.Value>
					<SolidColorBrush Color="{DynamicResource SystemBaseLowColor}" Opacity="0.20"/>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Subtle fade for rows appearing/disappearing during expand/collapse -->
		<Style Selector="DataGrid.ThumbnailGrid DataGridRow">
			<Setter Property="Transitions">
				<Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.28" Easing="CubicEaseOut"/>
				</Transitions>
			</Setter>
		</Style>

		<!-- Group placeholders stay visually normal; hierarchy is shown by the spine/chevron only -->
		<Style Selector="DataGridRow.GroupRow">
			<Setter Property="FontWeight" Value="Normal"/>
		</Style>
		<Style Selector="DataGridRow.GroupRow DataGridCell">
			<Setter Property="FontWeight" Value="Normal"/>
		</Style>
		<Style Selector="DataGridRow.GroupRow DataGridCell TextBlock">
			<Setter Property="FontWeight" Value="Normal"/>
		</Style>

		<!-- Themed row hover / selection for all DataGrids -->
		<Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
			<Setter Property="Fill" Value="{DynamicResource AppRowHoverBrush}"/>
			<Setter Property="Opacity" Value="1"/>
		</Style>
		<Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
			<Setter Property="Fill" Value="{DynamicResource AppRowSelectionBrush}"/>
			<Setter Property="Opacity" Value="1"/>
		</Style>
		<Style Selector="DataGridRow:selected:pointerover /template/ Rectangle#BackgroundRectangle">
			<Setter Property="Fill" Value="{DynamicResource AppRowSelectionBrush}"/>
			<Setter Property="Opacity" Value="1"/>
		</Style>

		<!-- Toolbar ToggleButtons: tint with accent colour when checked -->
		<Style Selector="ToggleButton:checked">
			<Setter Property="Background" Value="{DynamicResource AppRowSelectionBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
			<Setter Property="BorderThickness" Value="0,0,0,2"/>
		</Style>
		<Style Selector="ToggleButton:checked:pointerover">
			<Setter Property="Background" Value="{DynamicResource AppRowSelectionBrush}"/>
		</Style>

		<!-- Splitter grip dots: fade in on pointer-over -->
		<Style Selector="GridSplitter:pointerover /template/ StackPanel#GripDots">
			<Setter Property="Opacity" Value="0.5"/>
		</Style>

		<!-- Direct file attachments are slightly subdued; group children stay normal -->
		<Style Selector="DataGridRow.AttachedChildRow">
			<Setter Property="Opacity" Value="0.86"/>
		</Style>
	</UserControl.Styles>

	<Grid Name="MainGrid" DragDrop.AllowDrop="True"
		  ColumnDefinitions="Auto,*,0,0,Auto"
		  RowDefinitions="35,40,*"
		  Margin="5"
		  ClipToBounds="False">

		<!-- ═══════════════════════════════════════════════ -->
		<!-- Row 0: Top bar (menu, status, toolbar)         -->
		<!-- ═══════════════════════════════════════════════ -->

		<!-- File menu -->
		<DockPanel Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Top" HorizontalAlignment="Left"
				   WindowDecorationProperties.ElementRole="User">
			<Menu DockPanel.Dock="Top" FontSize="15" FontFamily="Default">
				<MenuItem Header="File">
					<MenuItem Header="Load"    InputGesture="Ctrl+O" Click="OnLoadFile">
						<MenuItem.Icon><ic:SymbolIcon Symbol="FolderOpen"/></MenuItem.Icon>
					</MenuItem>
					<Separator/>
					<MenuItem Header="Save"    HotKey="Ctrl+S" Click="OnSaveFileAuto">
						<MenuItem.Icon><ic:SymbolIcon Symbol="Save"/></MenuItem.Icon>
					</MenuItem>
					<MenuItem Header="Save As" InputGesture="Ctrl+Shift+S" Click="OnSaveFile">
						<MenuItem.Icon><ic:SymbolIcon Symbol="SaveEdit"/></MenuItem.Icon>
					</MenuItem>
					<Separator/>
					<MenuItem Header="Backup"  Command="{Binding BackupSaveFile}">
						<MenuItem.Icon><ic:SymbolIcon Symbol="CloudArrowUp"/></MenuItem.Icon>
					</MenuItem>
					<MenuItem Header="Reset"   Command="{Binding ResetPreviewer}">
						<MenuItem.Icon><ic:SymbolIcon Symbol="ArrowReset"/></MenuItem.Icon>
					</MenuItem>
				</MenuItem>
			</Menu>
		</DockPanel>

		<!-- Center status message -->
			<StackPanel Grid.Row="0" Grid.ColumnSpan="5" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
						Spacing="4">
				<Ellipse Width="8" Height="8" Fill="{DynamicResource SystemAccentColor}"
						 IsVisible="{Binding IsDirty}" IsHitTestVisible="False"
						 ToolTip.Tip="Unsaved changes"/>
				<ic:SymbolIcon Symbol="Status" IconVariant="Regular" IsHitTestVisible="False" Width="20" FontSize="13" Opacity="0.5"/>
				<TextBlock Text="{Binding PreviewVM.StatusMessage}" VerticalAlignment="Center" IsHitTestVisible="False"
						   FontStyle="Italic" FontSize="13" Opacity="0.5" Padding="0"/>
			</StackPanel>

		<!-- Progress bar (shared: thumbnails, metadata, pre-caching, etc.) -->
		<StackPanel Grid.Row="0" Grid.ColumnSpan="5" Orientation="Horizontal" Margin="60,2,0,0" Spacing="6"
					IsVisible="{Binding PreviewVM.BackgroundTaskActive}"
					WindowDecorationProperties.ElementRole="User">
			<ProgressBar Width="200" VerticalAlignment="Center" Minimum="0" Maximum="100"
						 Value="{Binding PreviewVM.BackgroundTaskProgress}"
					 Height="4" MinHeight="4" CornerRadius="2"/>
			<TextBlock Text="{Binding PreviewVM.BackgroundTaskMessage}" Height="35"
					   VerticalAlignment="Center" IsHitTestVisible="False"
					   FontStyle="Italic" FontSize="13" Opacity="0.5" Padding="4,8"/>
			<Button Width="20" Height="20" Padding="0" VerticalAlignment="Center"
					Background="Transparent" BorderThickness="0" ToolTip.Tip="Cancel"
					Click="OnCancelBackgroundTask"
					IsVisible="{Binding PreviewVM.BackgroundTaskCancellable}">
				<ic:SymbolIcon Symbol="Dismiss" FontSize="12" Opacity="0.5"/>
			</Button>
		</StackPanel>

		<!-- ═══════════════════════════════════════════════ -->
		<!-- Row 1: Info bar & search                       -->
		<!-- ═══════════════════════════════════════════════ -->

		<!-- Project / file info -->
		<StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Vertical">
			<StackPanel Margin="8,-2,0,0" Orientation="Horizontal" Spacing="6">
				<ic:SymbolIcon Symbol="Folder" IconVariant="Filled" Width="20" FontSize="13" Foreground="{DynamicResource SystemAccentColor}"/>
				<TextBlock FontStyle="Italic" FontSize="14" Opacity="0.7">
					<TextBlock.Text>
						<MultiBinding StringFormat="{}{0}  |  Filtered: {1}  |  Selected: {2}">
							<Binding Path="CurrentProject.Namn"/>
							<Binding Path="NrFilteredFiles"/>
							<Binding Path="NrSelectedFiles"/>
						</MultiBinding>
					</TextBlock.Text>
				</TextBlock>
			</StackPanel>
			<StackPanel Margin="8,0,0,0" Orientation="Horizontal" Spacing="6">
				<ic:SymbolIcon Symbol="Document" IconVariant="Filled" Width="20" FontSize="13" Foreground="{DynamicResource SystemAccentColor}"/>
				<TextBlock Text="{Binding CurrentFile.Namn}" FontStyle="Italic" FontSize="14" Opacity="0.7"/>
				<TextBlock Text="{Binding CurrentFile.CurrentVersion}" Foreground="{DynamicResource SystemAccentColor}" FontStyle="Italic" FontSize="14" Opacity="0.7"/>
			</StackPanel>
		</StackPanel>

		<!-- Right-aligned row 1: Columns flyout + tray toggles -->
		<StackPanel Grid.Row="1" Grid.ColumnSpan="5" Orientation="Horizontal" FlowDirection="RightToLeft">
           <Border Classes="shadow" Height="30">
				<Button Name="Columns" Classes="dropdown-surface" Height="30" MinHeight="30" Width="140" Click="Border_PointerPressed">
					<Grid ColumnDefinitions="25,*,20" Height="30">
						<ic:SymbolIcon Grid.Column="0" Symbol="CaretDown" IconVariant="Regular" FontSize="18"/>
						<Label Grid.Column="1" Content="Columns" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center"/>
						<ic:SymbolIcon Grid.Column="2" Symbol="DocumentHeaderArrowDown" IconVariant="Regular" FontSize="18"/>
					</Grid>
					<Button.Flyout>
						<Flyout FlyoutPresenterClasses="wide-flyout" HorizontalOffset="0" VerticalOffset="2" Placement="Bottom" ShowMode="Transient">
							<StackPanel Orientation="Vertical" FlowDirection="LeftToRight" Width="150" Margin="4,6,4,10" Spacing="2">
								<CheckBox Content="Name"          Height="28" IsChecked="{Binding CurrentProject.Meta_1, Mode=TwoWay}" IsVisible="False"/>
								<CheckBox Content="Filtyp"        Height="28" IsChecked="{Binding CurrentProject.Meta_3, Mode=TwoWay}"/>
								<CheckBox Content="Uppdrag"       Height="28" IsChecked="{Binding CurrentProject.Meta_4, Mode=TwoWay}"/>
								<CheckBox Content="Active version" Height="28" IsChecked="{Binding CurrentProject.Meta_17, Mode=TwoWay}"/>
								<CheckBox Content="Tagg"          Height="28" IsChecked="{Binding CurrentProject.Meta_5, Mode=TwoWay}"/>
								<CheckBox Content="Färg"          Height="28" IsChecked="{Binding CurrentProject.Meta_6, Mode=TwoWay}"/>
								<CheckBox Content="Handling"      Height="28" IsChecked="{Binding CurrentProject.Meta_7, Mode=TwoWay}"/>
								<CheckBox Content="Status"        Height="28" IsChecked="{Binding CurrentProject.Meta_8, Mode=TwoWay}"/>
								<CheckBox Content="Datum"         Height="28" IsChecked="{Binding CurrentProject.Meta_9, Mode=TwoWay}"/>
								<CheckBox Content="Ritningstyp"   Height="28" IsChecked="{Binding CurrentProject.Meta_10, Mode=TwoWay}"/>
								<CheckBox Content="Beskrivning 1" Height="28" IsChecked="{Binding CurrentProject.Meta_11, Mode=TwoWay}"/>
								<CheckBox Content="Beskrivning 2" Height="28" IsChecked="{Binding CurrentProject.Meta_12, Mode=TwoWay}"/>
								<CheckBox Content="Beskrivning 3" Height="28" IsChecked="{Binding CurrentProject.Meta_13, Mode=TwoWay}"/>
								<CheckBox Content="Beskrivning 4" Height="28" IsChecked="{Binding CurrentProject.Meta_14, Mode=TwoWay}"/>
								<CheckBox Content="Revidering"    Height="28" IsChecked="{Binding CurrentProject.Meta_15, Mode=TwoWay}"/>
								<CheckBox Content="Sökväg"        Height="28" IsChecked="{Binding CurrentProject.Meta_16, Mode=TwoWay}"/>
								<Separator Height="1" Margin="0,4"/>
								<Button Content="Set Default" HorizontalAlignment="Center" Width="120"
										Classes="DialogAction" Command="{Binding CurrentProject.SetDefaultMeta}"/>
							</StackPanel>
						</Flyout>
					</Button.Flyout>
				</Button>
			</Border>

                 <Border Classes="shadow" Height="30" IsVisible="{Binding UI.TrayViewOpen}">
						<Button Classes="dropdown-surface" Height="30" MinHeight="30" Width="140">
							<Grid ColumnDefinitions="25,*,20" Height="30">
								<ic:SymbolIcon Grid.Column="0" Symbol="CaretDown" IconVariant="Regular" FontSize="18"/>
								<Label Grid.Column="1" Content="Tray Panels" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center"/>
								<ic:SymbolIcon Grid.Column="2" Symbol="PanelRight" IconVariant="Regular" FontSize="18"/>
							</Grid>
							<Button.Flyout>
								<Flyout HorizontalOffset="0" VerticalOffset="2" Placement="Bottom" ShowMode="Transient">
									<StackPanel Orientation="Vertical" FlowDirection="LeftToRight" Width="120" Margin="0" Spacing="2">
										<CheckBox Classes="TrayToggle" Content="Notepad"      Height="28" IsChecked="{Binding UI.TrayNote, Mode=TwoWay}" ToolTip.Tip="Quick notes for the current project"/>
										<CheckBox Classes="TrayToggle" Content="Collections"  Height="28" IsChecked="{Binding UI.TrayCollections, Mode=TwoWay}" ToolTip.Tip="Saved file collections and favorites"/>
										<CheckBox Classes="TrayToggle" Content="Bookmarks"    Height="28" IsChecked="{Binding UI.TrayBookmarks, Mode=TwoWay}" ToolTip.Tip="Page bookmarks in the current PDF" IsVisible="{Binding UI.SuperuserMode}"/>
											<CheckBox Classes="TrayToggle" Content="Recent Files" Height="28" IsChecked="{Binding UI.TrayRecent, Mode=TwoWay}" ToolTip.Tip="Recently viewed files"/>
											<CheckBox Classes="TrayToggle" Content="Other Files"  Height="28" IsChecked="{Binding UI.TrayOtherFiles, Mode=TwoWay}" ToolTip.Tip="Other files attached to this project" IsVisible="{Binding UI.SuperuserMode}"/>
											<CheckBox Classes="TrayToggle" Content="Versions"     Height="28" IsChecked="{Binding UI.TrayVersions, Mode=TwoWay}" ToolTip.Tip="File version history"/>
												<CheckBox Classes="TrayToggle" Content="Annotations"  Height="28" IsChecked="{Binding UI.TrayAnnotations, Mode=TwoWay}" ToolTip.Tip="Annotation layers for the current file" IsVisible="{Binding UI.SuperuserMode}"/>
															<CheckBox Classes="TrayToggle" Content="To-Do"        Height="28" IsChecked="{Binding UI.TrayTodo, Mode=TwoWay}" ToolTip.Tip="Task list for the current project"/>
									</StackPanel>
								</Flyout>
							</Button.Flyout>
						</Button>
					</Border>
		</StackPanel>

		<!-- Center search bar with optional action bar -->
		<StackPanel Grid.Row="1" Grid.ColumnSpan="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="30,0,0,0" Spacing="4">

			<!-- Action bar (toggled via UI.ShowActionBar) -->
			<Border IsVisible="{Binding UI.ShowActionBar}" IsEnabled="{Binding FileSelected}"
					Classes="shadow"
					Background="{DynamicResource AppPanelSurfaceBrush}"
					BorderBrush="{DynamicResource AppControlBorderBrush}"
					BorderThickness="{DynamicResource AppBorderThickness}"
					CornerRadius="{DynamicResource AppCornerRadius}"
					Padding="2,0" VerticalAlignment="Center">
				<StackPanel Orientation="Horizontal" Spacing="0">
					<Button Classes="ghost" ToolTip.Tip="Open PDF"    Height="28" Width="28" Padding="0" Command="{Binding OpenFile}" IsVisible="{Binding SelectedFileIsNotSketch}">
						<ic:SymbolIcon Symbol="DocumentPdf" IconVariant="Regular" FontSize="15"/>
					</Button>
					<Button Classes="ghost" ToolTip.Tip="Open Folder" Height="28" Width="28" Padding="0" Command="{Binding OpenPath}" IsVisible="{Binding SelectedFileIsNotSketch}">
						<ic:SymbolIcon Symbol="FolderOpen" IconVariant="Regular" FontSize="15"/>
					</Button>
					<Button Classes="ghost" ToolTip.Tip="Copy Name"   Height="28" Width="28" Padding="0" Command="{Binding CopyFilenameToClipboard}" CommandParameter="{Binding $parent[Window]}" IsVisible="{Binding SelectedFileIsNotSketch}">
						<ic:SymbolIcon Symbol="ClipboardText" IconVariant="Regular" FontSize="15"/>
					</Button>

					<Border Width="1" Background="{DynamicResource AppToolbarSeparatorBrush}" Margin="2,6" Opacity="0.55"/>

					<Button Name="ColorTagButton" Classes="ghost" ToolTip.Tip="Color Tag" Height="28" Width="28" Padding="0">
						<ic:SymbolIcon Symbol="Color" IconVariant="Regular" FontSize="15"/>
						<Button.Flyout>
							<Flyout Placement="Bottom" ShowMode="TransientWithDismissOnPointerMoveAway"
									FlyoutPresenterTheme="{StaticResource OverlayFlyout}">
								<Border Classes="shadow" MinHeight="0" Padding="6,4">
									<Border.Background>
										<SolidColorBrush Color="{DynamicResource SystemRegionColor}"/>
									</Border.Background>
									<StackPanel Orientation="Vertical" Spacing="2">
										<Button Width="22" Height="22" Background="{StaticResource TagColorYellow}" Opacity="0.85" Tag="Yellow"  Click="EditColor" ToolTip.Tip="Yellow"  Padding="0" MinWidth="0" MinHeight="0" CornerRadius="11"/>
										<Button Width="22" Height="22" Background="{StaticResource TagColorOrange}" Opacity="0.85" Tag="Orange"  Click="EditColor" ToolTip.Tip="Orange"  Padding="0" MinWidth="0" MinHeight="0" CornerRadius="11"/>
										<Button Width="22" Height="22" Background="{StaticResource TagColorBrown}"  Opacity="0.85" Tag="Brown"   Click="EditColor" ToolTip.Tip="Brown"   Padding="0" MinWidth="0" MinHeight="0" CornerRadius="11"/>
										<Button Width="22" Height="22" Background="{StaticResource TagColorGreen}"  Opacity="0.85" Tag="Green"   Click="EditColor" ToolTip.Tip="Green"   Padding="0" MinWidth="0" MinHeight="0" CornerRadius="11"/>
										<Button Width="22" Height="22" Background="{StaticResource TagColorBlue}"   Opacity="0.85" Tag="Blue"    Click="EditColor" ToolTip.Tip="Blue"    Padding="0" MinWidth="0" MinHeight="0" CornerRadius="11"/>
										<Button Width="22" Height="22" Background="{StaticResource TagColorRed}"    Opacity="0.85" Tag="Red"     Click="EditColor" ToolTip.Tip="Red"     Padding="0" MinWidth="0" MinHeight="0" CornerRadius="11"/>
										<Button Width="22" Height="22" Background="{StaticResource TagColorMagenta}" Opacity="0.85" Tag="Magenta" Click="EditColor" ToolTip.Tip="Magenta" Padding="0" MinWidth="0" MinHeight="0" CornerRadius="11"/>
										<Button Width="22" Height="22" Tag="" Click="EditColor" ToolTip.Tip="Clear" Padding="0" MinWidth="0" MinHeight="0" CornerRadius="11"
												BorderThickness="1" BorderBrush="{DynamicResource AppControlBorderBrush}">
											<ic:SymbolIcon Symbol="Dismiss" FontSize="12"/>
										</Button>
									</StackPanel>
								</Border>
							</Flyout>
						</Button.Flyout>
					</Button>

					<Button Name="CollectionButton" Classes="ghost" ToolTip.Tip="Collection" Height="28" Width="28" Padding="0">
						<ic:SymbolIcon Symbol="Collections" IconVariant="Regular" FontSize="15"/>
						<Button.Flyout>
							<Flyout Placement="Bottom" ShowMode="Transient" FlyoutPresenterClasses="compact">
								<ItemsControl ItemsSource="{Binding Storage.Collections}" Margin="4">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Button Content="{ReflectionBinding}" Click="OnAddToCollection" HorizontalAlignment="Stretch"
													Height="26" MinHeight="0" FontSize="13" Padding="8,2"
													HorizontalContentAlignment="Left"/>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</Flyout>
						</Button.Flyout>
					</Button>

					<Button Name="GroupButton" Classes="ghost" ToolTip.Tip="New Group — select multiple files first to group them together" Height="28" Width="28" Padding="0" Click="OnNewGroup">
						<ic:SymbolIcon Symbol="GroupList" IconVariant="Regular" FontSize="15"/>
					</Button>
				</StackPanel>
			</Border>

			<!-- Search bar -->
			<Grid ColumnDefinitions="*,30,4,30">
				<Border Classes="shadow">
					<TextBox Grid.Column="0" PlaceholderText="Search All Files" Text="{Binding SearchText}" Name="SearchText" Width="180" KeyDown="OnStartSearch">
						<TextBox.InnerRightContent>
							<Button Click="OnClearSearch" Height="20" Width="20" Padding="0" Margin="0,0,4,0"
									ToolTip.Tip="Clear Search" IsVisible="{Binding IsSearchResult}"
									Background="Transparent" BorderThickness="0">
								<ic:SymbolIcon Symbol="Dismiss" IconVariant="Regular" FontSize="12"/>
							</Button>
						</TextBox.InnerRightContent>
					</TextBox>
				</Border>
				<Button Grid.Column="1" Click="OnSearch" Height="30" Width="30" ToolTip.Tip="Search">
					<ic:SymbolIcon Symbol="Search" IconVariant="Regular" FontSize="16" Padding="0"/>
				</Button>
				<ToggleButton Grid.Column="3" ToolTip.Tip="Stored Content Search" Height="30" Width="30" IsChecked="{Binding IndexedSearch}" IsVisible="{Binding UI.SuperuserMode}">
					<ic:SymbolIcon Symbol="Text" IconVariant="Regular" FontSize="16" Padding="0"/>
				</ToggleButton>
			</Grid>
		</StackPanel>

		<StackPanel Orientation="Horizontal" Spacing="2" Height="35" HorizontalAlignment="Right"
					Grid.Row="0" Grid.ColumnSpan="5" Margin="0,0,155,0"
					WindowDecorationProperties.ElementRole="User">

			<!-- Layout group -->
			<ToggleButton ToolTip.Tip="Tree View (Ctrl+Q)"       HotKey="Ctrl+Q" Height="30" Width="35" Padding="0" Click="SetupTreeview"     IsChecked="{Binding UI.TreeViewOpen}">       <ic:SymbolIcon Symbol="PanelLeft"    IconVariant="Regular" FontSize="18"/></ToggleButton>
			<ToggleButton ToolTip.Tip="Tray (Ctrl+E)"            HotKey="Ctrl+E" Height="30" Width="35" Padding="0"                           IsChecked="{Binding UI.TrayViewOpen}">       <ic:SymbolIcon Symbol="PanelRight"   IconVariant="Regular" FontSize="18"/></ToggleButton>
			<ToggleButton ToolTip.Tip="Folders (Ctrl+L)"         HotKey="Ctrl+L" Height="30" Width="35" Padding="0"                           IsChecked="{Binding UI.ShowFolders}">        <ic:SymbolIcon Symbol="Folder"       IconVariant="Regular" FontSize="18"/></ToggleButton>

			<Border Width="1" Background="{DynamicResource AppToolbarSeparatorBrush}" Margin="4,6" Opacity="0.55"/>

			<!-- View group -->
			<ToggleButton ToolTip.Tip="Preview Window (Ctrl+W)"  HotKey="Ctrl+W" Height="30" Width="35" Padding="0"                           IsChecked="{Binding PreviewWindowOpen}">  <ic:SymbolIcon Symbol="Window"                            FontSize="18"/></ToggleButton>
			<ToggleButton ToolTip.Tip="Embedded Preview (Ctrl+P)" HotKey="Ctrl+P" Height="30" Width="35" Padding="0"                           IsChecked="{Binding UI.PreviewEmbeddedOpen}"><ic:SymbolIcon Symbol="Eye"          IconVariant="Regular" FontSize="18"/></ToggleButton>

			<Border Width="1" Background="{DynamicResource AppToolbarSeparatorBrush}" Margin="4,6" Opacity="0.55"/>

			<!-- Settings & tools group -->
			<Button       ToolTip.Tip="UI Settings"                              Height="30" Width="35" Padding="0" Command="{Binding OpenColorDia}"     CommandParameter="{Binding $parent[Window]}"><ic:SymbolIcon Symbol="Settings" FontSize="18"/></Button>

			<!-- Hidden hotkey-only toggles (moved to UI Settings dialog) -->
			<ToggleButton HotKey="Ctrl+B" IsChecked="{Binding UI.ShowActionBar}" IsVisible="False" Width="0" Height="0" IsEnabled="{Binding UI.SuperuserMode}"/>
			<ToggleButton HotKey="Ctrl+I" IsChecked="{Binding UI.ShowIcons}"     IsVisible="False" Width="0" Height="0" IsEnabled="{Binding UI.SuperuserMode}"/>
			<ToggleButton HotKey="Ctrl+M" IsChecked="{Binding !UI.DarkMode}"     IsVisible="False" Width="0" Height="0"/>
			<ToggleButton HotKey="Ctrl+T" IsChecked="{Binding UI.ShowThumbnails}" IsVisible="False" Width="0" Height="0" IsEnabled="{Binding UI.SuperuserMode}"/>

			<!-- Toolbox: grouped tools (compact icon-only flyout) -->
			<Button Name="ToolboxButton" ToolTip.Tip="Toolbox" Height="30" MinHeight="0" Width="35" Padding="0" IsVisible="{Binding UI.SuperuserMode}">
				<ic:SymbolIcon Symbol="Toolbox" FontSize="18"/>
				<Button.Flyout>
					<Flyout Placement="Bottom" ShowMode="Transient" HorizontalOffset="0" VerticalOffset="2" FlyoutPresenterClasses="compact">
						<!-- compact vertical flyout with same-size buttons as toolbar -->
						<StackPanel Orientation="Vertical" Width="38" Margin="1" Spacing="1">
							<Button ToolTip.Tip="Whiteboard" Width="35" Height="30" Classes="rounded-default" Click="OnOpenWhiteboard" Padding="0">
								<ic:SymbolIcon Symbol="Pen" FontSize="18"/>
							</Button>
							<Button ToolTip.Tip="Reinforcement" Width="35" Height="30" Classes="rounded-default" Command="{Binding OpenReinforcementCalculator}" CommandParameter="{Binding $parent[Window]}" Padding="0">
								<ic:SymbolIcon Symbol="Calculator" FontSize="18"/>
							</Button>
							<!-- Keyboard shortcuts help -->
							<Button ToolTip.Tip="Keyboard Shortcuts" Height="30" MinHeight="0" Width="35" Padding="0">
								<ic:SymbolIcon Symbol="Keyboard" IconVariant="Regular" FontSize="18"/>
								<Button.Flyout>
									<Flyout Placement="Bottom" ShowMode="Transient" HorizontalOffset="0" VerticalOffset="2">
										<StackPanel Orientation="Vertical" Width="220" Margin="6" Spacing="4">
											<TextBlock Text="Keyboard Shortcuts" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
											<Separator Height="1"/>
											<Grid ColumnDefinitions="80,*"><TextBlock Grid.Column="0" Text="Ctrl+S" FontWeight="SemiBold" FontSize="13"/><TextBlock Grid.Column="1" Text="Save" FontSize="13"/></Grid>
											<Grid ColumnDefinitions="80,*"><TextBlock Grid.Column="0" Text="Ctrl+Q" FontWeight="SemiBold" FontSize="13"/><TextBlock Grid.Column="1" Text="Tree View" FontSize="13"/></Grid>
											<Grid ColumnDefinitions="80,*"><TextBlock Grid.Column="0" Text="Ctrl+E" FontWeight="SemiBold" FontSize="13"/><TextBlock Grid.Column="1" Text="Tray" FontSize="13"/></Grid>
											<Grid ColumnDefinitions="80,*"><TextBlock Grid.Column="0" Text="Ctrl+L" FontWeight="SemiBold" FontSize="13"/><TextBlock Grid.Column="1" Text="Folders" FontSize="13"/></Grid>
											<Grid ColumnDefinitions="80,*"><TextBlock Grid.Column="0" Text="Ctrl+T" FontWeight="SemiBold" FontSize="13"/><TextBlock Grid.Column="1" Text="Thumbnails" FontSize="13"/></Grid>
												<Grid ColumnDefinitions="80,*"><TextBlock Grid.Column="0" Text="Ctrl+W" FontWeight="SemiBold" FontSize="13"/><TextBlock Grid.Column="1" Text="Preview Window" FontSize="13"/></Grid>
												<Grid ColumnDefinitions="80,*"><TextBlock Grid.Column="0" Text="Ctrl+P" FontWeight="SemiBold" FontSize="13"/><TextBlock Grid.Column="1" Text="Embedded Preview" FontSize="13"/></Grid>
												<Grid ColumnDefinitions="80,*"><TextBlock Grid.Column="0" Text="Ctrl+I" FontWeight="SemiBold" FontSize="13"/><TextBlock Grid.Column="1" Text="Icons" FontSize="13"/></Grid>
												<Grid ColumnDefinitions="80,*"><TextBlock Grid.Column="0" Text="Ctrl+B" FontWeight="SemiBold" FontSize="13"/><TextBlock Grid.Column="1" Text="Action Bar" FontSize="13"/></Grid>
												<Grid ColumnDefinitions="80,*"><TextBlock Grid.Column="0" Text="Ctrl+M" FontWeight="SemiBold" FontSize="13"/><TextBlock Grid.Column="1" Text="Dark / Light Mode" FontSize="13"/></Grid>
												<Grid ColumnDefinitions="80,*" IsVisible="{Binding UI.SuperuserMode}"><TextBlock Grid.Column="0" Text="Ctrl+K" FontWeight="SemiBold" FontSize="13"/><TextBlock Grid.Column="1" Text="Calendar" FontSize="13"/></Grid>
											<Grid ColumnDefinitions="80,*"><TextBlock Grid.Column="0" Text="Enter" FontWeight="SemiBold" FontSize="13"/><TextBlock Grid.Column="1" Text="Search (in search box)" FontSize="13"/></Grid>
										</StackPanel>
									</Flyout>
								</Button.Flyout>
							</Button>
							<Button ToolTip.Tip="Info" Width="35" Height="30" Classes="rounded-default" Command="{Binding OpenInfoDia}" CommandParameter="{Binding $parent[Window]}" Padding="0">
								<ic:SymbolIcon Symbol="Info" FontSize="18"/>
							</Button>
						</StackPanel>
					</Flyout>
				</Button.Flyout>
			</Button>

			<Border Width="1" Background="{DynamicResource AppToolbarSeparatorBrush}" Margin="4,6" Opacity="0.55"/>

			<ToggleButton ToolTip.Tip="Calendar (Ctrl+K)" IsVisible="False" Height="30" Width="35" Padding="0" IsChecked="{Binding UI.CalendarOpen}" IsEnabled="{Binding UI.SuperuserMode}"><ic:SymbolIcon Symbol="Calendar" IconVariant="Regular" FontSize="18"/></ToggleButton>

			<!-- Sync status indicator (visible only when folder watching is enabled and superuser mode) -->
           <Button Name="SyncStatusButton" Classes="ghost" Height="30" Width="35" Padding="0" ToolTip.Tip="{Binding SyncStatusText}">
				<Button.IsVisible>
					<MultiBinding Converter="{x:Static BoolConverters.And}">
						<Binding Path="UI.SuperuserMode"/>
						<Binding Path="UI.FolderWatchEnabled"/>
					</MultiBinding>
				</Button.IsVisible>
				<Panel>
					<ic:SymbolIcon Symbol="CheckmarkCircle" FontSize="18"
								  Foreground="{StaticResource TagColorGreen}"
								  IsVisible="{Binding !HasPendingSyncFolders}"/>
					<ic:SymbolIcon Symbol="ArrowSync" FontSize="18"
								  Foreground="{DynamicResource SystemAccentColor}"
								  IsVisible="{Binding HasPendingSyncFolders}"/>
				</Panel>
				<Button.Flyout>
					<Flyout Placement="Bottom" ShowMode="Transient" HorizontalOffset="0" VerticalOffset="2">
						<StackPanel Width="260" Margin="6" Spacing="6">
							<!-- Up-to-date state -->
							<StackPanel Orientation="Vertical" Spacing="6" IsVisible="{Binding !HasPendingSyncFolders}"
										HorizontalAlignment="Center" Margin="8,12">
								<ic:SymbolIcon Symbol="CheckmarkCircle" FontSize="28" HorizontalAlignment="Center"
											   Foreground="{StaticResource TagColorGreen}"/>
								<TextBlock Text="All folders up to date" FontSize="13" FontWeight="SemiBold"
										   HorizontalAlignment="Center" Opacity="0.8"/>
							</StackPanel>
							<!-- Pending changes header -->
							<StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasPendingSyncFolders}">
								<Ellipse Width="8" Height="8" Fill="{DynamicResource SystemAccentColor}" VerticalAlignment="Center"/>
								<TextBlock Text="{Binding SyncStatusText}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
							</StackPanel>
								<!-- Folder list -->
								<ItemsControl ItemsSource="{Binding PendingSyncFolders}" IsVisible="{Binding HasPendingSyncFolders}">
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="model:SyncStatusEntry">
											<Border Background="{DynamicResource AppPanelSurfaceBrush}"
													CornerRadius="5" Padding="10,7" Margin="0,1">
												<Grid ColumnDefinitions="Auto,*,Auto">
													<ic:SymbolIcon Grid.Column="0" Symbol="Folder" FontSize="16"
																   VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0.6"/>
													<StackPanel Grid.Column="1" Orientation="Vertical" Spacing="1" VerticalAlignment="Center">
																		<TextBlock Text="{Binding FolderName}" FontSize="12.5"
																				   TextTrimming="CharacterEllipsis"/>
																		<StackPanel Orientation="Horizontal" Spacing="4">
																			<TextBlock Text="{Binding ProjectName}" FontSize="11"
																					   Opacity="0.5" TextTrimming="CharacterEllipsis"/>
																			<TextBlock Text="·" FontSize="11" Opacity="0.35"
																					   IsVisible="{Binding FolderType, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
																			<TextBlock Text="{Binding FolderType}" FontSize="11"
																					   Opacity="0.35" FontStyle="Italic" TextTrimming="CharacterEllipsis"/>
																		</StackPanel>
																		<TextBlock Text="{Binding ChangesSummary}" FontSize="10.5"
																				   Foreground="{DynamicResource SystemAccentColor}" Opacity="0.85"
																				   IsVisible="{Binding ChangesSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
																				   TextTrimming="CharacterEllipsis"/>
																	</StackPanel>
													<Button Grid.Column="2" Content="Sync" Click="OnSyncSingleFolder"
															Tag="{Binding}" VerticalAlignment="Center"
															IsEnabled="{Binding ((vm:MainViewModel)DataContext).IsSyncing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static BoolConverters.Not}}"
															FontSize="11" FontWeight="SemiBold"
															Padding="8,3" CornerRadius="4" Margin="6,0,0,0"/>
												</Grid>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
								<!-- Check All button -->
								<Button Content="Check all folders" Click="OnCheckAllFolders"
										IsEnabled="{Binding !IsSyncing}"
										HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
										FontSize="11.5" Padding="6,4" CornerRadius="4" Margin="0,2,0,0"/>
							</StackPanel>
					</Flyout>
				</Button.Flyout>
			</Button>
		</StackPanel>

		<!-- ═══════════════════════════════════════════════ -->
		<!-- Row 2: Main content area                       -->
		<!-- ═══════════════════════════════════════════════ -->

		<!-- File DataGrid + attached files + folders -->
		<Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" RowDefinitions="*,Auto,Auto" MinWidth="300">

			<!-- Main file list with empty state and drop hint overlays -->
			<Border Classes="shadow">
			<Panel>
				<DataGrid Name="FileGrid" Padding="0" Classes="ThumbnailGrid"
					  ItemsSource="{Binding FilteredFiles, Mode=OneWay}" SelectionMode="Extended"
					  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible"
					  AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="None"
					  LoadingRow="DataGrid_OnLoadingRow" CanUserReorderColumns="True" CanUserResizeColumns="True"
					  CanUserSortColumns="False"
					  ToolTip.ServiceEnabled="{Binding UI.ShowThumbnails}">

                <DataGrid.Columns>
                    <!-- Icons-only column: render Fluent SymbolIcons for each symbol name in IconSymbols -->
                    <!-- Let the column size itself to the cells so it grows/shrinks with the visible icons -->
                    <DataGridTemplateColumn Width="SizeToCells" CanUserResize="False" CanUserReorder="False" MinWidth="24" MaxWidth="120" IsVisible="{Binding UI.ShowIcons}">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
                                <!-- No outer margin so measured width matches content; small spacing between icons -->
								<StackPanel Orientation="Horizontal" Margin="5" Spacing="3" HorizontalAlignment="Center">
									<ic:SymbolIcon Symbol="Star"		IsVisible="{Binding Favorite}"				IconVariant="Regular" FontSize="14"/>
									<ic:SymbolIcon Symbol="GroupList"	IsVisible="{Binding IsGroup}"				IconVariant="Regular" FontSize="14"/>
									<ic:SymbolIcon Symbol="Attach"		IsVisible="{Binding HasAppendedFiles}"		IconVariant="Regular" FontSize="14"/>
									<ic:SymbolIcon Symbol="Bookmark"	IsVisible="{Binding HasBookmarks}"			IconVariant="Regular" FontSize="14"/>
									<ic:SymbolIcon Symbol="Notebook"	IsVisible="{Binding HasNote}"				IconVariant="Regular" FontSize="14"/>
									<ic:SymbolIcon Symbol="Image"		IsVisible="{Binding HasThumbnail}"			IconVariant="Regular" FontSize="14"/>
									<ic:SymbolIcon Symbol="Collections"	IsVisible="{Binding IsPartOfCollection}"	IconVariant="Regular" FontSize="14"/>
									<ic:SymbolIcon Symbol="History"		IsVisible="{Binding HasVersions}"			IconVariant="Regular" FontSize="14"/>
									<ic:SymbolIcon Symbol="Pen"			IsVisible="{Binding HasAnnotations}"		IconVariant="Regular" FontSize="14"/>
									<ic:SymbolIcon Symbol="ArrowSync"	IsVisible="{Binding IsCached}"				IconVariant="Regular" FontSize="14"/>
								</StackPanel>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<!-- Color dot column: shows a small colored circle when ColorTagDot mode is active -->
						<DataGridTemplateColumn Width="Auto" CanUserResize="False" CanUserReorder="False" CanUserSort="False" MinWidth="28" MaxWidth="38" IsVisible="{Binding UI.ColorTagDot}">
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate x:DataType="model:FileData">
											<Ellipse Width="10" Height="10" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center"
											 Fill="{Binding Färg, Converter={x:Static converter:ColorNameToBrushConverter.Instance}}"/>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>

					<!-- Name column shown when icons are enabled (name no longer contains icons) -->

						<!-- Name column with expand/collapse chevron for parent files and indent for appended -->
						<DataGridTemplateColumn Header="Namn" Width="Auto" MinWidth="120">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate x:DataType="model:FileData">
                               <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" VerticalAlignment="Stretch">
                                  <Panel Grid.Column="0" Width="18" Margin="0,0,2,0" VerticalAlignment="Stretch"
										   IsVisible="{Binding HasHierarchyMarker}">
									  <Border Width="2" HorizontalAlignment="Center" VerticalAlignment="Stretch"
												Margin="{Binding IsLastChild, Converter={x:Static converter:AppendedFileStyleConverter.SpineMargin}}"
												IsVisible="{Binding IsAppendedFile}"
												Background="{DynamicResource AppDividerBrush}"
												Opacity="0.5"/>
										<Button Width="18" Height="18" Padding="0" MinWidth="0" MinHeight="0"
												Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                IsVisible="{Binding HasChildren}" Click="OnToggleGroupExpanded" DoubleTapped="OnToggleGroupExpandedDoubleTapped">
											<ic:SymbolIcon Symbol="ChevronRight" FontSize="11" Opacity="0.5"
													   RenderTransform="{Binding IsExpanded, Converter={x:Static converter:AppendedFileStyleConverter.Chevron}}"/>
										</Button>
									</Panel>
                                    <Panel Grid.Column="1" Width="{Binding IsAppendedFile, Converter={x:Static converter:AppendedFileStyleConverter.Indent}}"
										   IsVisible="{Binding IsAppendedFile}"/>
									<TextBlock Grid.Column="2" VerticalAlignment="Center"
												   FontSize="{Binding $parent[DataGrid].DataContext.UI.FontSize}"
												   FontWeight="{Binding IsGroup, Converter={x:Static converter:AppendedFileStyleConverter.FontWeight}}"
												   FontStyle="{Binding IsStyledAsAttached, Converter={x:Static converter:AppendedFileStyleConverter.FontStyle}}"
												 Opacity="{Binding IsChild, Converter={x:Static converter:AppendedFileStyleConverter.Opacity}}">
										<TextBlock.Inlines>
											<MultiBinding Converter="{x:Static converter:SearchHighlightConverter.Instance}">
												<Binding Path="Namn"/>
												<Binding Path="SearchTerm"/>
												<Binding Path="IsSearchMatch"/>
											</MultiBinding>
										</TextBlock.Inlines>
									</TextBlock>
								   <TextBlock Grid.Column="3" Text="{Binding ChildFileCountDisplay}" VerticalAlignment="Center" Margin="5,0,0,0"
									   FontSize="{Binding $parent[DataGrid].DataContext.UI.FontSize}"
									   Opacity="0.45"/>
								</Grid>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
					<DataGridTextColumn Binding="{Binding Filtyp}"            Header="Filtyp"        Width="Auto" MinWidth="120" IsVisible="{Binding CurrentProject.Meta_3}"     FontSize="{Binding UI.FontSize}"/>
					<DataGridTextColumn Binding="{Binding Uppdrag}"           Header="Uppdrag"       Width="Auto" MinWidth="120" IsVisible="{Binding CurrentProject.Meta_4}"     FontSize="{Binding UI.FontSize}"/>
					<DataGridTextColumn Binding="{Binding CurrentVersion}"     Header="Active version"  Width="Auto" MinWidth="80"  IsVisible="{Binding CurrentProject.Meta_17}"    FontSize="{Binding UI.FontSize}"/>
					<DataGridTextColumn Binding="{Binding Tagg}"              Header="Tagg"          Width="Auto" MinWidth="120" IsVisible="{Binding CurrentProject.Meta_5}"     FontSize="{Binding UI.FontSize}"/>
					<DataGridTextColumn Binding="{Binding Färg}"              Header="Färg"          Width="Auto" MinWidth="120" IsVisible="{Binding CurrentProject.Meta_6}"     FontSize="{Binding UI.FontSize}"/>
					<DataGridTextColumn Binding="{Binding Handling}"          Header="Handling"      Width="Auto" MinWidth="120" IsVisible="{Binding CurrentProject.Meta_7}"     FontSize="{Binding UI.FontSize}"/>
					<DataGridTextColumn Binding="{Binding Status}"            Header="Status"        Width="Auto" MinWidth="120" IsVisible="{Binding CurrentProject.Meta_8}"     FontSize="{Binding UI.FontSize}"/>
					<DataGridTextColumn Binding="{Binding Datum}"             Header="Datum"         Width="Auto" MinWidth="120" IsVisible="{Binding CurrentProject.Meta_9}"     FontSize="{Binding UI.FontSize}"/>
					<DataGridTextColumn Binding="{Binding Ritningstyp}"       Header="Ritningstyp"   Width="Auto" MinWidth="120" IsVisible="{Binding CurrentProject.Meta_10}"    FontSize="{Binding UI.FontSize}"/>
					<DataGridTextColumn Binding="{Binding Beskrivning1}"      Header="Beskrivning 1" Width="Auto" MinWidth="120" IsVisible="{Binding CurrentProject.Meta_11}"    FontSize="{Binding UI.FontSize}"/>
					<DataGridTextColumn Binding="{Binding Beskrivning2}"      Header="Beskrivning 2" Width="Auto" MinWidth="120" IsVisible="{Binding CurrentProject.Meta_12}"    FontSize="{Binding UI.FontSize}"/>
					<DataGridTextColumn Binding="{Binding Beskrivning3}"      Header="Beskrivning 3" Width="Auto" MinWidth="120" IsVisible="{Binding CurrentProject.Meta_13}"    FontSize="{Binding UI.FontSize}"/>
					<DataGridTextColumn Binding="{Binding Beskrivning4}"      Header="Beskrivning 4" Width="Auto" MinWidth="120" IsVisible="{Binding CurrentProject.Meta_14}"    FontSize="{Binding UI.FontSize}"/>
					<DataGridTextColumn Binding="{Binding Revidering}"        Header="Revidering"    Width="Auto" MinWidth="120" IsVisible="{Binding CurrentProject.Meta_15}"    FontSize="{Binding UI.FontSize}"/>
					<DataGridTextColumn Binding="{Binding Sökväg}"            Header="Sökväg"        Width="Auto" MinWidth="120" IsVisible="{Binding CurrentProject.Meta_16}"    FontSize="{Binding UI.FontSize}"/>
				</DataGrid.Columns>

				<DataGrid.ContextMenu>
						<ContextMenu Name="Menu" Opening="OnFileGridContextMenuOpening">
						<MenuItem Header="Open" IsVisible="{Binding SelectedFileIsNotSketch}">
							<MenuItem.Icon><ic:SymbolIcon Symbol="Open"/></MenuItem.Icon>
							<MenuItem Header="Open PDF"      Command="{Binding OpenFile}">
								<MenuItem.Icon><ic:SymbolIcon Symbol="DocumentPdf"/></MenuItem.Icon>
							</MenuItem>
							<MenuItem Header="Open Folder"   Command="{Binding OpenPath}">
								<MenuItem.Icon><ic:SymbolIcon Symbol="FolderOpen"/></MenuItem.Icon>
							</MenuItem>
							<MenuItem Header="Open Metafile" Command="{Binding OpenMeta}">
								<MenuItem.Icon><ic:SymbolIcon Symbol="DocumentDataLink"/></MenuItem.Icon>
							</MenuItem>
							<MenuItem Header="Open Docx"     Command="{Binding OpenDoc}">
								<MenuItem.Icon><ic:SymbolIcon Symbol="DocumentEdit"/></MenuItem.Icon>
							</MenuItem>
							<MenuItem Header="Open Dwg"      Command="{Binding OpenDwg}">
								<MenuItem.Icon><ic:SymbolIcon Symbol="DocumentTableCube"/></MenuItem.Icon>
							</MenuItem>
						</MenuItem>

						<MenuItem Header="View">
							<MenuItem.IsVisible>
								<MultiBinding Converter="{x:Static BoolConverters.And}">
									<Binding Path="PreviewVM.DualFileMode"/>
									<Binding Path="UI.SuperuserMode"/>
								</MultiBinding>
							</MenuItem.IsVisible>
							<MenuItem.Icon><ic:SymbolIcon Symbol="Eye"/></MenuItem.Icon>
							<MenuItem Header="Left" Click="OnViewLeft">
								<MenuItem.Icon><ic:SymbolIcon Symbol="PanelLeft"/></MenuItem.Icon>
							</MenuItem>
							<MenuItem Header="Right" Click="OnViewRight">
								<MenuItem.Icon><ic:SymbolIcon Symbol="PanelRight"/></MenuItem.Icon>
							</MenuItem>
						</MenuItem>

						<MenuItem Header="Collection" ItemsSource="{Binding Storage.Collections}" Click="OnAddToCollection">
							<MenuItem.Icon><ic:SymbolIcon Symbol="Collections"/></MenuItem.Icon>
							<MenuItem.ItemTemplate>
								<DataTemplate><TextBlock Text="{ReflectionBinding StringFormat=' - {0}'}"/></DataTemplate>
							</MenuItem.ItemTemplate>
						</MenuItem>

						<MenuItem Header="Copy Name" Command="{Binding CopyFilenameToClipboard}" CommandParameter="{Binding $parent[Window]}" IsVisible="{Binding SelectedFileIsNotSketch}">
							<MenuItem.Icon><ic:SymbolIcon Symbol="ClipboardText"/></MenuItem.Icon>
						</MenuItem>
						<MenuItem Header="Copy Path" Command="{Binding CopyFilepathToClipboard}" CommandParameter="{Binding $parent[Window]}" IsVisible="{Binding SelectedFileIsNotSketch}">
							<MenuItem.Icon><ic:SymbolIcon Symbol="Copy"/></MenuItem.Icon>
						</MenuItem>

						<Separator/>

						<MenuItem Header="Favorite" Command="{Binding Collections.MarkFavorite}" IsVisible="{Binding FileSelected}">
							<MenuItem.Icon><ic:SymbolIcon Symbol="Star"/></MenuItem.Icon>
						</MenuItem>

						<MenuItem Header="Color" IsVisible="{Binding FileSelected}">
							<MenuItem.Icon><ic:SymbolIcon Symbol="Color"/></MenuItem.Icon>
							<MenuItem Header="None"    Tag=""        Click="EditColor">
								<MenuItem.Icon><ic:SymbolIcon Symbol="Dismiss" FontSize="14"/></MenuItem.Icon>
							</MenuItem>
							<MenuItem Header="Yellow"  Tag="Yellow"  Click="EditColor">
								<MenuItem.Icon><Ellipse Width="10" Height="10" Fill="{StaticResource TagColorYellow}"/></MenuItem.Icon>
							</MenuItem>
							<MenuItem Header="Orange"  Tag="Orange"  Click="EditColor">
								<MenuItem.Icon><Ellipse Width="10" Height="10" Fill="{StaticResource TagColorOrange}"/></MenuItem.Icon>
							</MenuItem>
							<MenuItem Header="Brown"   Tag="Brown"   Click="EditColor">
								<MenuItem.Icon><Ellipse Width="10" Height="10" Fill="{StaticResource TagColorBrown}"/></MenuItem.Icon>
							</MenuItem>
							<MenuItem Header="Green"   Tag="Green"   Click="EditColor">
								<MenuItem.Icon><Ellipse Width="10" Height="10" Fill="{StaticResource TagColorGreen}"/></MenuItem.Icon>
							</MenuItem>
							<MenuItem Header="Blue"    Tag="Blue"    Click="EditColor">
								<MenuItem.Icon><Ellipse Width="10" Height="10" Fill="{StaticResource TagColorBlue}"/></MenuItem.Icon>
							</MenuItem>
							<MenuItem Header="Red"     Tag="Red"     Click="EditColor">
								<MenuItem.Icon><Ellipse Width="10" Height="10" Fill="{StaticResource TagColorRed}"/></MenuItem.Icon>
							</MenuItem>
							<MenuItem Header="Magenta" Tag="Magenta" Click="EditColor">
								<MenuItem.Icon><Ellipse Width="10" Height="10" Fill="{StaticResource TagColorMagenta}"/></MenuItem.Icon>
							</MenuItem>
						</MenuItem>

						<MenuItem Header="Text Tag" Command="{Binding OpenTagDia}" CommandParameter="{Binding $parent[Window]}" IsVisible="{Binding FileSelected}">
							<MenuItem.Icon><ic:SymbolIcon Symbol="Tag"/></MenuItem.Icon>
						</MenuItem>
						<MenuItem Header="Clear Tags" Click="OnClearFiles" IsVisible="{Binding FileSelected}">
							<MenuItem.Icon><ic:SymbolIcon Symbol="TagDismiss"/></MenuItem.Icon>
						</MenuItem>

						<MenuItem Header="Version" IsVisible="{Binding AllSelectedFilesHaveVersions}">
							<MenuItem.Icon><ic:SymbolIcon Symbol="History"/></MenuItem.Icon>
							<MenuItem Header="Set to First" Command="{Binding SetFirstVersionCommand}">
								<MenuItem.Icon><ic:SymbolIcon Symbol="ArrowUpload"/></MenuItem.Icon>
							</MenuItem>
							<MenuItem Header="Set to Last" Command="{Binding SetLastVersionCommand}">
								<MenuItem.Icon><ic:SymbolIcon Symbol="ArrowDownload"/></MenuItem.Icon>
							</MenuItem>
							<Separator/>
							<MenuItem Header="Set Active Version" ItemsSource="{Binding CurrentFile.Versions}" Click="OnSetCurrentVersion">
								<MenuItem.Icon><ic:SymbolIcon Symbol="CheckmarkCircle"/></MenuItem.Icon>
								<MenuItem.ItemTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding Label}"/>
									</DataTemplate>
								</MenuItem.ItemTemplate>
							</MenuItem>
							<MenuItem Header="Reset to Original" Command="{Binding ResetToOriginalCommand}">
								<MenuItem.Icon><ic:SymbolIcon Symbol="ArrowUndo"/></MenuItem.Icon>
							</MenuItem>
							<Separator/>
							<MenuItem Header="Rename First" ItemsSource="{Binding VersionLabels}" Click="OnLabelFirstVersion">
								<MenuItem.Icon><ic:SymbolIcon Symbol="TextAdd"/></MenuItem.Icon>
								<MenuItem.ItemTemplate>
									<DataTemplate><TextBlock Text="{ReflectionBinding StringFormat=' - {0}'}"/></DataTemplate>
								</MenuItem.ItemTemplate>
							</MenuItem>
							<MenuItem Header="Rename Last" ItemsSource="{Binding VersionLabels}" Click="OnLabelLatestVersion">
								<MenuItem.Icon><ic:SymbolIcon Symbol="TextAdd"/></MenuItem.Icon>
										<MenuItem.ItemTemplate>
											<DataTemplate><TextBlock Text="{ReflectionBinding StringFormat=' - {0}'}"/></DataTemplate>
										</MenuItem.ItemTemplate>
									</MenuItem>
								</MenuItem>

						<Separator/>

						<MenuItem Header="Tools" IsVisible="{Binding UI.SuperuserMode}">
							<MenuItem.Icon><ic:SymbolIcon Symbol="Toolbox"/></MenuItem.Icon>
									<MenuItem Header="File info"  Command="{Binding OnInfoDia}" CommandParameter="{Binding $parent[Window]}">
											<MenuItem.Icon><ic:SymbolIcon Symbol="Question"/></MenuItem.Icon>
										</MenuItem>
									<MenuItem Header="Copy Table" Command="{Binding CopyListviewToClipboard}" CommandParameter="{Binding $parent[Window]}" IsVisible="{Binding SelectedFileIsNotSketch}">
										<MenuItem.Icon><ic:SymbolIcon Symbol="TableLightning"/></MenuItem.Icon>
									</MenuItem>
									<Separator/>
									<MenuItem Header="Metadata" IsVisible="{Binding SelectedFileIsNotSketch}">
										<MenuItem.Icon><ic:SymbolIcon Symbol="Database"/></MenuItem.Icon>
										<MenuItem Header="Fetch"     Click="OnFetchSingleMeta">
											<MenuItem.Icon><ic:SymbolIcon Symbol="ArrowDownload"/></MenuItem.Icon>
										</MenuItem>
										<MenuItem Header="Fetch All" Click="OnFetchFullMeta">
											<MenuItem.Icon><ic:SymbolIcon Symbol="ArrowDownload"/></MenuItem.Icon>
										</MenuItem>
										<MenuItem Header="Edit"      Command="{Binding OpenMetaEditDia}" CommandParameter="{Binding $parent[Window]}">
											<MenuItem.Icon><ic:SymbolIcon Symbol="Edit"/></MenuItem.Icon>
										</MenuItem>
										<MenuItem Header="Clear"     Command="{Binding Data.ClearMeta}">
											<MenuItem.Icon><ic:SymbolIcon Symbol="Delete"/></MenuItem.Icon>
										</MenuItem>
									</MenuItem>
									<MenuItem Header="Thumbnail" IsVisible="{Binding SelectedFileIsNotSketch}">
											<MenuItem.Icon><ic:SymbolIcon Symbol="Image"/></MenuItem.Icon>
											<MenuItem Header="Fetch" Click="OnFetchThumbnails">
												<MenuItem.Icon><ic:SymbolIcon Symbol="ArrowDownload"/></MenuItem.Icon>
											</MenuItem>
											<MenuItem Header="Sync" Command="{Binding Data.SyncThumbnails}">
												<MenuItem.Icon><ic:SymbolIcon Symbol="ArrowSync"/></MenuItem.Icon>
											</MenuItem>
											<MenuItem Header="Clear" Command="{Binding Data.ClearThumbnails}">
												<MenuItem.Icon><ic:SymbolIcon Symbol="Delete"/></MenuItem.Icon>
											</MenuItem>
										</MenuItem>
									<MenuItem Header="Content" IsVisible="{Binding SelectedFileIsNotSketch}">
										<MenuItem.Icon><ic:SymbolIcon Symbol="Text"/></MenuItem.Icon>
										<MenuItem Header="Inspect" Command="{Binding OnIndexDia}" CommandParameter="{Binding $parent[Window]}">
											<MenuItem.Icon><ic:SymbolIcon Symbol="BookOpen"/></MenuItem.Icon>
										</MenuItem>
										<MenuItem Header="Fetch"   Click="OnFetchIndex">
											<MenuItem.Icon><ic:SymbolIcon Symbol="ArrowDownload"/></MenuItem.Icon>
										</MenuItem>
										<MenuItem Header="Sync"    Command="{Binding Data.SyncPlainText}">
											<MenuItem.Icon><ic:SymbolIcon Symbol="ArrowSync"/></MenuItem.Icon>
										</MenuItem>
										<MenuItem Header="Clear"   Command="{Binding Data.ClearIndexedContent}">
											<MenuItem.Icon><ic:SymbolIcon Symbol="Delete"/></MenuItem.Icon>
										</MenuItem>
									</MenuItem>
									<Separator/>
									<MenuItem Header="Watermark" IsVisible="{Binding SelectedFileIsNotSketch}">
										<MenuItem.Icon><ic:SymbolIcon Symbol="Tag"/></MenuItem.Icon>
										<MenuItem Header="Förhandskopia" Command="{Binding WatermarkFiles}" CommandParameter="Förhandskopia">
											<MenuItem.Icon><ic:SymbolIcon Symbol="CircleSmall"/></MenuItem.Icon>
										</MenuItem>
										<MenuItem Header="Arbetskopia"   Command="{Binding WatermarkFiles}" CommandParameter="Arbetskopia">
											<MenuItem.Icon><ic:SymbolIcon Symbol="CircleSmall"/></MenuItem.Icon>
										</MenuItem>
									</MenuItem>
									<MenuItem Header="Rename" IsVisible="{Binding SelectedFileIsLocal}" Command="{Binding TryOpenRenameDia}" CommandParameter="{Binding $parent[Window]}">
										<MenuItem.Icon><ic:SymbolIcon Symbol="Rename"/></MenuItem.Icon>
									</MenuItem>
									<MenuItem Header="Replace" IsVisible="{Binding CanReplaceSelectedFiles}" Command="{Binding OpenReplaceDia}" CommandParameter="{Binding $parent[Window]}">
										<MenuItem.Icon><ic:SymbolIcon Symbol="ArrowSwap"/></MenuItem.Icon>
									</MenuItem>
									<MenuItem Header="Cache Locally" IsVisible="{Binding CanCacheSelectedFiles}" Command="{Binding ToggleCacheFilesCommand}" ToolTip.Tip="Toggle local caching for selected files">
										<MenuItem.Icon><ic:SymbolIcon Symbol="ArrowSync"/></MenuItem.Icon>
									</MenuItem>
										</MenuItem>

                       <MenuItem Header="Organize">
							<MenuItem.Icon><ic:SymbolIcon Symbol="GroupList"/></MenuItem.Icon>
							<MenuItem Header="New Group" Click="OnNewGroup">
								<MenuItem.Icon><ic:SymbolIcon Symbol="Add"/></MenuItem.Icon>
							</MenuItem>
							<MenuItem Header="Attach to…" Name="MoveToGroupMenuItem" ItemsSource="{Binding AvailableGroups}" Click="OnMoveToGroup"
									  IsVisible="{Binding SelectedFileIsTopLevel}">
									<MenuItem.Icon><ic:SymbolIcon Symbol="ArrowRight"/></MenuItem.Icon>
									<MenuItem.ItemTemplate>
										<DataTemplate x:DataType="model:FileData"><TextBlock Text="{Binding Namn, StringFormat=' - {0}'}"/></DataTemplate>
									</MenuItem.ItemTemplate>
								</MenuItem>
							<MenuItem Header="Attach Files…" Click="OnAttachFiles" IsVisible="{Binding SelectedFileIsTopLevel}">
								<MenuItem.Icon><ic:SymbolIcon Symbol="Attach"/></MenuItem.Icon>
							</MenuItem>
							<MenuItem Header="Detach" Click="OnDetachFiles" IsVisible="{Binding SelectedFileIsChild}">
								<MenuItem.Icon><ic:SymbolIcon Symbol="ArrowEject"/></MenuItem.Icon>
							</MenuItem>
							<MenuItem Header="Rename Group" Click="OnRenameGroup" IsVisible="{Binding SelectedFileIsGroup}">
									<MenuItem.Icon><ic:SymbolIcon Symbol="Rename"/></MenuItem.Icon>
								</MenuItem>
							<MenuItem Header="Dissolve Group" Click="OnDissolveGroup" IsVisible="{Binding SelectedFileIsGroup}">
								<MenuItem.Icon><ic:SymbolIcon Symbol="DismissCircle"/></MenuItem.Icon>
							</MenuItem>
						    <MenuItem Header="Category" ItemsSource="{Binding CurrentProject.AllowedTypes}" Click="EditType" IsVisible="{Binding CanCategorizeSelectedFiles}">
								<MenuItem.Icon><ic:SymbolIcon Symbol="Folder"/></MenuItem.Icon>
								<MenuItem.ItemTemplate>
									<DataTemplate><TextBlock Text="{ReflectionBinding StringFormat=' - {0}'}"/></DataTemplate>
								</MenuItem.ItemTemplate>
							</MenuItem>

						</MenuItem>

						<Separator/>

						<MenuItem Header="Move" Click="OnMoveFile" ItemsSource="{Binding Storage.StoredProjects}">
							<MenuItem.IsVisible>
								<MultiBinding Converter="{x:Static BoolConverters.And}">
									<Binding Path="CanMoveSelectedFiles"/>
									<Binding Path="UI.SuperuserMode"/>
								</MultiBinding>
							</MenuItem.IsVisible>
							<MenuItem.Icon><ic:SymbolIcon Symbol="DocumentArrowRight"/></MenuItem.Icon>
							<MenuItem.ItemTemplate>
								<DataTemplate><TextBlock Text="{Binding Namn, StringFormat=' - {0}'}"/></DataTemplate>
							</MenuItem.ItemTemplate>
						</MenuItem>
						<MenuItem Header="Remove" Click="OnRemoveFiles">
							<MenuItem.Icon><ic:SymbolIcon Symbol="Delete"/></MenuItem.Icon>
						</MenuItem>
					</ContextMenu>
				</DataGrid.ContextMenu>
			</DataGrid>

				<!-- Empty state message (shown when no files in grid) -->
				<controls:EmptyHint Name="EmptyStateHint" Icon="DocumentAdd" IconSize="36"
							Title="No files loaded" Subtitle="Drop PDF files or folders here, or use File → Load"/>

				<!-- Drag-and-drop hint overlay -->
				<Border Name="DropOverlay" Classes="DropHint"
						Background="{DynamicResource AppDropOverlayBrush}" BorderBrush="{DynamicResource AppDropOverlayBorderBrush}"
						BorderThickness="2" CornerRadius="{Binding UI.CornerRadius}"
						IsVisible="False">
					<StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.9">
						<ic:SymbolIcon Symbol="ArrowDownload" FontSize="32" HorizontalAlignment="Center"/>
						<TextBlock Text="Drop PDFs or folders to add to project" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
					</StackPanel>
				</Border>
			</Panel>
			</Border>
					<Grid Grid.Row="2" MinHeight="200" MaxHeight="400" IsVisible="{Binding UI.ShowFolders}" RowDefinitions="*,Auto" DragDrop.AllowDrop="True">
						<Border Classes="shadow">
						<Panel>
						<DataGrid Name="FolderGrid"
								  ItemsSource="{Binding CurrentProject.Folders}"
								  SelectionMode="Extended" IsReadOnly="True">
						<DataGrid.Columns>
							<DataGridTemplateColumn Header="Type" Width="110">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<StackPanel Orientation="Horizontal" Spacing="5" Margin="6,0" VerticalAlignment="Center" ToolTip.Tip="{Binding Description}">
											<ic:SymbolIcon Symbol="{Binding Mode, Converter={StaticResource FolderModeIconConverter}}" FontSize="14"/>
															<TextBlock Text="{Binding DisplayType}" FontSize="{Binding $parent[DataGrid].DataContext.UI.FontSize}" VerticalAlignment="Center"/>
														</StackPanel>
													</DataTemplate>
												</DataGridTemplateColumn.CellTemplate>
											</DataGridTemplateColumn>
											<DataGridTextColumn Binding="{Binding Name}"               Header="Folder"            Width="*"   FontSize="{Binding UI.FontSize}"/>
											<DataGridTextColumn Binding="{Binding DisplayTarget}"      Header="Target"            Width="2*"   FontSize="{Binding UI.FontSize}" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
											<DataGridTextColumn Binding="{Binding DisplayFileCount}"    Header="Files"             Width="60"   FontSize="{Binding UI.FontSize}"/>
											<DataGridTextColumn Binding="{Binding Path}"               Header="Path"              Width="5*"   FontSize="{Binding UI.FontSize}" FontStyle="Italic" IsVisible="false"/>
						</DataGrid.Columns>
						<DataGrid.ContextMenu>
							<ContextMenu>
								<MenuItem Header="Open Folder" Click="OnOpenFolderPath">
									<MenuItem.Icon><ic:SymbolIcon Symbol="FolderOpen"/></MenuItem.Icon>
								</MenuItem>
								<Separator/>
								<MenuItem Header="Sync Selected" Click="OnSyncSelectedFolders">
									<MenuItem.Icon><ic:SymbolIcon Symbol="ArrowSync"/></MenuItem.Icon>
								</MenuItem>
								<MenuItem Header="Sync All" Click="OnSyncAllFolders">
									<MenuItem.Icon><ic:SymbolIcon Symbol="ArrowSync"/></MenuItem.Icon>
								</MenuItem>
								<MenuItem Header="Manage Synced Files…" Click="OnManageSyncFilter" IsVisible="{Binding UI.SuperuserMode}">
									<MenuItem.Icon><ic:SymbolIcon Symbol="Filter"/></MenuItem.Icon>
								</MenuItem>
								<MenuItem Header="Change Directory…" Click="OnChangeFolderDirectory" IsVisible="{Binding UI.SuperuserMode}">
									<MenuItem.Icon><ic:SymbolIcon Symbol="FolderArrowRight"/></MenuItem.Icon>
								</MenuItem>
								<Separator/>
								<MenuItem Header="Delete" Click="OnRemoveFolder">
									<MenuItem.Icon><ic:SymbolIcon Symbol="Delete"/></MenuItem.Icon>
								</MenuItem>
								<Separator/>
								<MenuItem Header="About Folder Types" Click="OnFolderTypesInfo">
									<MenuItem.Icon><ic:SymbolIcon Symbol="Info"/></MenuItem.Icon>
								</MenuItem>
							</ContextMenu>
						</DataGrid.ContextMenu>
					</DataGrid>
						<controls:EmptyHint Name="FolderEmptyHint" Icon="Folder" IconSize="30"
									Title="No synced folders" Subtitle="Drag a folder onto any grid to start syncing"/>
						<!-- Drop hint for version delivery folders -->
						<Border Name="FolderDropOverlay" Classes="DropHint"
								Background="{DynamicResource AppDropOverlayBrush}" BorderBrush="{DynamicResource AppDropOverlayBorderBrush}"
								BorderThickness="2" CornerRadius="{Binding UI.CornerRadius}">
							<StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.9">
								<ic:SymbolIcon Symbol="History" FontSize="22" HorizontalAlignment="Center"/>
								<TextBlock Text="Drop to create Version Delivery folder" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
							</StackPanel>
						</Border>
											</Panel>
											</Border>
										</Grid>
							</Grid>

		<!-- Preview splitter -->
		<GridSplitter Name="PreviewSplitter" Grid.Column="2" Grid.Row="2"
					  Background="Transparent" ResizeDirection="Columns" Width="10"
					  IsEnabled="{Binding UI.PreviewEmbeddedOpen}">
			<GridSplitter.Template>
				<ControlTemplate>
					<Border Background="Transparent" Width="10">
						<StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="3"
									Opacity="0" Name="GripDots">
							<Ellipse Width="3" Height="3" Fill="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
							<Ellipse Width="3" Height="3" Fill="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
							<Ellipse Width="3" Height="3" Fill="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
						</StackPanel>
					</Border>
				</ControlTemplate>
			</GridSplitter.Template>
		</GridSplitter>

		<!-- ═══════════════════════════════════════════════ -->
		<!-- Side panels                                    -->
		<!-- ═══════════════════════════════════════════════ -->

		<!-- Right panels (calendar + tray) -->
		<Grid Grid.Column="4" Grid.Row="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>
		<!-- Calendar panel -->
		<Grid Grid.Column="0" RowDefinitions="Auto,Auto,2*,2*,40,Auto,Auto" Width="320">
			<Grid.IsVisible>
				<MultiBinding Converter="{x:Static BoolConverters.And}">
					<Binding Path="UI.CalendarOpen"/>
					<Binding Path="UI.SuperuserMode"/>
				</MultiBinding>
			</Grid.IsVisible>
			<Border Grid.Row="0" Classes="shadow" Background="{DynamicResource AppPanelSurfaceBrush}" Width="310" Height="345">
				<StackPanel Orientation="Vertical">
					<Calendar Name="MainCalendar" Height="305" Background="Transparent" HorizontalAlignment="Center"
							  DisplayDate="{Binding Calendar.SelectedDateTime, Mode=TwoWay}"
							  SelectedDate="{Binding Calendar.SelectedDateTime, Mode=TwoWay}"
							  BorderBrush="Transparent" FontSize="{Binding UI.FontSize}"
							  DisplayDateChanged="OnCalendarMonthChanged">
						<Calendar.Styles>
							<Style Selector="CalendarDayButton:selected /template/ ContentPresenter">
								<Setter Property="MinHeight" Value="32"/>
							</Style>
							<Style Selector="CalendarDayButton /template/ Border#Root">
								<Setter Property="CornerRadius" Value="15"/>
							</Style>
							<Style Selector="CalendarDayButton:pointerover /template/ Border#Border">
								<Setter Property="CornerRadius" Value="15"/>
							</Style>
							<Style Selector="CalendarDayButton:selected /template/ Border#Border">
								<Setter Property="CornerRadius" Value="15"/>
							</Style>
							<Style Selector="CalendarDayButton:selected /template/ ContentPresenter">
								<Setter Property="FontWeight" Value="Bold"/>
							</Style>
							<Style Selector="CalendarDayButton:selected:pointerover /template/ Border#Border">
								<Setter Property="CornerRadius" Value="15"/>
							</Style>
							<Style Selector="CalendarDayButton:inactive /template/ Border#Root">
								<Setter Property="Background" Value="Transparent"/>
							</Style>
							<Style Selector="CalendarDayButton:inactive /template/ ContentPresenter">
								<Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
							</Style>
						</Calendar.Styles>
					</Calendar>
					<Grid ColumnDefinitions="40,*,40">
						<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
							<TextBlock Text="{Binding Calendar.CurrentCalendarData.Date}" FontWeight="SemiBold" FontSize="{Binding UI.FontSize}"/>
							<TextBlock Text="| week" FontSize="{Binding UI.FontSize}" FontWeight="SemiBold" VerticalAlignment="Center"/>
							<TextBlock Text="{Binding Calendar.SelectedWeek}" FontWeight="SemiBold" FontSize="{Binding UI.FontSize}"/>
						</StackPanel>
						<Button Grid.Column="2" Width="35" Command="{Binding Calendar.ResetDate}">
							<ic:SymbolIcon Symbol="ArrowCircleLeft" FontSize="18"/>
						</Button>
					</Grid>
				</StackPanel>
			</Border>

			<!-- Daily timesheet entry -->
			<TextBlock Grid.Row="1" Text="{Binding Calendar.DailyTotalDisplay}" VerticalAlignment="Center" FontSize="{Binding UI.FontSizeCompact}" FontWeight="SemiBold" Margin="10,0,0,0" Opacity="0.7"/>
			<StackPanel Grid.Row="1" Orientation="Horizontal" FlowDirection="RightToLeft" Spacing="0" Margin="0,4,0,2">
				<Button Width="28" Command="{Binding Calendar.RemoveTimeSheet}" ToolTip.Tip="Remove selected"><ic:SymbolIcon Symbol="Delete" FontSize="18"/></Button>
				<Button Width="28" Command="{Binding Calendar.NewTimeSheet}" ToolTip.Tip="Add entry"><ic:SymbolIcon Symbol="Add" FontSize="18"/></Button>
				<Button Width="28" Command="{Binding Calendar.CopyFromPreviousDay}" ToolTip.Tip="Copy from previous day"><ic:SymbolIcon Symbol="Copy" FontSize="16"/></Button>
			</StackPanel>

			<!-- Daily timesheet list -->
			<Panel Grid.Row="2" Margin="0" MinHeight="55">
				<DataGrid ItemsSource="{Binding Calendar.CurrentCalendarData.TimeSheets}"
						  SelectedItem="{Binding Calendar.CurrentTimeSheet, Mode=TwoWay}" MinWidth="0"
						  RowHeight="24" HeadersVisibility="Column" GridLinesVisibility="None"
						  HorizontalAlignment="Stretch" CanUserResizeColumns="False" CanUserReorderColumns="False">
					<DataGrid.Columns>
						<DataGridTemplateColumn Header="Hrs" Width="50">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<ComboBox ItemsSource="{Binding $parent[DataGrid].DataContext.Calendar.Hours}"
											  SelectedItem="{Binding Hours}" MinHeight="0" MinWidth="0"
											  Padding="8,0,4,0" FontSize="{Binding $parent[DataGrid].DataContext.UI.FontSizeCompact}" Height="24"
											  HorizontalAlignment="Stretch" VerticalAlignment="Center"
											  VerticalContentAlignment="Center"
											  BorderThickness="0" Background="Transparent"/>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
						<DataGridTemplateColumn Header="Project" Width="100">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<ComboBox ItemsSource="{Binding $parent[DataGrid].DataContext.Calendar.SelectableProjectNames}"
											  SelectedItem="{Binding Project}" MinHeight="0" MinWidth="0"
											  Padding="4,0" FontSize="{Binding $parent[DataGrid].DataContext.UI.FontSizeCompact}" Height="24"
											  HorizontalAlignment="Stretch" VerticalAlignment="Center"
											  VerticalContentAlignment="Center"
											  BorderThickness="0" Background="Transparent"/>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
						<DataGridTextColumn Header="Diary" Binding="{Binding Diary}" Width="*" FontSize="{Binding UI.FontSizeCompact}" MinWidth="80"/>
					</DataGrid.Columns>
					<DataGrid.Styles>
						<Style Selector="DataGrid /template/ Rectangle">
							<Setter Property="IsVisible" Value="False"/>
							<Setter Property="Height" Value="0"/>
							<Setter Property="MaxHeight" Value="0"/>
						</Style>
						<Style Selector="DataGridRow:pointerover ComboBox">
							<Setter Property="Background" Value="Transparent"/>
						</Style>
						<Style Selector="DataGridRow ComboBox:pointerover /template/ Border">
							<Setter Property="Background" Value="Transparent"/>
						</Style>
					</DataGrid.Styles>
				</DataGrid>
				<Ellipse Width="6" Height="6" Fill="{DynamicResource SystemAccentColor}" HorizontalAlignment="Right" VerticalAlignment="Top"
							 Margin="0,9,11,0" IsHitTestVisible="False"/>
			</Panel>

			<!-- Notepad -->
			<Border Grid.Row="3" Classes="shadow" MinHeight="40">
				<Panel>
					<TextBox Text="{Binding Calendar.CurrentCalendarData.Note1}" PlaceholderText="Notepad"
							 AcceptsReturn="True" AcceptsTab="True" FontSize="{Binding UI.FontSize}" VerticalAlignment="Stretch"/>
					<Ellipse Width="6" Height="6" Fill="{StaticResource TagColorGreen}" HorizontalAlignment="Right" VerticalAlignment="Top"
							 Margin="0,4,6,0" IsHitTestVisible="False"/>
				</Panel>
			</Border>

			<!-- Reminder -->
			<Border Grid.Row="4" Classes="shadow">
				<Panel>
					<TextBox Text="{Binding Calendar.CurrentCalendarData.Reminder}" PlaceholderText="Reminder" FontSize="{Binding UI.FontSize}"/>
					<Ellipse Width="6" Height="6" Fill="{StaticResource TagColorOrange}" HorizontalAlignment="Right" VerticalAlignment="Top"
							 Margin="0,4,6,0" IsHitTestVisible="False"/>
				</Panel>
			</Border>

			<!-- Project management & weekly summary -->
			<StackPanel Grid.Row="5" Spacing="3" Margin="0,2,0,0">
				<!-- Project name + nr + add/remove on one row -->
				<StackPanel Orientation="Horizontal" Spacing="0">
					<Border Classes="shadow">
						<TextBox Name="ProjectNameBox" Width="155" PlaceholderText="Project" FontSize="{Binding UI.FontSizeCompact}"
								 Text="{Binding Calendar.CurrentTimeSheetProject.Project, Mode=TwoWay}"/>
					</Border>
					<Border Classes="shadow">
						<TextBox Name="ProjNrBox" Width="75" PlaceholderText="Nr" FontSize="{Binding UI.FontSizeCompact}"
								 Text="{Binding Calendar.CurrentTimeSheetProject.ProjectNr, Mode=TwoWay}"/>
					</Border>
					<Button Width="30" ToolTip.Tip="Add Project" Command="{Binding Calendar.AddTimeProject}"><ic:SymbolIcon Symbol="Add" FontSize="18"/></Button>
					<Button Width="30" ToolTip.Tip="Remove Project" Command="{Binding Calendar.RemoveTimeProject}"><ic:SymbolIcon Symbol="Delete" FontSize="18"/></Button>
				</StackPanel>

				<!-- Weekly hours per project -->
				<DataGrid Name="ProjectSummaryGrid" ItemsSource="{Binding Calendar.TimeProjects}"
						  SelectedItem="{Binding Calendar.CurrentTimeSheetProject, Mode=TwoWay}"
						  IsReadOnly="True" MinWidth="0" RowHeight="22" 
						  HeadersVisibility="None" GridLinesVisibility="None"
						  HorizontalAlignment="Stretch" CanUserResizeColumns="False" CanUserReorderColumns="False">
					<DataGrid.Columns>
						<DataGridTextColumn Header="Project" Binding="{Binding Project}" Width="*" FontSize="{Binding UI.FontSizeCompact}"/>
						<DataGridTextColumn Header="W1" Binding="{Binding W1}" Width="34" FontSize="{Binding UI.FontSizeCompact}"/>
						<DataGridTextColumn Header="W2" Binding="{Binding W2}" Width="34" FontSize="{Binding UI.FontSizeCompact}"/>
						<DataGridTextColumn Header="W3" Binding="{Binding W3}" Width="34" FontSize="{Binding UI.FontSizeCompact}"/>
						<DataGridTextColumn Header="W4" Binding="{Binding W4}" Width="34" FontSize="{Binding UI.FontSizeCompact}"/>
						<DataGridTextColumn Header="W5" Binding="{Binding W5}" Width="34" FontSize="{Binding UI.FontSizeCompact}"/>
						<DataGridTextColumn Header="Σ" Binding="{Binding MonthTotal}" Width="36" FontSize="{Binding UI.FontSizeCompact}"/>
					</DataGrid.Columns>
					<DataGrid.Styles>
						<Style Selector="DataGrid /template/ Rectangle">
							<Setter Property="IsVisible" Value="False"/>
							<Setter Property="Height" Value="0"/>
							<Setter Property="MaxHeight" Value="0"/>
						</Style>
						<Style Selector="DataGridRow:nth-last-child(1)">
							<Setter Property="BorderBrush" Value="{DynamicResource AppDividerBrush}"/>
							<Setter Property="BorderThickness" Value="0,1,0,0"/>
						</Style>
						<Style Selector="DataGridRow:nth-last-child(1) DataGridCell">
							<Setter Property="FontWeight" Value="SemiBold"/>
						</Style>
					</DataGrid.Styles>
				</DataGrid>

				<!-- Diary summary for selected project: Mon–Fri of the selected week -->
				<DataGrid ItemsSource="{Binding Calendar.WeekDiaryEntries}"
						  IsReadOnly="True" MinWidth="0" RowHeight="24" Height="105"
						  HeadersVisibility="None" GridLinesVisibility="None"
						  HorizontalAlignment="Stretch" CanUserResizeColumns="False" CanUserReorderColumns="False">
					<DataGrid.Columns>
						<DataGridTextColumn Header="Day" Binding="{Binding Day}" Width="38" FontSize="{Binding UI.FontSizeCompact}"/>
						<DataGridTextColumn Header="Diary" Binding="{Binding Diary}" Width="*" FontSize="{Binding UI.FontSizeCompact}"/>
						<DataGridTemplateColumn Width="28">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate x:DataType="model:WeekDiaryEntry">
									<Button Width="22" Height="20" Padding="0" MinWidth="0" MinHeight="0"
											Background="Transparent" BorderThickness="0" ToolTip.Tip="Copy diary text"
											Click="OnCopyDiaryEntry">
										<ic:SymbolIcon Symbol="Copy" FontSize="12" Opacity="0.4"/>
									</Button>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
					</DataGrid.Columns>
					<DataGrid.Styles>
						<Style Selector="DataGrid /template/ Rectangle">
							<Setter Property="IsVisible" Value="False"/>
							<Setter Property="Height" Value="0"/>
							<Setter Property="MaxHeight" Value="0"/>
						</Style>
					</DataGrid.Styles>
				</DataGrid>
			</StackPanel>

			<!-- Analog clock (auto-shown when window is tall enough) -->
			<Border Grid.Row="6" Classes="shadow" IsVisible="{Binding UI.ShowClock}"
					Background="{DynamicResource AppPanelSurfaceBrush}"
					BorderBrush="{DynamicResource AppPanelBorderBrush}"
					BorderThickness="{DynamicResource AppBorderThickness}"
					Padding="8" Margin="5" HorizontalAlignment="Stretch">
				<controls:AnalogWatchControl HorizontalAlignment="Center" Height="190" Width="190"
											 FaceBrush="{DynamicResource AppPanelSurfaceBrush}">
				</controls:AnalogWatchControl>
			</Border>
		</Grid>

		<!-- Tray panel (notes, collections, bookmarks, recent, other files, versions) -->
		<Grid Grid.Column="1" IsVisible="{Binding UI.TrayViewOpen}" Width="{Binding UI.TrayWidth}" Classes="AnimatedPanel">
			<Grid.RowDefinitions>
					<RowDefinition Height="{Binding UI.TrayNote,        Converter={StaticResource GridDefConverter}, ConverterParameter=0.3}"/>
					<RowDefinition Height="{Binding UI.TrayCollections, Converter={StaticResource RowDefConverter}}"/>
					<RowDefinition Height="{Binding UI.TrayCollections, Converter={StaticResource GridDefConverter}, ConverterParameter=0.5}"/>
					<RowDefinition Height="{Binding UI.TrayCollections, Converter={StaticResource GridDefConverter}, ConverterParameter=0.8}"/>
					<!-- Bookmarks toolbar (superuser) -->
					<RowDefinition>
						<RowDefinition.Height>
							<MultiBinding Converter="{StaticResource RowDefConverter}" ConverterParameter="0.5">
								<Binding Path="UI.TrayBookmarks"/>
								<Binding Path="UI.SuperuserMode"/>
							</MultiBinding>
						</RowDefinition.Height>
					</RowDefinition>
					<!-- Bookmarks list (superuser) -->
					<RowDefinition>
						<RowDefinition.Height>
							<MultiBinding Converter="{StaticResource GridDefConverter}" ConverterParameter="0.8">
								<Binding Path="UI.TrayBookmarks"/>
								<Binding Path="UI.SuperuserMode"/>
							</MultiBinding>
						</RowDefinition.Height>
					</RowDefinition>
					<RowDefinition Height="{Binding UI.TrayRecent,      Converter={StaticResource GridDefConverter}, ConverterParameter=0.7}"/>
					<!-- Other files (superuser) -->
					<RowDefinition>
						<RowDefinition.Height>
							<MultiBinding Converter="{StaticResource GridDefConverter}">
								<Binding Path="UI.TrayOtherFiles"/>
								<Binding Path="UI.SuperuserMode"/>
							</MultiBinding>
						</RowDefinition.Height>
					</RowDefinition>
					<RowDefinition Height="{Binding UI.TrayVersions,    Converter={StaticResource GridDefConverter}, ConverterParameter=0.6}"/>
					<!-- Annotations (superuser) -->
					<RowDefinition>
						<RowDefinition.Height>
							<MultiBinding Converter="{StaticResource GridDefConverter}" ConverterParameter="0.5">
								<Binding Path="UI.TrayAnnotations"/>
								<Binding Path="UI.SuperuserMode"/>
							</MultiBinding>
						</RowDefinition.Height>
					</RowDefinition>
					<RowDefinition Height="{Binding UI.TrayTodo, Converter={StaticResource GridDefConverter}, ConverterParameter=0.8}"/>
				</Grid.RowDefinitions>

			<!-- File notepad (wrapped in shadow-only border) -->
			<Panel Grid.Row="0" IsVisible="{Binding UI.TrayNote}">
				<Border Classes="shadow">
				<TextBox VerticalContentAlignment="Top" Text="{Binding CurrentFile.Note}" PlaceholderText="Notes for the selected file"
					 FontSize="{Binding UI.FontSize}" AcceptsReturn="True" AcceptsTab="True" VerticalAlignment="Stretch"/>
			</Border>
			</Panel>

			<!-- Collections toolbar -->
			<Grid Grid.Row="1" ColumnDefinitions="*,28,28,28" ColumnSpacing="4" Margin="0,0,5,0" IsVisible="{Binding UI.TrayCollections}">
				<Border Classes="shadow" Grid.Column="0">
					<TextBox Name="CollectionInput" PlaceholderText="Add Collection"/>
				</Border>
			  <Button Grid.Column="1" Width="28" Padding="2" Click="OnNewCollection"    ToolTip.Tip="Add">   <ic:SymbolIcon Symbol="Add"    FontSize="15"/></Button>
				<Button Grid.Column="2" Width="28" Padding="2" Command="{Binding Collections.RemoveCollection}" ToolTip.Tip="Delete"><ic:SymbolIcon Symbol="Delete" FontSize="15"/></Button>
				<Button Grid.Column="3" Width="28" Padding="2" Click="OnRenameCollection" ToolTip.Tip="Rename"><ic:SymbolIcon Symbol="Rename" FontSize="15"/></Button>
			</Grid>

			<!-- Collections list -->
			<Panel Grid.Row="2" IsVisible="{Binding UI.TrayCollections}">
			<Border Classes="shadow">
			<DataGrid Name="Collections"
					  ItemsSource="{Binding Storage.Collections}" SelectedItem="{Binding Collections.CurrentCollection}"
					  SelectionMode="Single" AutoGenerateColumns="False" IsReadOnly="True"
					  GridLinesVisibility="None" LoadingRow="DataGrid_OnLoadingRow">
				<DataGrid.Columns>
					<DataGridTextColumn Binding="{ReflectionBinding}" Header="Collections" Width="*" MinWidth="120" FontSize="{Binding UI.FontSize}"/>
				</DataGrid.Columns>
			</DataGrid>
			</Border>
			<controls:EmptyHint Name="CollectionsEmptyHint" Icon="Album"
						Title="No collections" Subtitle="Type a name above and click + to create one"/>
			</Panel>

			<!-- Collection content -->
			<Panel Grid.Row="3" IsVisible="{Binding UI.TrayCollections}">
			<Border Classes="shadow">
			<DataGrid Name="CollectionContent" Classes="ThumbnailGrid"
					  ItemsSource="{Binding Collections.CollectionContent, Mode=OneWay}" SelectionMode="Single"
					  SelectedItem="{Binding Collections.SelectedCollectionFile}"
					  AutoGenerateColumns="False" IsReadOnly="True" LoadingRow="DataGrid_OnLoadingRow"
					  ToolTip.ServiceEnabled="{Binding UI.ShowThumbnails}">
				<DataGrid.Columns>
					<DataGridTemplateColumn Header="Collection Content" Width="*" MinWidth="120">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate x:DataType="model:FileData">
								<TextBlock Text="{Binding Namn}" VerticalAlignment="Center" Margin="4,0"
										   FontSize="{Binding $parent[DataGrid].DataContext.UI.FontSize}"
										   FontStyle="{Binding IsStyledAsAttached, Converter={x:Static converter:AppendedFileStyleConverter.FontStyle}}"
										   Opacity="{Binding IsStyledAsAttached, Converter={x:Static converter:AppendedFileStyleConverter.Opacity}}"/>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
				</DataGrid.Columns>
				<DataGrid.ContextMenu>
					<ContextMenu>
						<MenuItem Header="View">
							<MenuItem.IsVisible>
								<MultiBinding Converter="{x:Static BoolConverters.And}">
									<Binding Path="PreviewVM.DualFileMode"/>
									<Binding Path="UI.SuperuserMode"/>
								</MultiBinding>
							</MenuItem.IsVisible>
							<MenuItem.Icon><ic:SymbolIcon Symbol="Eye"/></MenuItem.Icon>
							<MenuItem Header="Left" Click="OnViewLeft">
								<MenuItem.Icon><ic:SymbolIcon Symbol="PanelLeft"/></MenuItem.Icon>
							</MenuItem>
							<MenuItem Header="Right" Click="OnViewRight">
								<MenuItem.Icon><ic:SymbolIcon Symbol="PanelRight"/></MenuItem.Icon>
							</MenuItem>
						</MenuItem>
						<MenuItem Header="Remove" Command="{Binding Collections.RemoveFileFromCollection}">
							<MenuItem.Icon><ic:SymbolIcon Symbol="Delete"/></MenuItem.Icon>
						</MenuItem>
					</ContextMenu>
				</DataGrid.ContextMenu>
			</DataGrid>
			</Border>
			<controls:EmptyHint Name="CollectionContentEmptyHint" Icon="DocumentCopy"
						Title="No files in collection" Subtitle="Right-click files in the grid to add them to the selected collection"/>
			</Panel>

			<!-- Bookmarks toolbar -->
			<Grid Grid.Row="4" RowDefinitions="40,*">
				<Grid.IsVisible>
					<MultiBinding Converter="{x:Static BoolConverters.And}">
						<Binding Path="UI.TrayBookmarks"/>
						<Binding Path="UI.SuperuserMode"/>
					</MultiBinding>
				</Grid.IsVisible>
			  <Grid Grid.Row="0" ColumnDefinitions="*,28,28,28" ColumnSpacing="4" Margin="0,0,5,0" >
					<Border Grid.Column="0" Classes="shadow">
						<TextBox Name="BookmarkInput" PlaceholderText="Add Bookmark"/>
					</Border>
					<Button Grid.Column="1" Width="28" Padding="2" Click="OnAddBookmark"    ToolTip.Tip="Add">   <ic:SymbolIcon Symbol="Add"    FontSize="15"/></Button>
				<Button Grid.Column="2" Width="28" Padding="2" Click="OnRemoveBookmark" ToolTip.Tip="Delete"><ic:SymbolIcon Symbol="Delete" FontSize="15"/></Button>
				<Button Grid.Column="3" Width="28" Padding="2" Click="OnRenameBookmark" ToolTip.Tip="Rename"><ic:SymbolIcon Symbol="Rename" FontSize="15"/></Button>
				</Grid>
			</Grid>

			<!-- Bookmarks list -->
			<Panel Grid.Row="5">
				<Panel.IsVisible>
					<MultiBinding Converter="{x:Static BoolConverters.And}">
						<Binding Path="UI.TrayBookmarks"/>
						<Binding Path="UI.SuperuserMode"/>
					</MultiBinding>
				</Panel.IsVisible>
			<Border Classes="shadow">
			<DataGrid Name="BookmarkGrid"
					  ItemsSource="{Binding PreviewVM.CurrentFile.FavPages, Mode=OneWay}" SelectionMode="Single"
					  AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="None"
					  LoadingRow="DataGrid_OnLoadingRow">
				<DataGrid.Columns>
					<DataGridTextColumn Binding="{Binding PageNr, Converter={StaticResource AddOneConverter}}" Header="Page"     Width="85" FontSize="{Binding UI.FontSize}"/>
					<DataGridTextColumn Binding="{Binding PageName}"                                            Header="Bookmark" Width="*"  FontSize="{Binding UI.FontSize}"/>
				</DataGrid.Columns>
			</DataGrid>
			</Border>
			<controls:EmptyHint Name="BookmarksEmptyHint" Icon="Bookmark"
						Title="No bookmarks" Subtitle="Navigate to a page and click + to bookmark"/>
			</Panel>

			<!-- Recent files -->
			<Panel Grid.Row="6" IsVisible="{Binding UI.TrayRecent}">
			<Border Classes="shadow">
			<DataGrid Name="RecentGrid"
					  ItemsSource="{Binding PreviewVM.RecentFiles}" SelectionMode="Single"
					  AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="None"
					  LoadingRow="DataGrid_OnLoadingRow">
				<DataGrid.ContextMenu>
					<ContextMenu>
						<MenuItem Header="Open" Click="OnRecentOpen">
							<MenuItem.Icon><ic:SymbolIcon Symbol="Open"/></MenuItem.Icon>
						</MenuItem>
						<MenuItem Header="Open Folder" Click="OnRecentOpenFolder">
							<MenuItem.Icon><ic:SymbolIcon Symbol="FolderOpen"/></MenuItem.Icon>
						</MenuItem>
						<MenuItem Header="Copy Path" Click="OnRecentCopyPath">
							<MenuItem.Icon><ic:SymbolIcon Symbol="Copy"/></MenuItem.Icon>
						</MenuItem>
					</ContextMenu>
				</DataGrid.ContextMenu>
				<DataGrid.Columns>
					<DataGridTemplateColumn Header="Recent Files" Width="*">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate x:DataType="model:FileData">
								<TextBlock Text="{Binding Namn}" VerticalAlignment="Center" Margin="4,0"
										   FontSize="{Binding $parent[DataGrid].DataContext.UI.FontSize}"
										   FontStyle="{Binding IsStyledAsAttached, Converter={x:Static converter:AppendedFileStyleConverter.FontStyle}}"
										   Opacity="{Binding IsStyledAsAttached, Converter={x:Static converter:AppendedFileStyleConverter.Opacity}}"/>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
				</DataGrid.Columns>
			</DataGrid>
			</Border>
			<controls:EmptyHint Name="RecentEmptyHint" Icon="History"
						Title="No recent files" Subtitle="Recently viewed files will appear here"/>
			</Panel>

			<!-- Other attached files -->
			<Panel Grid.Row="7">
				<Panel.IsVisible>
					<MultiBinding Converter="{x:Static BoolConverters.And}">
						<Binding Path="UI.TrayOtherFiles"/>
						<Binding Path="UI.SuperuserMode"/>
					</MultiBinding>
				</Panel.IsVisible>
				<Border Classes="shadow">
				<DataGrid Name="OtherFilesGrid"
						  ItemsSource="{Binding OtherFilesOwner.OtherFiles, Mode=OneWay}" SelectionMode="Single"
						  AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="None"
						  DragDrop.AllowDrop="True">
					<DataGrid.Columns>
						<DataGridTemplateColumn Width="28" MinWidth="28">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Image Height="16" Source="{Binding IconBytes, Converter={StaticResource ByteArrayToBitmapConverter}}"/>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
						<DataGridTemplateColumn Header="Other Files" Width="*" MinWidth="80">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="4,0"
											   FontSize="{Binding $parent[DataGrid].DataContext.UI.FontSize}"/>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
						<DataGridTextColumn Binding="{Binding Type}" Header="Type" Width="55" MinWidth="40" IsVisible="false"/>
					</DataGrid.Columns>
					<DataGrid.ContextMenu>
						<ContextMenu>
							<MenuItem Header="Open File" Click="OnOpenOtherFile">
								<MenuItem.Icon><ic:SymbolIcon Symbol="Document"/></MenuItem.Icon>
							</MenuItem>
							<MenuItem Header="Open Folder" Click="OnOpenOtherFolder">
								<MenuItem.Icon><ic:SymbolIcon Symbol="FolderOpen"/></MenuItem.Icon>
							</MenuItem>
							<Separator/>
							<MenuItem Header="Remove" Click="OnRemoveOtherFile">
								<MenuItem.Icon><ic:SymbolIcon Symbol="Delete"/></MenuItem.Icon>
							</MenuItem>
						</ContextMenu>
					</DataGrid.ContextMenu>
				</DataGrid>
				</Border>
				<controls:EmptyHint Name="OtherFilesEmptyHint" Icon="Attach"
							Title="No other files" Subtitle="Drop files or folders here to attach"/>
				<!-- Drop hint for other files -->
				<Border Name="OtherFilesDropOverlay" Classes="DropHint"
						Background="{DynamicResource AppDropOverlayBrush}" BorderBrush="{DynamicResource AppDropOverlayBorderBrush}"
						BorderThickness="2" CornerRadius="{Binding UI.CornerRadius}">
					<StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.9">
						<ic:SymbolIcon Symbol="Attach" FontSize="22" HorizontalAlignment="Center"/>
						<TextBlock Text="Drop files or folders to attach" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
					</StackPanel>
				</Border>
			</Panel>

			<!-- File versions panel -->
								<Grid Grid.Row="8" IsVisible="{Binding UI.TrayVersions}">
									<Border Classes="shadow">
										<DataGrid Name="VersionsGrid"
									  ItemsSource="{Binding CurrentFile.Versions, Mode=OneWay}" SelectionMode="Single"
									  AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="None">
									<DataGrid.Styles>
											<Style Selector="DataGridRow">
												<Setter Property="ToolTip.Tip" Value="{Binding (model:FileVersionData).DirectoryPath}"/>
											</Style>
										</DataGrid.Styles>
									<DataGrid.Columns>
										<DataGridTemplateColumn Header="File Versions" Width="*">
											<DataGridTemplateColumn.CellTemplate>
												<DataTemplate x:DataType="model:FileVersionData">
													<StackPanel Orientation="Horizontal" Spacing="6" Margin="6,0,0,0">
														<ic:SymbolIcon Symbol="CheckmarkCircle" FontSize="12"
																	   Foreground="{DynamicResource SystemAccentColor}"
																	   IsVisible="{Binding IsActive}"/>
														<ic:SymbolIcon Symbol="CircleSmall" FontSize="12"
																	   Opacity="0.3"
																	   IsVisible="{Binding !IsActive}"/>
														<TextBlock Text="{Binding Label}" Opacity="{Binding VersionOpacity}"
																   FontSize="{Binding $parent[DataGrid].DataContext.UI.FontSize}"
																   VerticalAlignment="Center"/>
													</StackPanel>
												</DataTemplate>
											</DataGridTemplateColumn.CellTemplate>
										</DataGridTemplateColumn>
										<DataGridTextColumn Header="Date" Width="90"
															Binding="{Binding AddedDate}"
															FontSize="12" IsVisible="false"/>
										<DataGridTextColumn Header="File" Width="100"
															Binding="{Binding ShortName}"
															FontSize="12" IsVisible="false"/>
								</DataGrid.Columns>
								<DataGrid.ContextMenu>
									<ContextMenu>
										<MenuItem Header="Set as Active" Command="{Binding SetActiveVersionCommand}">
											<MenuItem.Icon><ic:SymbolIcon Symbol="CheckmarkCircle"/></MenuItem.Icon>
										</MenuItem>
										<MenuItem Header="Reset to Original" Command="{Binding ResetToOriginalCommand}">
											<MenuItem.Icon><ic:SymbolIcon Symbol="ArrowUndo"/></MenuItem.Icon>
										</MenuItem>
										<Separator/>
										<MenuItem Header="Open" Command="{Binding OpenSelectedVersionCommand}">
											<MenuItem.Icon><ic:SymbolIcon Symbol="DocumentPdf"/></MenuItem.Icon>
										</MenuItem>
										<MenuItem Header="Open Folder" Command="{Binding OpenSelectedVersionFolderCommand}">
											<MenuItem.Icon><ic:SymbolIcon Symbol="FolderOpen"/></MenuItem.Icon>
										</MenuItem>
										<Separator/>
										<MenuItem Header="Label" ItemsSource="{Binding VersionLabels}" Click="OnLabelSelectedVersion">
											<MenuItem.Icon><ic:SymbolIcon Symbol="Tag"/></MenuItem.Icon>
											<MenuItem.ItemTemplate>
												<DataTemplate><TextBlock Text="{ReflectionBinding StringFormat=' - {0}'}"/></DataTemplate>
											</MenuItem.ItemTemplate>
										</MenuItem>
										<MenuItem Header="Label from Folder Date" Click="OnLabelFromFolderDate">
											<MenuItem.Icon><ic:SymbolIcon Symbol="CalendarSearch"/></MenuItem.Icon>
										</MenuItem>
										<Separator/>
										<MenuItem Header="Remove" Click="OnRemoveVersion">
											<MenuItem.Icon><ic:SymbolIcon Symbol="Delete"/></MenuItem.Icon>
										</MenuItem>
									</ContextMenu>
								</DataGrid.ContextMenu>
							</DataGrid>
							</Border>
							<controls:EmptyHint Name="VersionsEmptyHint" Icon="History"
										Title="No versions" Subtitle="Drop version folders onto the grid to track revisions"/>
								</Grid>

								<!-- Annotation Layers panel -->
								<Grid Grid.Row="9" RowDefinitions="Auto,*">
									<Grid.IsVisible>
										<MultiBinding Converter="{x:Static BoolConverters.And}">
											<Binding Path="UI.TrayAnnotations"/>
											<Binding Path="UI.SuperuserMode"/>
										</MultiBinding>
									</Grid.IsVisible>
									<StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="3">
										<Button Width="30" ToolTip.Tip="Add Layer" Click="OnAnnotateNewLayer"><ic:SymbolIcon Symbol="Add" FontSize="16"/></Button>
										<Button Width="30" ToolTip.Tip="Clear Layer" Click="OnClearSelectedLayer"><ic:SymbolIcon Symbol="Delete" FontSize="16"/></Button>
										<Button Width="30" ToolTip.Tip="Remove Layer" Click="OnRemoveSelectedLayer"><ic:SymbolIcon Symbol="Dismiss" FontSize="16"/></Button>
									</StackPanel>
									<Panel Grid.Row="1">
										<Border Classes="shadow">
										<DataGrid Name="LayerList"
												  SelectionMode="Single" SelectionChanged="OnLayerSelected"
												  AutoGenerateColumns="False" IsReadOnly="True"
												  GridLinesVisibility="None" RowHeight="22" HeadersVisibility="None">
											<DataGrid.Columns>
												<DataGridTemplateColumn Width="28" CanUserResize="False">
													<DataGridTemplateColumn.CellTemplate>
														<DataTemplate x:DataType="model:AnnotationLayer">
															<CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}"
																	  Width="18" Height="18" Padding="0" Margin="4,0,0,0"
																	  Click="OnLayerVisibilityToggled"/>
														</DataTemplate>
													</DataGridTemplateColumn.CellTemplate>
												</DataGridTemplateColumn>
												<DataGridTemplateColumn Header="Layer" Width="*">
													<DataGridTemplateColumn.CellTemplate>
														<DataTemplate x:DataType="model:AnnotationLayer">
															<StackPanel Orientation="Horizontal" Spacing="5" Margin="4,0">
																<Ellipse Width="8" Height="8" VerticalAlignment="Center">
																	<Ellipse.Fill>
																		<SolidColorBrush Color="{Binding Color}"/>
																	</Ellipse.Fill>
																</Ellipse>
																<TextBlock Text="{Binding Name}" FontSize="{Binding $parent[DataGrid].DataContext.UI.FontSizeCompact}" VerticalAlignment="Center"/>
															</StackPanel>
														</DataTemplate>
													</DataGridTemplateColumn.CellTemplate>
												</DataGridTemplateColumn>
												<DataGridTemplateColumn Width="30" CanUserResize="False">
													<DataGridTemplateColumn.CellTemplate>
														<DataTemplate x:DataType="model:AnnotationLayer">
															<TextBlock Text="{Binding TotalCount}" FontSize="11"
																	   Opacity="0.5" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/>
														</DataTemplate>
													</DataGridTemplateColumn.CellTemplate>
												</DataGridTemplateColumn>
											</DataGrid.Columns>
										</DataGrid>
										</Border>
											<controls:EmptyHint Name="LayersEmptyHint" Icon="Layer"
														Title="No annotation layers" Subtitle="Click + to add a layer, then draw on the preview"/>
										</Panel>
										</Grid>

										<!-- To-Do List -->
									<Panel Grid.Row="10" IsVisible="{Binding UI.TrayTodo}">
									<Border Classes="shadow">
										<DataGrid Name="TodoGrid"
												  ItemsSource="{Binding CurrentProject.TodoItems}" SelectionMode="Single"
												  AutoGenerateColumns="False" IsReadOnly="False"
												  GridLinesVisibility="None" Padding="0">
										<DataGrid.Styles>
										<Style Selector="DataGridRow">
											<Setter Property="MinHeight" Value="24"/>
										</Style>
									</DataGrid.Styles>
										<DataGrid.ContextMenu>
											<ContextMenu Opening="OnTodoContextMenuOpening">
												<MenuItem Header="New Task" Click="OnAddTodo">
													<MenuItem.Icon><ic:SymbolIcon Symbol="Add"/></MenuItem.Icon>
												</MenuItem>
												<MenuItem Name="AddSubtaskMenuItem" Header="Add Subtask" Click="OnAddSubtask">
													<MenuItem.Icon><ic:SymbolIcon Symbol="TextIndentIncrease"/></MenuItem.Icon>
												</MenuItem>
												<MenuItem Header="Remove" Click="OnRemoveTodo">
													<MenuItem.Icon><ic:SymbolIcon Symbol="Delete"/></MenuItem.Icon>
												</MenuItem>
												<Separator/>
												<MenuItem Header="Move Up" Click="OnMoveTodoUp">
													<MenuItem.Icon><ic:SymbolIcon Symbol="ArrowUp"/></MenuItem.Icon>
												</MenuItem>
												<MenuItem Header="Move Down" Click="OnMoveTodoDown">
													<MenuItem.Icon><ic:SymbolIcon Symbol="ArrowDown"/></MenuItem.Icon>
												</MenuItem>
												<Separator/>
												<MenuItem Header="Color">
													<MenuItem.Icon><ic:SymbolIcon Symbol="Color"/></MenuItem.Icon>
													<MenuItem Header="None"    Tag=""        Click="OnTodoColor">
														<MenuItem.Icon><ic:SymbolIcon Symbol="Dismiss" FontSize="14"/></MenuItem.Icon>
													</MenuItem>
													<MenuItem Header="Red"     Tag="#D64045" Click="OnTodoColor">
														<MenuItem.Icon><Ellipse Width="10" Height="10" Fill="{StaticResource TagColorRed}"/></MenuItem.Icon>
													</MenuItem>
													<MenuItem Header="Orange"  Tag="#E06830" Click="OnTodoColor">
														<MenuItem.Icon><Ellipse Width="10" Height="10" Fill="{StaticResource TagColorOrange}"/></MenuItem.Icon>
													</MenuItem>
													<MenuItem Header="Yellow"  Tag="#E5A820" Click="OnTodoColor">
														<MenuItem.Icon><Ellipse Width="10" Height="10" Fill="{StaticResource TagColorYellow}"/></MenuItem.Icon>
													</MenuItem>
													<MenuItem Header="Green"   Tag="#3DA35F" Click="OnTodoColor">
														<MenuItem.Icon><Ellipse Width="10" Height="10" Fill="{StaticResource TagColorGreen}"/></MenuItem.Icon>
													</MenuItem>
													<MenuItem Header="Blue"    Tag="#3B82D9" Click="OnTodoColor">
														<MenuItem.Icon><Ellipse Width="10" Height="10" Fill="{StaticResource TagColorBlue}"/></MenuItem.Icon>
													</MenuItem>
													<MenuItem Header="Magenta" Tag="#9B5FC0" Click="OnTodoColor">
														<MenuItem.Icon><Ellipse Width="10" Height="10" Fill="{StaticResource TagColorMagenta}"/></MenuItem.Icon>
													</MenuItem>
												</MenuItem>
												<Separator/>
												<MenuItem Header="Clear Completed" Click="OnClearCompletedTodos">
													<MenuItem.Icon><ic:SymbolIcon Symbol="DismissCircle"/></MenuItem.Icon>
												</MenuItem>
											</ContextMenu>
										</DataGrid.ContextMenu>
										<DataGrid.Columns>
											<DataGridTemplateColumn Width="Auto" CanUserResize="False" IsReadOnly="True">
												<DataGridTemplateColumn.CellTemplate>
													<DataTemplate x:DataType="model:TodoItem">
														<CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}"
																  Theme="{StaticResource CompactCheckBox}"
																  Margin="{Binding IndentLevel, Converter={x:Static converter:TodoIndentConverter.Instance}}"
																  Padding="5,0,0,0" VerticalAlignment="Center"/>
													</DataTemplate>
												</DataGridTemplateColumn.CellTemplate>
											</DataGridTemplateColumn>
											<DataGridTemplateColumn Width="8" CanUserResize="False" IsReadOnly="True">
												<DataGridTemplateColumn.CellTemplate>
													<DataTemplate x:DataType="model:TodoItem">
														<Border Width="8" Height="8" CornerRadius="2" VerticalAlignment="Center"
																Background="{Binding Color, Converter={x:Static converter:TodoColorConverter.Instance}}"/>
													</DataTemplate>
												</DataGridTemplateColumn.CellTemplate>
											</DataGridTemplateColumn>
											<DataGridTemplateColumn Header="Tasks" Width="*">
												<DataGridTemplateColumn.CellTemplate>
													<DataTemplate x:DataType="model:TodoItem">
														<TextBlock Text="{Binding Text}" VerticalAlignment="Center" Margin="4,2"
																   TextWrapping="Wrap"
																   FontSize="{Binding $parent[DataGrid].DataContext.UI.FontSize}"
																   TextDecorations="{Binding IsDone, Converter={x:Static converter:TodoStrikethroughConverter.Instance}}"
																   Opacity="{Binding IsDone, Converter={x:Static converter:TodoOpacityConverter.Instance}}"/>
													</DataTemplate>
												</DataGridTemplateColumn.CellTemplate>
												<DataGridTemplateColumn.CellEditingTemplate>
													<DataTemplate x:DataType="model:TodoItem">
														<TextBox Text="{Binding Text, Mode=TwoWay}"
																 TextWrapping="Wrap" AcceptsReturn="False"
																 FontSize="{Binding $parent[DataGrid].DataContext.UI.FontSize}"
																 VerticalAlignment="Stretch" VerticalContentAlignment="Center"
																 Margin="0" Padding="4,2" BorderThickness="0"/>
													</DataTemplate>
												</DataGridTemplateColumn.CellEditingTemplate>
											</DataGridTemplateColumn>
										</DataGrid.Columns>
									</DataGrid>
									</Border>
									<controls:EmptyHint Name="TodoEmptyHint" Icon="Checkmark" IconSize="26"
												Title="No tasks" Subtitle="Right-click to add a task"/>
									</Panel>

								</Grid>
							</Grid>

		<!-- Embedded preview -->
		<Grid Name="PreviewArea" Grid.Column="3" Grid.Row="2" ClipToBounds="True"
			  IsVisible="{Binding UI.PreviewEmbeddedOpen}" Margin="0,5,0,0">
			<views:PreView Name="EmbeddedPreview"/>
		</Grid>

		<!-- Tree view -->
		<Grid Grid.Row="2" Grid.Column="0" IsVisible="{Binding UI.TreeViewOpen}" Width="{Binding UI.TreeViewWidth}" Classes="AnimatedPanel">
            <Border Classes="shadow" Background="{DynamicResource AppPanelSurfaceBrush}">
				<Border Classes="clip-inner" CornerRadius="{DynamicResource AppCornerRadius}" ClipToBounds="True">
				<Grid RowDefinitions="31,Auto,*">
				<Grid Grid.Row="0" ColumnDefinitions="*,Auto" Background="{DynamicResource AppHeaderSurfaceBrush}">
						<StackPanel Orientation="Horizontal" Spacing="6" Margin="8,0,0,0" VerticalAlignment="Center">
							<ic:SymbolIcon Symbol="Folder" IconVariant="Filled" FontSize="13" Foreground="{DynamicResource SystemAccentColor}"/>
						<TextBlock Text="Projects" FontSize="12" FontWeight="SemiBold"
									   Foreground="{DynamicResource AppHeaderForegroundBrush}"
									   VerticalAlignment="Center"/>
						</StackPanel>
						<Button Grid.Column="1" Click="OnTreeNewProjectButton"
								ToolTip.Tip="New Project"
								Classes="ghost"
								Padding="6,2" Margin="0,2,4,2"
								VerticalAlignment="Center">
							<ic:SymbolIcon Symbol="FolderAdd" FontSize="16"/>
						</Button>
					</Grid>
					<Border Grid.Row="1" Height="1"
							Background="{DynamicResource AppDividerBrush}"
							Opacity="0.75" HorizontalAlignment="Stretch"/>
					<TreeView Grid.Row="2" Name="MainTree" Loaded="SetupTreeview" SelectionChanged="OnTreeviewSelected"
											  ItemsSource="{Binding TreeNodes}"
							  SelectedItem="{Binding SelectedTreeNode, Mode=TwoWay}">
						<TreeView.Styles>
							<Style Selector="TreeViewItem" x:DataType="vm:TreeNodeData">
								<Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
								<Setter Property="HorizontalAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="1,1"/>
								<Setter Property="Margin" Value="{Binding NodeMargin}"/>
                                <Setter Property="MinHeight" Value="{Binding NodeMinHeight, FallbackValue=24}"/>
							</Style>
                         <Style Selector="TreeViewItem:selected Border.TreeNodeRow">
								<Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
								<Setter Property="Opacity" Value="0.18"/>
							</Style>
							<Style Selector="TreeViewItem:selected TextBlock.TreeNodeHeader">
								<Setter Property="FontWeight" Value="SemiBold"/>
							</Style>
							<Style Selector="TreeView /template/ ScrollViewer">
								<Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
							</Style>
						</TreeView.Styles>
							<TreeView.ItemTemplate>
								<TreeDataTemplate ItemsSource="{Binding Children}">
                                        <Border Classes="TreeNodeRow" CornerRadius="4" Padding="2,1"
												Background="Transparent"
												Opacity="{Binding NodeOpacity}"
												ContextRequested="OnTreeNodeContextRequested">
											<StackPanel Orientation="Horizontal" Spacing="6">
												<ic:SymbolIcon Symbol="{Binding IconSymbol}" FontSize="14"
														   IsVisible="{Binding IconSymbol, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
										   Foreground="{DynamicResource AppMutedForegroundBrush}"/>
												<TextBlock Classes="TreeNodeHeader" Text="{Binding Header}"
														   FontSize="{Binding FontSize}"
														   FontWeight="{Binding FontWeight}"
														   FontStyle="{Binding FontStyle}"
											Foreground="{Binding ForegroundBrush, TargetNullValue={DynamicResource AppForegroundBrush}}"/>
												<Border
													IsVisible="{Binding BadgeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
														CornerRadius="7"
													Padding="4,0"
													MinWidth="14"
													Opacity="1.0"
										Background="{DynamicResource AppDividerBrush}"
										BorderBrush="{DynamicResource AppStrongBorderBrush}"
													 BorderThickness="0.5"
													Margin="2,0,0,0">
												  <TextBlock Text="{Binding BadgeText}" FontSize="10" HorizontalAlignment="Center" Opacity="1.0"/>
												</Border>
												<ic:SymbolIcon Symbol="{Binding SyncIconSymbol}" FontSize="12"
														   IsVisible="{Binding SyncIconSymbol, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
														   Opacity="0.6" Margin="2,0,0,0"
														   ToolTip.Tip="{Binding SyncTooltip}"/>
												<ic:SymbolIcon Symbol="Eye" FontSize="12"
														   IsVisible="{Binding IsViewer}"
														   Opacity="0.5" Margin="0,0,0,0"
														   ToolTip.Tip="{Binding ViewerTooltip}"/>
											</StackPanel>
										</Border>
									</TreeDataTemplate>
							</TreeView.ItemTemplate>
							<TreeView.ContextMenu>
									<ContextMenu Name="TreeMenu" Opening="OnTreeContextMenuOpening">
										<!-- Always visible -->
										<MenuItem Name="NewProjectMenuItem" Header="New Project" Click="OnTreeNewProjectButton">
											<MenuItem.Icon><ic:SymbolIcon Symbol="FolderAdd"/></MenuItem.Icon>
										</MenuItem>
										<!-- Project nodes only -->
										<MenuItem Name="AddFilesMenuItem" Header="Add Files" Click="OnAddFiles">
											<MenuItem.Icon><ic:SymbolIcon Symbol="DocumentAdd"/></MenuItem.Icon>
										</MenuItem>
										<MenuItem Name="EditProjectMenuItem" Header="Edit Project" Command="{Binding OpenProjectEditDia}" CommandParameter="{Binding $parent[Window]}">
											<MenuItem.Icon><ic:SymbolIcon Symbol="Edit"/></MenuItem.Icon>
										</MenuItem>
										<Separator Name="SharedSeparator"/>
								<MenuItem x:Name="ShareMenuItem" Header="Share">
										<MenuItem.Icon><ic:SymbolIcon Symbol="People"/></MenuItem.Icon>
										<MenuItem Name="MakeSharedMenuItem" Header="Make Shared…" Click="OnMakeProjectShared">
											<MenuItem.Icon><ic:SymbolIcon Symbol="People"/></MenuItem.Icon>
										</MenuItem>
										<MenuItem Name="ImportSharedMenuItem" Header="Import Shared…" Click="OnImportSharedProject">
											<MenuItem.Icon><ic:SymbolIcon Symbol="CloudArrowDown"/></MenuItem.Icon>
										</MenuItem>
										<MenuItem Name="PushMenuItem" Header="Push to Server" Click="OnPushProject">
											<MenuItem.Icon><ic:SymbolIcon Symbol="ArrowUpload"/></MenuItem.Icon>
										</MenuItem>
										<MenuItem Name="PullMenuItem" Header="Pull from Server" Click="OnPullProject">
											<MenuItem.Icon><ic:SymbolIcon Symbol="ArrowDownload"/></MenuItem.Icon>
										</MenuItem>
										<MenuItem Name="UnshareMenuItem" Header="Make Local" Click="OnUnshareProject">
											<MenuItem.Icon><ic:SymbolIcon Symbol="PersonDelete"/></MenuItem.Icon>
										</MenuItem>
										<MenuItem Name="RestoreBackupMenuItem" Header="Restore Backup…" Click="OnRestoreBackup">
											<MenuItem.Icon><ic:SymbolIcon Symbol="History"/></MenuItem.Icon>
										</MenuItem>
									</MenuItem>
									<MenuItem Name="ExportProjectMenuItem" Header="Export" Click="OnExportProjectZip">
										<MenuItem.Icon><ic:SymbolIcon Symbol="DocumentArrowDown"/></MenuItem.Icon>
									</MenuItem>
										<Separator Name="RemoveSeparator"/>
										<MenuItem Name="RemoveProjectMenuItem" Header="Remove" Click="OnRemoveProject">
											<MenuItem.Icon><ic:SymbolIcon Symbol="Delete"/></MenuItem.Icon>
										</MenuItem>
									</ContextMenu>
								</TreeView.ContextMenu>
																	</TreeView>
																</Grid>
																</Border>
															</Border>
														</Grid>
										</Grid>
									</UserControl>
