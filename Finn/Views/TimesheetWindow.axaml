<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Finn.ViewModels"
        xmlns:m="clr-namespace:Finn.Model"
        xmlns:ic="using:FluentIcons.Avalonia"
        x:Class="Finn.Views.TimesheetWindow"
        x:DataType="vm:MainViewModel"
        Width="580" Height="1100"
        MinWidth="580"
        MaxWidth="580"
        MinHeight="1100"
        Title="Timesheets"
		ExtendClientAreaToDecorationsHint="True"
        Icon="/Assets/folder.ico"
        RequestedThemeVariant="{Binding UI.Theme}"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

	<Window.Styles>
		<Style Selector="Button.accent">
			<Setter Property="CornerRadius" Value="{Binding UI.CornerRadius}"/>
			<Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="FontSize" Value="15"/>
		</Style>
	</Window.Styles>

  <Grid RowDefinitions="120,300,40,*" Margin="8">

	<StackPanel Grid.Column="0" Grid.ColumnSpan="2" Orientation="Vertical" HorizontalAlignment="Center" Spacing="6" Margin="0,36,0,0">
		<Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource SystemAccentColor}" HorizontalAlignment="Center">
			<ContentControl>
				<ic:SymbolIcon Symbol="BookDatabase" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
			</ContentControl>
		</Border>
		<TextBlock Text="Time Sheet Projects" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
	</StackPanel>


    <DataGrid Grid.Row="1" Name="ProjectList" x:DataType="m:TimeSheetProjectData"
              ItemsSource="{x:Null}" SelectionMode="Single"
              IsReadOnly="True" SelectionChanged="OnProjectListSelectionChanged">
      <DataGrid.Columns>
        <DataGridTextColumn Binding="{Binding Project}" Header="Projects" Width="*" FontSize="14"/>
        <DataGridTextColumn Binding="{Binding W1}" Header="W1" Width="SizeToHeader" FontSize="14"/>
        <DataGridTextColumn Binding="{Binding W2}" Header="W2" Width="SizeToHeader" FontSize="14"/>
        <DataGridTextColumn Binding="{Binding W3}" Header="W3" Width="SizeToHeader" FontSize="14"/>
        <DataGridTextColumn Binding="{Binding W4}" Header="W4" Width="SizeToHeader" FontSize="14"/>
        <DataGridTextColumn Binding="{Binding W5}" Header="W5" Width="SizeToHeader" FontSize="14"/>
      </DataGrid.Columns>
    </DataGrid>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Spacing="6">
      <Border Classes="shadow">
        <TextBox Name="ProjNameBox" MinWidth="0" Width="160" Watermark="New Project" BorderThickness="0" Margin="0" TextChanged="OnProjectTextChanged"/>
      </Border>
      <Border Classes="shadow">
        <TextBox Name="ProjNrBox" MinWidth="0" Width="140" Watermark="Project Nr" BorderThickness="0" Margin="0" TextChanged="OnProjectTextChanged"/>
      </Border>
      <Border Classes="shadow">
        <TextBox Name="ProjTaskBox" MinWidth="0" Width="105" Watermark="Task" BorderThickness="0" Margin="0" TextChanged="OnProjectTextChanged"/>
      </Border>
      <Button Width="35" Click="OnNewTimeSheet">   <ic:SymbolIcon Symbol="Add"    FontSize="18"/></Button>
      <Button Width="35" Click="OnRemoveTimeSheet"><ic:SymbolIcon Symbol="Delete" FontSize="18"/></Button>
      <!-- Save calendar data to file using CalendarService -->
      <Button Width="35" Click="OnSaveCalendarData" ToolTip.Tip="Save calendar to file">
        <ic:SymbolIcon Symbol="Save" FontSize="18"/>
      </Button>
    </StackPanel>

    <DataGrid Grid.Row="3" ItemsSource="{Binding Calendar.MonthlyNotes}" CanUserSortColumns="False">
      <DataGrid.Columns>
        <DataGridTextColumn Binding="{Binding DateString}" Header="Date" Width="Auto" FontSize="14"/>
        <DataGridTextColumn Binding="{Binding CurrentTimeSheetProjectTime}" Header="t" Width="50" MinWidth="50" FontSize="14"/>
        <DataGridTextColumn Binding="{Binding CurrentTimeSheetProjectDiary}" Header="Diary" Width="*" MinWidth="100" FontSize="14"/>
      </DataGrid.Columns>
    </DataGrid>
  </Grid>

</Window>
