<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Finn.Views.SplashWindow"
    Width="340"
    Height="160"
    WindowStartupLocation="CenterScreen"
    CanResize="False"
    ShowInTaskbar="False"
    WindowDecorations="None"
    Background="Transparent"
    TransparencyLevelHint="Transparent"
    Icon="/Assets/folder.ico">

    <!-- Wrapper with padding for shadow -->
    <Border Padding="12">
        <Border
            Classes="shadow"
            CornerRadius="{DynamicResource AppCornerRadius}"
            Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource AppStrongBorderBrush}"
            BorderThickness="1">

            <Grid RowDefinitions="*,Auto,Auto,*" Margin="32,24">
                <TextBlock
                    Grid.Row="1"
                    Text="FINN"
                    FontSize="32"
                    FontWeight="Bold"
                    FontFamily="{DynamicResource AppHeaderFontFamily}"
                    Foreground="{DynamicResource AppForegroundBrush}"
                    HorizontalAlignment="Center"
                    Opacity="0.95" />

                <TextBlock
                    Grid.Row="2"
                    x:Name="StatusText"
                    Text="Starting..."
                    FontSize="12"
                    FontStyle="Italic"
                    Foreground="{DynamicResource AppMutedForegroundBrush}"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,0" />
            </Grid>
        </Border>
    </Border>
</Window>