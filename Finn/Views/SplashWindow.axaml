<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Finn.Views.SplashWindow"
    Width="340"
    Height="160"
    WindowStartupLocation="CenterScreen"
    CanResize="False"
    ShowInTaskbar="False"
    WindowDecorations="None"
    Icon="/Assets/folder.ico">

    <Border
        Background="{DynamicResource SystemChromeMediumLowColor}">

        <Grid RowDefinitions="*,Auto,Auto,*" Margin="32,24">
            <TextBlock
                Grid.Row="1"
                Text="FINN"
                FontSize="28"
                FontWeight="SemiBold"
                HorizontalAlignment="Center"
                Opacity="0.92" />

            <TextBlock
                Grid.Row="2"
                x:Name="StatusText"
                Text="Starting..."
                FontSize="13"
                FontStyle="Italic"
                HorizontalAlignment="Center"
                Opacity="0.55"
                Margin="0,8,0,0" />
        </Grid>
    </Border>
</Window>