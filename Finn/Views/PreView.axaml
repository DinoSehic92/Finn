<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Finn.ViewModels"
			 xmlns:mupdf="clr-namespace:MuPDFCore.MuPDFRenderer;assembly=MuPDFCore.MuPDFRenderer"
			 xmlns:ic="using:FluentIcons.Avalonia" 
			 xmlns:converter="clr-namespace:Finn.Converters"
			 xmlns:ctrl="clr-namespace:Finn.Controls"
			 xmlns:model="clr-namespace:Finn.Model"
						 mc:Ignorable="d"
             x:DataType="vm:MainViewModel"
             x:Class="Finn.Views.PreView">
	
	<UserControl.Resources>
		<converter:ShortenStringConverter x:Key="ShortenStringConverter" />
		<converter:AddOneConverter x:Key="AddOneConverter"/>
		<converter:AddPageConverter x:Key="AddPageConverter"/>
		<converter:GridDefConverter x:Key="GridDefConverter"/>
	</UserControl.Resources>

	<UserControl.Styles>
		<Style Selector="Border">
			<Setter Property="CornerRadius" Value="{Binding UI.CornerRadius}"/>
		</Style>
		<Style Selector="Slider#OpacitySlider /template/ Thumb">
			<Setter Property="Width" Value="12"/>
			<Setter Property="Height" Value="12"/>
		</Style>
	</UserControl.Styles>

	<Grid Name="MainPreviewGrid" RowDefinitions="*,40" ColumnDefinitions="*,Auto" Margin="0">
		<Grid Name="PreviewGrid" ClipToBounds="True" ColumnDefinitions="*" RowDefinitions="*"
	  Grid.Row="0" Grid.Column="0"
	  Background="{Binding PreviewVM.PreviewBackground}">

			<LayoutTransformControl Name="Tester">
				<LayoutTransformControl.LayoutTransform>
					<RotateTransform Angle="{Binding PreviewVM.Rotation}"/>
				</LayoutTransformControl.LayoutTransform>

				<Grid Name="ViewArea" Grid.Column="1" Grid.Row="0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="5"/>
						<ColumnDefinition Width="{Binding PreviewVM.TwopageMode, Converter={StaticResource GridDefConverter}}"/>
					</Grid.ColumnDefinitions>

					 <ctrl:AnnotatedPDFRenderer Name="MuPDFRenderer" Grid.Column="0" Background="Transparent" PageBackground="White"
						ZoomEnabled="False" PointerWheelChanged="ModifiedControlPointerWheelChanged"
						ZoomIncrement="1.3" ClipToBounds="True" PointerEventHandlersType="PanHighlight" Focusable="True">
								 <ctrl:AnnotatedPDFRenderer.ContextMenu>
									 <ContextMenu>
										 <MenuItem Header="Copy" Command="{Binding PreviewVM.CopyToClipboard}" CommandParameter="{Binding $parent[Window]}">
											 <MenuItem.Icon><ic:SymbolIcon Symbol="Clipboard"/></MenuItem.Icon>
										 </MenuItem>
									 </ContextMenu>
								 </ctrl:AnnotatedPDFRenderer.ContextMenu>
							 </ctrl:AnnotatedPDFRenderer>

							 <mupdf:PDFRenderer Name="MuPDFRendererSecondary" Grid.Column="2" Background="Transparent" PageBackground="White"
						ZoomEnabled="False" PointerWheelChanged="ModifiedControlPointerWheelChanged"
						ZoomIncrement="1.3" ClipToBounds="True" PointerEventHandlersType="PanHighlight" IsVisible="False"
						MinWidth="1" MinHeight="1">
						<mupdf:PDFRenderer.ContextMenu>
							<ContextMenu>
								<MenuItem Header="Copy" Command="{Binding PreviewVM.CopyToClipboard}" CommandParameter="{Binding $parent[Window]}">
									<MenuItem.Icon><ic:SymbolIcon Symbol="Clipboard"/></MenuItem.Icon>
								</MenuItem>
							</ContextMenu>
						</mupdf:PDFRenderer.ContextMenu>
					</mupdf:PDFRenderer>

						<!-- Inversion overlay: renders LAST, spans all columns, passes input through -->
						<ctrl:InvertColorControl Grid.ColumnSpan="3"
						IsInverted="{Binding PreviewVM.DarkMode}"
						BackgroundColor="{Binding PreviewVM.ThemeRegionColor}"
						IsHitTestVisible="False" />

					<!-- Loading overlay shown while previewer is busy -->
					<Grid Grid.ColumnSpan="3" IsVisible="{Binding PreviewVM.FileWorkerBusy}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
						<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
							<ic:SymbolIcon Symbol="ArrowClockwise" FontSize="36" Foreground="White"/>
							<TextBlock Text="{Binding PreviewVM.StatusMessage}" Foreground="White" FontSize="14" HorizontalAlignment="Center"/>
							<ProgressBar Width="200" Height="6" Minimum="0" Maximum="100" Value="{Binding PreviewVM.Progress}"/>
							<Button Content="Cancel" IsVisible="{Binding PreviewVM.DiffBusy}"
									Click="OnCancelDiff" Padding="16,4" HorizontalAlignment="Center"
									Foreground="White" Background="Transparent"
									BorderThickness="1" BorderBrush="White" CornerRadius="3"/>
						</StackPanel>
					</Grid>
				</Grid>
			</LayoutTransformControl>

			<!-- Mode banner: Dual File (only for user-initiated, not diff side-by-side) -->
			<Border Name="DualFileBanner" IsVisible="{Binding PreviewVM.IsUserDualFileMode}" IsHitTestVisible="True"
					HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
					Background="{DynamicResource TextControlBackground}" CornerRadius="6"
					Padding="10,5" Opacity="0.92"
					BoxShadow="0 1 4 0 #40000000">
				<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
					<ic:SymbolIcon Symbol="BookAdd" IconVariant="Regular" FontSize="14" Opacity="0.7"/>
					<TextBlock Text="Dual File — use View Left / Right to set files" FontSize="11" VerticalAlignment="Center" Opacity="0.7"/>
					<Button Content="✕" FontSize="11" Padding="4,1" MinWidth="0" MinHeight="0"
							ToolTip.Tip="Exit Dual File mode" Click="OnCloseDualFileMode"
							Background="Transparent" BorderThickness="0"/>
				</StackPanel>
			</Border>

			<!-- Mode banner: Diff Comparison -->
			<Border Name="DiffModeBanner" IsVisible="{Binding PreviewVM.DiffOverlayActive}" IsHitTestVisible="True"
					HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
					Background="{DynamicResource TextControlBackground}" CornerRadius="6"
					Padding="10,5" Opacity="0.92"
					BoxShadow="0 1 4 0 #40000000">
				<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
					<ic:SymbolIcon Symbol="DocumentPageBreak" IconVariant="Regular" FontSize="14" Opacity="0.7"/>
					<TextBlock Text="{Binding PreviewVM.DiffSummary}" FontSize="11" VerticalAlignment="Center" Opacity="0.7"/>
					<Button Content="✕" FontSize="11" Padding="4,1" MinWidth="0" MinHeight="0"
							ToolTip.Tip="Close diff comparison" Click="OnCloseDiffMode"
							Background="Transparent" BorderThickness="0"/>
				</StackPanel>
			</Border>

			<!-- Annotation toolbar: floating overlay at top of preview, above the PDF -->
			<Border Name="AnnotateToolbar" IsVisible="False" IsHitTestVisible="True"
					HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
					Background="{DynamicResource TextControlBackground}" CornerRadius="6"
					Padding="4,2" Opacity="0.92"
					BoxShadow="0 1 4 0 #40000000">
				<StackPanel Spacing="1">
					<!-- Row 1: Tools & Actions -->
					<StackPanel Orientation="Horizontal" Spacing="1">
						<!-- Select -->
						<Button ToolTip.Tip="Select / Move (V)" Width="26" Height="26" Padding="0" Tag="Select" Click="OnAnnotateToolSelect" BorderThickness="0">
							<ic:SymbolIcon Symbol="Cursor" IconVariant="Regular" FontSize="14"/>
						</Button>
						<Border Width="2" Background="#50888888" Margin="3,4" CornerRadius="1"/>
						<!-- Freehand -->
						<Button ToolTip.Tip="Draw (1)" Width="26" Height="26" Padding="0" Tag="Draw" Click="OnAnnotateToolSelect" BorderThickness="0">
							<ic:SymbolIcon Symbol="Pen" IconVariant="Regular" FontSize="14"/>
						</Button>
						<Button ToolTip.Tip="Highlight (2)" Width="26" Height="26" Padding="0" Tag="Highlight" Click="OnAnnotateToolSelect" BorderThickness="0">
							<ic:SymbolIcon Symbol="Highlight" IconVariant="Regular" FontSize="14"/>
						</Button>
						<Button ToolTip.Tip="Polyline (P) — click to add, right-click to finish" Width="26" Height="26" Padding="0" Tag="Polyline" Click="OnAnnotateToolSelect" BorderThickness="0">
							<ic:SymbolIcon Symbol="Flowchart" IconVariant="Regular" FontSize="14"/>
						</Button>
						<Border Width="2" Background="#50888888" Margin="3,4" CornerRadius="1"/>
						<!-- Shapes -->
						<Button ToolTip.Tip="Rectangle (3)" Width="26" Height="26" Padding="0" Tag="Rectangle" Click="OnAnnotateToolSelect" BorderThickness="0">
							<ic:SymbolIcon Symbol="Square" IconVariant="Regular" FontSize="14"/>
						</Button>
						<Button ToolTip.Tip="Ellipse (4)" Width="26" Height="26" Padding="0" Tag="Ellipse" Click="OnAnnotateToolSelect" BorderThickness="0">
							<ic:SymbolIcon Symbol="Circle" IconVariant="Regular" FontSize="14"/>
						</Button>
						<Button ToolTip.Tip="Line (5)" Width="26" Height="26" Padding="0" Tag="Line" Click="OnAnnotateToolSelect" BorderThickness="0">
							<ic:SymbolIcon Symbol="Line" IconVariant="Regular" FontSize="14"/>
						</Button>
						<Button ToolTip.Tip="Arrow (6)" Width="26" Height="26" Padding="0" Tag="Arrow" Click="OnAnnotateToolSelect" BorderThickness="0">
							<ic:SymbolIcon Symbol="ArrowRight" IconVariant="Regular" FontSize="14"/>
						</Button>
						<Button ToolTip.Tip="Revision Cloud" Width="26" Height="26" Padding="0" Tag="RevisionCloud" Click="OnAnnotateToolSelect" BorderThickness="0">
							<ic:SymbolIcon Symbol="Cloud" IconVariant="Regular" FontSize="14"/>
						</Button>
						<Border Width="2" Background="#50888888" Margin="3,4" CornerRadius="1"/>
						<!-- Text -->
						<Button ToolTip.Tip="Comment (7)" Width="26" Height="26" Padding="0" Tag="Text" Click="OnAnnotateToolSelect" BorderThickness="0">
							<ic:SymbolIcon Symbol="TextFont" IconVariant="Regular" FontSize="14"/>
						</Button>
						<Button ToolTip.Tip="Arrow Comment (8)" Width="26" Height="26" Padding="0" Tag="ArrowText" Click="OnAnnotateToolSelect" BorderThickness="0">
							<ic:SymbolIcon Symbol="TextDescription" IconVariant="Regular" FontSize="14"/>
						</Button>
						<Button ToolTip.Tip="Sticky Note" Width="26" Height="26" Padding="0" Tag="StickyNote" Click="OnAnnotateToolSelect" BorderThickness="0">
							<ic:SymbolIcon Symbol="Note" IconVariant="Regular" FontSize="14"/>
						</Button>
						<Border Width="2" Background="#50888888" Margin="3,4" CornerRadius="1"/>
						<!-- Measure / Erase -->
						<Button ToolTip.Tip="Measure (9) — Shift to lock axis" Width="26" Height="26" Padding="0" Tag="MeasureDistance" Click="OnAnnotateToolSelect" BorderThickness="0">
							<ic:SymbolIcon Symbol="Ruler" IconVariant="Regular" FontSize="14"/>
						</Button>
						<Button ToolTip.Tip="Eraser (0)" Width="26" Height="26" Padding="0" Tag="Eraser" Click="OnAnnotateToolSelect" BorderThickness="0">
							<ic:SymbolIcon Symbol="Eraser" IconVariant="Regular" FontSize="14"/>
						</Button>
						<Border Width="2" Background="#50888888" Margin="3,4" CornerRadius="1"/>
						<!-- Undo / Redo / Clear -->
						<Button Name="UndoBtn" ToolTip.Tip="Undo (Ctrl+Z)" Width="26" Height="26" Padding="0" Click="OnAnnotateUndo" BorderThickness="0">
							<ic:SymbolIcon Symbol="ArrowUndo" IconVariant="Regular" FontSize="14"/>
						</Button>
						<Button Name="RedoBtn" ToolTip.Tip="Redo (Ctrl+Y)" Width="26" Height="26" Padding="0" Click="OnAnnotateRedo" BorderThickness="0">
							<ic:SymbolIcon Symbol="ArrowRedo" IconVariant="Regular" FontSize="14"/>
						</Button>
						<Button ToolTip.Tip="Clear Page" Width="26" Height="26" Padding="0" Click="OnAnnotateClear" BorderThickness="0">
							<ic:SymbolIcon Symbol="Delete" IconVariant="Regular" FontSize="14"/>
						</Button>
						<Border Width="2" Background="#50888888" Margin="3,4" CornerRadius="1"/>
						<!-- Export -->
						<Button ToolTip.Tip="Save Image (Ctrl+S)" Width="26" Height="26" Padding="0" Click="OnAnnotateSave" BorderThickness="0">
							<ic:SymbolIcon Symbol="Save" IconVariant="Regular" FontSize="14"/>
						</Button>
						<Button ToolTip.Tip="Copy (Ctrl+C)" Width="26" Height="26" Padding="0" Click="OnAnnotateCopy" BorderThickness="0">
							<ic:SymbolIcon Symbol="Clipboard" IconVariant="Regular" FontSize="14"/>
						</Button>
						<Button ToolTip.Tip="Export Review" Width="26" Height="26" Padding="0" Click="OnAnnotateExportReview" BorderThickness="0">
							<ic:SymbolIcon Symbol="ArrowExportUp" IconVariant="Regular" FontSize="14"/>
						</Button>
							<TextBlock Name="AnnotationCountBadge" Text="" FontSize="9" VerticalAlignment="Center" Margin="3,0"
								Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Opacity="0.7"/>
							<TextBlock Name="ActiveToolLabel" Text="Draw" FontSize="9" VerticalAlignment="Center" Margin="3,0"
								Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Opacity="0.5" FontStyle="Italic"/>
							<Border Width="2" Background="#50888888" Margin="3,4" CornerRadius="1"/>
							<Button Name="LayerPickerBtn" ToolTip.Tip="Active layer — click to switch" Height="26" Padding="4,0" Click="OnLayerPickerClick" BorderThickness="0">
								<StackPanel Orientation="Horizontal" Spacing="3">
									<ic:SymbolIcon Symbol="Layer" IconVariant="Regular" FontSize="12"/>
									<TextBlock Name="ActiveLayerLabel" Text="Layer 1" FontSize="9" VerticalAlignment="Center" Opacity="0.7" MaxWidth="60" TextTrimming="CharacterEllipsis"/>
								</StackPanel>
							</Button>
							<Button Name="LayerVisBtn" ToolTip.Tip="Toggle active layer visibility" Width="26" Height="26" Padding="0" Click="OnToggleLayerVisibility" BorderThickness="0">
								<ic:SymbolIcon Symbol="Eye" IconVariant="Regular" FontSize="14"/>
							</Button>
						</StackPanel>
					<!-- Row 2: Colors, Stroke, Properties -->
					<StackPanel Orientation="Horizontal" Spacing="1" HorizontalAlignment="Center">
						<Button ToolTip.Tip="Red" Width="18" Height="18" Padding="0" MinWidth="0" MinHeight="0"
							Background="#D64045" Opacity="0.85" Tag="Red" Click="OnAnnotateColor" CornerRadius="9"/>
						<Button ToolTip.Tip="Blue" Width="18" Height="18" Padding="0" MinWidth="0" MinHeight="0"
							Background="#3B82D9" Opacity="0.85" Tag="Blue" Click="OnAnnotateColor" CornerRadius="9"/>
						<Button ToolTip.Tip="Green" Width="18" Height="18" Padding="0" MinWidth="0" MinHeight="0"
							Background="#3DA35F" Opacity="0.85" Tag="Green" Click="OnAnnotateColor" CornerRadius="9"/>
						<Button ToolTip.Tip="Black" Width="18" Height="18" Padding="0" MinWidth="0" MinHeight="0"
							Background="#222222" Opacity="0.85" Tag="Black" Click="OnAnnotateColor" CornerRadius="9"/>
						<Button ToolTip.Tip="Orange" Width="18" Height="18" Padding="0" MinWidth="0" MinHeight="0"
							Background="#E87D2F" Opacity="0.85" Tag="Orange" Click="OnAnnotateColor" CornerRadius="9"/>
						<Button ToolTip.Tip="Purple" Width="18" Height="18" Padding="0" MinWidth="0" MinHeight="0"
							Background="#8B5CF6" Opacity="0.85" Tag="Purple" Click="OnAnnotateColor" CornerRadius="9"/>
						<Button ToolTip.Tip="Yellow" Width="18" Height="18" Padding="0" MinWidth="0" MinHeight="0"
							Background="#F5C332" Opacity="0.85" Tag="Yellow" Click="OnAnnotateColor" CornerRadius="9"/>
						<Button ToolTip.Tip="Teal" Width="18" Height="18" Padding="0" MinWidth="0" MinHeight="0"
							Background="#26A69A" Opacity="0.85" Tag="Teal" Click="OnAnnotateColor" CornerRadius="9"/>
						<Button ToolTip.Tip="Pink" Width="18" Height="18" Padding="0" MinWidth="0" MinHeight="0"
							Background="#EC407A" Opacity="0.85" Tag="Pink" Click="OnAnnotateColor" CornerRadius="9"/>
						<Button ToolTip.Tip="Brown" Width="18" Height="18" Padding="0" MinWidth="0" MinHeight="0"
							Background="#8D6E63" Opacity="0.85" Tag="Brown" Click="OnAnnotateColor" CornerRadius="9"/>
						<Button ToolTip.Tip="Custom Color" Width="18" Height="18" Padding="0" MinWidth="0" MinHeight="0"
							BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Click="OnAnnotateCustomColor" CornerRadius="9">
							<ic:SymbolIcon Symbol="ColorLine" IconVariant="Regular" FontSize="10"/>
						</Button>
						<Border Width="2" Background="#50888888" Margin="3,3" CornerRadius="1"/>
						<Button ToolTip.Tip="Thin 1px ([/] to adjust)" Width="22" Height="22" Padding="0" Tag="1" Click="OnAnnotateWidth" BorderThickness="0">
							<Ellipse Width="4" Height="4" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
						</Button>
						<Button ToolTip.Tip="Medium 2px" Width="22" Height="22" Padding="0" Tag="2" Click="OnAnnotateWidth" BorderThickness="0">
							<Ellipse Width="6" Height="6" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
						</Button>
						<Button ToolTip.Tip="Thick 4px" Width="22" Height="22" Padding="0" Tag="4" Click="OnAnnotateWidth" BorderThickness="0">
							<Ellipse Width="9" Height="9" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
						</Button>
						<Button Name="FillToggleBtn" ToolTip.Tip="Toggle Fill" Width="22" Height="22" Padding="0" Click="OnToggleFill" BorderThickness="0">
							<ic:SymbolIcon Symbol="PaintBucket" IconVariant="Regular" FontSize="12"/>
						</Button>
						<Border Width="2" Background="#50888888" Margin="3,3" CornerRadius="1"/>
						<Button ToolTip.Tip="Solid line" Width="28" Height="22" Padding="0" Tag="Solid" Click="OnAnnotateDashPattern" BorderThickness="0">
							<Line StartPoint="2,11" EndPoint="26,11" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="2"/>
						</Button>
						<Button ToolTip.Tip="Dashed line" Width="28" Height="22" Padding="0" Tag="Dashed" Click="OnAnnotateDashPattern" BorderThickness="0">
							<Line StartPoint="2,11" EndPoint="26,11" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="2" StrokeDashArray="4,3"/>
						</Button>
						<Button ToolTip.Tip="Dotted line" Width="28" Height="22" Padding="0" Tag="Dotted" Click="OnAnnotateDashPattern" BorderThickness="0">
							<Line StartPoint="2,11" EndPoint="26,11" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="2" StrokeDashArray="1,2"/>
						</Button>
						<Button ToolTip.Tip="Dash-dot line" Width="28" Height="22" Padding="0" Tag="DashDot" Click="OnAnnotateDashPattern" BorderThickness="0">
							<Line StartPoint="2,11" EndPoint="26,11" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="2" StrokeDashArray="4,2,1,2"/>
						</Button>
						<Border Width="2" Background="#50888888" Margin="3,3" CornerRadius="1"/>
						<Slider Name="OpacitySlider" ToolTip.Tip="Opacity" Minimum="0.1" Maximum="1" Value="1" Width="70"
							VerticalAlignment="Top" Padding="0" Height="35" Margin="0,-10,0,0"/>
						<Button ToolTip.Tip="Decrease font size (−)" Width="18" Height="18" Padding="0" MinWidth="0" MinHeight="0" Click="OnFontSizeDecrease" BorderThickness="0" FontSize="12" Content="−"/>
						<TextBlock Name="FontSizeLabel" Text="10pt" FontSize="12" VerticalAlignment="Center" Margin="2,0"
							ToolTip.Tip="Text font size (−/+ to adjust)" Opacity="0.6"/>
						<Button ToolTip.Tip="Increase font size (+)" Width="18" Height="18" Padding="0" MinWidth="0" MinHeight="0" Click="OnFontSizeIncrease" BorderThickness="0" FontSize="12" Content="+"/>
						<Border Width="2" Background="#50888888" Margin="3,3" CornerRadius="1"/>
						<Button ToolTip.Tip="Calibrate measurement scale" Width="22" Height="22" Padding="0" Click="OnMeasureCalibrate" BorderThickness="0">
							<ic:SymbolIcon Symbol="Options" IconVariant="Regular" FontSize="12"/>
						</Button>
					</StackPanel>
				</StackPanel>
			</Border>

			<!-- Diff toolbar: floating overlay at bottom of preview, separate from annotation toolbar -->
			<Border Name="DiffToolbar" IsVisible="{Binding PreviewVM.DiffOverlayActive}" IsHitTestVisible="True"
					HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6"
					Background="{DynamicResource TextControlBackground}" CornerRadius="6"
					Padding="6,3" Opacity="0.92"
					BoxShadow="0 1 4 0 #40000000">
				<StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
					<!-- Mode buttons — radio-style (OneWay + Click ensures one is always selected) -->
					<ToggleButton ToolTip.Tip="Overlay — red highlights on current page (requires comparison)" Height="30" Width="30" Padding="0" IsChecked="{Binding PreviewVM.IsOverlayMode, Mode=OneWay}" Click="OnDiffModeOverlay" IsEnabled="{Binding PreviewVM.HasDiffResults}">
						<ic:SymbolIcon Symbol="Layer" IconVariant="Regular" FontSize="16"/>
					</ToggleButton>
					<ToggleButton ToolTip.Tip="A/B Toggle — swap between original and revised" Height="30" Width="30" Padding="0" IsChecked="{Binding PreviewVM.IsToggleMode, Mode=OneWay}" Click="OnDiffModeToggle">
						<ic:SymbolIcon Symbol="ArrowSwap" IconVariant="Regular" FontSize="16"/>
					</ToggleButton>
					<ToggleButton ToolTip.Tip="Side-by-side comparison" Height="30" Width="30" Padding="0" IsChecked="{Binding PreviewVM.IsSideBySideMode, Mode=OneWay}" Click="OnDiffModeSBS">
						<ic:SymbolIcon Symbol="SplitHorizontal" IconVariant="Regular" FontSize="16"/>
					</ToggleButton>

					<Border Width="1" Height="16" Background="{DynamicResource TextControlBorderBrush}" Margin="2,0"/>

					<!-- A/B switch (only in Toggle mode) -->
					<ToggleButton Name="DiffABToggle" Height="30" MinWidth="30" Padding="4,0"
								  IsChecked="{Binding PreviewVM.DiffShowingOriginal, Mode=TwoWay}"
								  IsVisible="{Binding PreviewVM.ShowDiffToggle}"
								  ToolTip.Tip="Toggle A/B (Ctrl+Shift+T)"
								  VerticalAlignment="Center" Margin="2,0">
						<StackPanel Orientation="Horizontal" Spacing="4">
							<ic:SymbolIcon Symbol="ArrowSwap" IconVariant="Regular" FontSize="14"/>
							<TextBlock Name="DiffABLabel" Text="B" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
						</StackPanel>
					</ToggleButton>

					<TextBlock Text="{Binding PreviewVM.DiffSummary}" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>

					<Border Width="1" Height="16" Background="{DynamicResource TextControlBorderBrush}" Margin="2,0"/>

					<!-- Run pixel comparison -->
					<Button ToolTip.Tip="Run pixel comparison" Height="30" Padding="8,0" BorderThickness="0" Click="OnRunDiffComparison" IsEnabled="{Binding !PreviewVM.DiffBusy}">
						<StackPanel Orientation="Horizontal" Spacing="4">
							<ic:SymbolIcon Symbol="ScanDash" IconVariant="Regular" FontSize="16"/>
							<TextBlock Text="Compare" FontSize="11" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>

					<!-- Tolerance slider + Recompute (only when results exist) -->
					<Border Width="1" Height="16" Background="{DynamicResource TextControlBorderBrush}" Margin="2,0" IsVisible="{Binding PreviewVM.HasDiffResults}"/>
					<TextBlock Text="Tolerance" FontSize="10" Opacity="0.6" VerticalAlignment="Center" IsVisible="{Binding PreviewVM.HasDiffResults}"/>
					<Slider Width="80" Height="35" Minimum="0" Maximum="1000" Value="{Binding PreviewVM.DiffTolerance}" TickFrequency="50" IsSnapToTickEnabled="False" VerticalAlignment="Top" Margin="0,-10,0,0" IsVisible="{Binding PreviewVM.HasDiffResults}"/>
					<TextBlock Text="{Binding PreviewVM.DiffTolerance}" FontSize="10" Width="28" Opacity="0.6" VerticalAlignment="Center" IsVisible="{Binding PreviewVM.HasDiffResults}"/>
					<Button ToolTip.Tip="Recompute diff with current tolerance" Height="30" Width="30" Padding="0" BorderThickness="0" Click="OnDiffRerun" IsEnabled="{Binding PreviewVM.CanRerunDiff}" IsVisible="{Binding PreviewVM.HasDiffResults}">
						<ic:SymbolIcon Symbol="ArrowSync" IconVariant="Regular" FontSize="16"/>
					</Button>

					<Border Width="1" Height="16" Background="{DynamicResource TextControlBorderBrush}" Margin="2,0" IsVisible="{Binding PreviewVM.HasDiffResults}"/>

					<Button ToolTip.Tip="Save diff as annotation layer" Height="30" Width="30" Padding="0" BorderThickness="0" Click="OnDiffSaveAsLayer" IsVisible="{Binding PreviewVM.HasDiffResults}">
						<ic:SymbolIcon Symbol="Save" IconVariant="Regular" FontSize="16"/>
					</Button>
				</StackPanel>
			</Border>

			<!-- Text input overlay
				 Clicking the canvas background (outside the border) auto-commits. -->
			<Canvas Name="TextInputCanvas" IsVisible="False" IsHitTestVisible="True" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
					PointerPressed="OnTextInputBackgroundClick">
				<Border Name="TextInputBorder" Background="{DynamicResource TextControlBackground}" CornerRadius="4" Padding="8" BoxShadow="0 1 4 0 #40000000">
					<TextBox Name="TextInputBox" Width="220" MinHeight="50" AcceptsReturn="True" TextWrapping="Wrap"/>
				</Border>
			</Canvas>

			<!-- Calibration input overlay -->
			<Canvas Name="CalibrationCanvas" IsVisible="False" IsHitTestVisible="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
				<Border Name="CalibrationBorder" Background="{DynamicResource TextControlBackground}" CornerRadius="4" Padding="8" BoxShadow="0 1 4 0 #40000000">
					<StackPanel Spacing="6">
						<TextBlock Name="CalibrationPromptText" Text="Enter real-world distance for the last measurement:" FontSize="12" TextWrapping="Wrap" MaxWidth="220"/>
						<StackPanel Orientation="Horizontal" Spacing="4">
							<TextBox Name="CalibrationValueBox" Width="120" Watermark="e.g. 210" KeyDown="OnCalibrationKeyDown"/>
							<TextBlock Text="mm" VerticalAlignment="Center" FontSize="12"/>
						</StackPanel>
						<StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
							<Button Content="Apply" Click="OnCalibrationApply" Padding="8,2" FontSize="11"/>
							<Button Content="Cancel" Click="OnCalibrationCancel" Padding="8,2" FontSize="11"/>
						</StackPanel>
					</StackPanel>
				</Border>
			</Canvas>

			<!-- Color input overlay -->
				<Canvas Name="ColorInputCanvas" IsVisible="False" IsHitTestVisible="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
					<Border Background="{DynamicResource TextControlBackground}" CornerRadius="4" Padding="8" BoxShadow="0 1 4 0 #40000000"
							Canvas.Left="80" Canvas.Top="40">
						<StackPanel Spacing="6">
							<TextBlock Text="Enter hex color:" FontSize="12"/>
							<TextBox Name="ColorInputBox" Width="120" Watermark="#FF6600" KeyDown="OnColorInputKeyDown"/>
							<StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
								<Button Content="Apply" Click="OnColorInputApply" Padding="8,2" FontSize="11"/>
								<Button Content="Cancel" Click="OnColorInputCancel" Padding="8,2" FontSize="11"/>
							</StackPanel>
						</StackPanel>
					</Border>
				</Canvas>

				<!-- Review export name overlay -->
					<Grid Name="ReviewExportCanvas" IsVisible="False" IsHitTestVisible="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
						<Border Background="{DynamicResource TextControlBackground}" CornerRadius="4" Padding="8" BoxShadow="0 1 4 0 #40000000"
								HorizontalAlignment="Center" VerticalAlignment="Center">
							<StackPanel Spacing="6">
								<TextBlock Text="Enter review name:" FontSize="12"/>
								<TextBox Name="ReviewNameBox" Width="180" Watermark="e.g. Draft review" KeyDown="OnReviewNameKeyDown"/>
								<TextBlock Name="ReviewExportStatus" Text="" FontSize="10" Opacity="0.6" TextWrapping="Wrap" MaxWidth="260"/>
								<StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
									<Button Content="Export" Click="OnReviewExportConfirm" Padding="8,2" FontSize="11"/>
									<Button Content="Cancel" Click="OnReviewExportCancel" Padding="8,2" FontSize="11"/>
								</StackPanel>
							</StackPanel>
						</Border>
					</Grid>
				</Grid>

		<Grid Name="SearchGrid" MinWidth="0" Grid.Column="1" ClipToBounds="False" Width="200" IsVisible="{Binding PreviewVM.SearchMode}">
			<Border Name="SearchGridBorder" Classes="shadow" Grid.Row="0" Margin="5" Background="{DynamicResource TextControlBackground}">
				<Grid RowDefinitions="10,Auto,30,*">

					<!-- Text search input (hidden during diff page list mode) -->
					<Border Grid.Row="1" Width="170" HorizontalAlignment="Center" FlowDirection="LeftToRight"
							IsVisible="{Binding !PreviewVM.DiffPageListMode}">
						<Grid ColumnDefinitions="*,30,30" Margin="-5 0 -5 0">
							<Border Grid.Column="0" Classes="shadow">
								<TextBox Watermark="Search text..." Name="SearchRegex" KeyDown="OnStartSearhRegex"/>
							</Border>
							<Button Grid.Column="1" Margin="0" Click="OnSeachRegex" BorderThickness="0" IsEnabled="{Binding !PreviewVM.SearchBusy}">
								<ic:SymbolIcon Symbol="Search" IconVariant="Regular" FontSize="16"/>
							</Button>
							<Button Grid.Column="2" Margin="0" Click="OnClearSearch" BorderThickness="0">
								<ic:SymbolIcon Symbol="Dismiss" IconVariant="Regular" FontSize="16"/>
							</Button>
						</Grid>
					</Border>

					<!-- Diff page list header (shown during diff page list mode) -->
					<Border Grid.Row="1" IsVisible="{Binding PreviewVM.DiffPageListMode}" Padding="8,6">
						<StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
							<ic:SymbolIcon Symbol="DocumentPageBreak" IconVariant="Regular" FontSize="14" Opacity="0.7"/>
							<TextBlock Text="Changed Pages" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
						</StackPanel>
					</Border>

					<Border Grid.Row="2" BorderThickness="0 0 0 1" CornerRadius="0" BorderBrush="{DynamicResource DataGridGridLinesBrush}">
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
							<Button ToolTip.Tip="Previous Result" ToolTip.Placement="Right" BorderThickness="0" Theme="{DynamicResource MaterialButtonBase}" Command="{Binding PreviewVM.PrevSearchPage}">
								<ic:SymbolIcon Symbol="ArrowPrevious" IconVariant="Regular" FontSize="16"/>
							</Button>

							<Button ToolTip.Tip="Next Result" ToolTip.Placement="Right" BorderThickness="0" Theme="{DynamicResource MaterialButtonBase}" Command="{Binding PreviewVM.NextSearchPage}">
								<ic:SymbolIcon Symbol="ArrowNext" IconVariant="Regular" FontSize="16"/>
							</Button>

							<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
								<Label Content="{Binding PreviewVM.SearchPageIndex, Converter={StaticResource AddOneConverter}}" VerticalAlignment="Center"/>
								<Label Content="/" VerticalAlignment="Center"/>
								<Label Content="{Binding PreviewVM.SearchItems}" VerticalAlignment="Center"/>
							</StackPanel>
						</StackPanel>
					</Border>

					<ListBox Grid.Row="3" ItemsSource="{Binding PreviewVM.SearchPagesText}" Background="Transparent" SelectedIndex="{Binding PreviewVM.SearchPageIndex}" FontSize="13">
						<ListBox.Styles>
							<Style Selector="ListBoxItem">
								<Setter Property="Height" Value="25"/>
								<Setter Property="Padding" Value="10 0 0 0"/>
								<Setter Property="VerticalContentAlignment" Value="Center"/>
							</Style>
						</ListBox.Styles>
					</ListBox>

				</Grid>
			</Border>
		</Grid>

		<Grid ColumnDefinitions="*,Auto,*" Grid.Row="1" Grid.ColumnSpan="2">
			<Border Classes="shadow" Grid.Column="1" Background="{DynamicResource TextControlBackground}" Margin="5" Padding="4,0">
				<StackPanel FlowDirection="LeftToRight" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" Margin="10 0 10 0" DataContext="{Binding PreviewVM}">
                   
					<Slider Name="ScrollSlider" FlowDirection="LeftToRight" Width="200" Height="35" Margin="0 -10 0 0" Minimum="1" IsSnapToTickEnabled="True" VerticalAlignment="Top"
                            TickFrequency="1" Maximum="{Binding Pagecount}" Value="{Binding RequestPage1, Mode=OneWay, Converter={StaticResource AddOneConverter}}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
						<Label Content="{Binding CurrentPage1, Converter={StaticResource AddOneConverter}}" Width="40" HorizontalContentAlignment="Right" VerticalAlignment="Center"/>
						<Label Content="/" VerticalAlignment="Center"/>
						<Label Content="{Binding Pagecount}" VerticalAlignment="Center"/>
					</StackPanel>

					<Button ToolTip.Tip="Previous Page (Left)" FontWeight="Normal" ToolTip.Placement="Right" BorderThickness="0" Command="{Binding PrevPage}" CommandParameter="false">
						<ic:SymbolIcon Symbol="ArrowPrevious" IconVariant="Regular" FontSize="16"/>
					</Button>

					<Button ToolTip.Tip="Next Page (Right)" FontWeight="Normal" ToolTip.Placement="Right" BorderThickness="0" Command="{Binding NextPage}" CommandParameter="false">
							<ic:SymbolIcon Symbol="ArrowNext" IconVariant="Regular" FontSize="16"/>
						</Button>

						<Border Width="1" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Margin="4,6" Opacity="0.5"/>

						<Button ToolTip.Tip="Rotate Left" FontWeight="Normal" ToolTip.Placement="Right" BorderThickness="0" Click="RotateLeft">
							<ic:SymbolIcon Symbol="RotateLeft" IconVariant="Regular" FontSize="16"/>
						</Button>

						<Button ToolTip.Tip="Rotate Right" FontWeight="Normal" ToolTip.Placement="Right" BorderThickness="0" Click="RotateRight">
							<ic:SymbolIcon Symbol="RotateRight" IconVariant="Regular" FontSize="16"/>
						</Button>

						<Border Width="1" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Margin="4,6" Opacity="0.5"/>

						<ToggleButton ToolTip.Tip="Fast Open" IsChecked="{Binding FastOpenMode, Mode=TwoWay}" Width="30" Height="30">
							<ic:SymbolIcon Symbol="Rocket" IconVariant="Regular" FontSize="16"/>
						</ToggleButton>

						<ToggleButton ToolTip.Tip="Invert Colors (Ctrl+G)" Width="30" Height="30" FontWeight="Normal" Name="DimmedMode" IsChecked="{Binding DarkMode}" ToolTip.Placement="Right">
							<ic:SymbolIcon Symbol="DarkTheme" IconVariant="Regular" FontSize="16"/>
						</ToggleButton>

						<ToggleButton ToolTip.Tip="Dual Page (Ctrl+D)" Width="30" Height="30" FontWeight="Normal" ToolTip.Placement="Right" Name="DualMode" IsChecked="{Binding TwopageMode}" IsVisible="{Binding !DualFileMode}" IsEnabled="{Binding CanToggleLayout}">
							<ic:SymbolIcon Symbol="BookOpen" IconVariant="Regular" FontSize="16"/>
						</ToggleButton>

						<ToggleButton ToolTip.Tip="Dual File" Width="30" Height="30" FontWeight="Normal" ToolTip.Placement="Right" IsChecked="{Binding DualFileMode}" IsEnabled="{Binding CanToggleLayout}">
							<ic:SymbolIcon Symbol="BookAdd" IconVariant="Regular" FontSize="16"/>
						</ToggleButton>

						<ToggleButton ToolTip.Tip="Linked Pages (Ctrl+L)" Width="30" Height="30" FontWeight="Normal" ToolTip.Placement="Right" Name="LinkedPageMode" IsVisible="{Binding ShowLinkedPageButton}" IsChecked="{Binding LinkedPageMode}">
							<ic:SymbolIcon Symbol="Link" IconVariant="Regular" FontSize="16"/>
						</ToggleButton>

						<Border Width="1" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Margin="4,6" Opacity="0.5"/>

						<ToggleButton ToolTip.Tip="Search (Ctrl+F)" Width="30" Height="30" FontWeight="Normal" ToolTip.Placement="Right" Name="SearchMode" IsChecked="{Binding SearchMode}" IsEnabled="{Binding CanSearch}">
							<ic:SymbolIcon Symbol="Search" IconVariant="Regular" FontSize="16"/>
						</ToggleButton>

						<ToggleButton Name="AnnotateToggle" ToolTip.Tip="Annotate (Esc to exit)" Width="30" Height="30" FontWeight="Normal" ToolTip.Placement="Right" Click="OnToggleAnnotate" IsEnabled="{Binding CanAnnotate}">
							<ic:SymbolIcon Symbol="Pen" IconVariant="Regular" FontSize="16"/>
						</ToggleButton>

						<ToggleButton Name="DiffOverlayToggle" ToolTip.Tip="Show Diff Overlay" Width="30" Height="30" FontWeight="Normal" ToolTip.Placement="Right" IsChecked="{Binding DiffOverlayActive}" IsVisible="{Binding HasDiffResults}">
							<ic:SymbolIcon Symbol="DocumentPageBreak" IconVariant="Regular" FontSize="16"/>
						</ToggleButton>

						<Button Name="CompareVersionsBtn" ToolTip.Tip="Compare Versions" Width="30" Height="30" FontWeight="Normal" ToolTip.Placement="Right" BorderThickness="0" Click="OnOpenVersionCompareDialog" IsVisible="{Binding CanCompareVersions}">
							<ic:SymbolIcon Symbol="ArrowSwap" IconVariant="Regular" FontSize="16"/>
						</Button>

					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10 0 5 0" IsVisible="False">
						<ic:SymbolIcon Symbol="Checkmark" IconVariant="Regular" FontSize="16" IsVisible="{Binding !FileWorkerBusy}"/>
						<ic:SymbolIcon Symbol="ArrowClockwise" IconVariant="Regular" FontSize="16" IsVisible="{Binding FileWorkerBusy}"/>
					</StackPanel>
			
					<Slider Name="ScrollSliderSecondary" FlowDirection="LeftToRight" Width="200" Height="35" Margin="0 -10 0 0" Minimum="1" IsSnapToTickEnabled="True" VerticalAlignment="Top"
						TickFrequency="1" Maximum="{Binding SecondaryPagecount}" IsVisible="{Binding ShowSecondaryControls}" Value="{Binding RequestPage2, Mode=OneWay, Converter={StaticResource AddOneConverter}}"/>
			
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" IsVisible="{Binding ShowSecondaryControls}">
						<Label Content="{Binding CurrentPage2, Converter={StaticResource AddOneConverter}}" Width="40" HorizontalContentAlignment="Right" VerticalAlignment="Center"/>
						<Label Content="/" VerticalAlignment="Center"/>
						<Label Content="{Binding SecondaryPagecount}" VerticalAlignment="Center"/>
					</StackPanel>

					<Button FontWeight="Normal" BorderThickness="0" IsVisible="{Binding ShowSecondaryControls}" Command="{Binding PrevPage}" CommandParameter="true">
						<ic:SymbolIcon Symbol="ArrowPrevious" IconVariant="Regular" FontSize="16"/>
					</Button>

					<Button FontWeight="Normal" BorderThickness="0" IsVisible="{Binding ShowSecondaryControls}" Command="{Binding NextPage}" CommandParameter="true">
						<ic:SymbolIcon Symbol="ArrowNext" IconVariant="Regular" FontSize="16"/>
					</Button>

				</StackPanel>
			</Border>
		</Grid>
			</Grid>

		</UserControl>
