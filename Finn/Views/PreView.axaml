<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Finn.ViewModels"
			 xmlns:mupdf="clr-namespace:MuPDFCore.MuPDFRenderer;assembly=MuPDFCore.MuPDFRenderer"
			 xmlns:ic="using:FluentIcons.Avalonia" 
			 xmlns:converter="clr-namespace:Finn.Converters"
			 xmlns:ctrl="clr-namespace:Finn.Controls"
			 xmlns:model="clr-namespace:Finn.Model"
						 mc:Ignorable="d"
             x:DataType="vm:MainViewModel"
             x:Class="Finn.Views.PreView">
	
	<UserControl.Resources>
		<converter:AddOneConverter x:Key="AddOneConverter"/>
		<converter:GridDefConverter x:Key="GridDefConverter"/>
	</UserControl.Resources>

	<UserControl.KeyBindings>
		<KeyBinding Gesture="Ctrl+F"       Command="{Binding PreviewVM.ToggleSearchModeCommand}"/>
		<KeyBinding Gesture="Ctrl+G"       Command="{Binding PreviewVM.ToggleDarkModeCommand}"/>
		<KeyBinding Gesture="Ctrl+D"       Command="{Binding PreviewVM.ToggleTwoPageModeCommand}"/>
		<KeyBinding Gesture="Ctrl+L"       Command="{Binding PreviewVM.ToggleLinkedPageModeCommand}"/>
		<KeyBinding Gesture="Ctrl+Shift+T" Command="{Binding PreviewVM.ToggleDiffOriginalCommand}"/>
		<KeyBinding Gesture="Left"         Command="{Binding PreviewVM.PrevPageCommand}"/>
		<KeyBinding Gesture="Right"        Command="{Binding PreviewVM.NextPageCommand}"/>
	</UserControl.KeyBindings>

	<UserControl.Styles>
		<Style Selector="Slider#OpacitySlider /template/ Thumb">
			<Setter Property="Width" Value="12"/>
			<Setter Property="Height" Value="12"/>
		</Style>
		<!-- All buttons inside the annotation toolbar and search panel are ghost-style -->
		<Style Selector="Border#AnnotateToolbar Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
		</Style>
		<Style Selector="Border#AnnotateToolbar Button:pointerover">
			<Setter Property="Background" Value="{DynamicResource AppMenuHoverBrush}"/>
		</Style>
		<Style Selector="Border#SearchGridBorder Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
		</Style>
		<Style Selector="Border#SearchGridBorder Button:pointerover">
			<Setter Property="Background" Value="{DynamicResource AppMenuHoverBrush}"/>
		</Style>
	</UserControl.Styles>

	<Grid Name="MainPreviewGrid" RowDefinitions="*,44" ColumnDefinitions="*,Auto" Margin="0">
		<Grid Name="PreviewGrid" ClipToBounds="True" ColumnDefinitions="*" RowDefinitions="*"
	  Grid.Row="0" Grid.Column="0"
	  Background="{Binding PreviewVM.PreviewBackground}">

			<LayoutTransformControl Name="Tester">
				<LayoutTransformControl.LayoutTransform>
					<RotateTransform Angle="{Binding PreviewVM.Rotation}"/>
				</LayoutTransformControl.LayoutTransform>

				<Grid Name="ViewArea" Grid.Column="1" Grid.Row="0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="5"/>
						<ColumnDefinition Width="{Binding PreviewVM.TwopageMode, Converter={StaticResource GridDefConverter}}"/>
					</Grid.ColumnDefinitions>

					 <ctrl:AnnotatedPDFRenderer Name="MuPDFRenderer" Grid.Column="0" Background="Transparent" PageBackground="{Binding PreviewVM.LightPaperColor}"
						ZoomEnabled="False" PointerWheelChanged="ModifiedControlPointerWheelChanged"
						ZoomIncrement="1.2" ClipToBounds="True" PointerEventHandlersType="PanHighlight" Focusable="True">
								 <ctrl:AnnotatedPDFRenderer.ContextMenu>
									 <ContextMenu>
										 <MenuItem Header="Copy" Command="{Binding PreviewVM.CopyToClipboard}" CommandParameter="{Binding $parent[Window]}">
											 <MenuItem.Icon><ic:SymbolIcon Symbol="Clipboard"/></MenuItem.Icon>
										 </MenuItem>
									 </ContextMenu>
								 </ctrl:AnnotatedPDFRenderer.ContextMenu>
							 </ctrl:AnnotatedPDFRenderer>

					<!-- Gap fill: in dark mode the renderers invert PreviewBackground
						 via the Skia pipeline, but the 5px gap column is not inverted.
						 This border covers the gap with the post-inversion theme color
						 so the strip matches the renderer backgrounds. -->
					<Border Grid.Column="1" Background="{Binding PreviewVM.UiBackground}"
							IsVisible="{Binding PreviewVM.DarkMode}" IsHitTestVisible="False"/>

					<ctrl:AnnotatedPDFRenderer Name="MuPDFRendererSecondary" Grid.Column="2" Background="Transparent" PageBackground="{Binding PreviewVM.LightPaperColor}"
						ZoomEnabled="False" PointerWheelChanged="ModifiedControlPointerWheelChanged"
						ZoomIncrement="1.2" ClipToBounds="True" PointerEventHandlersType="PanHighlight" IsVisible="False"
						MinWidth="1" MinHeight="1">
						<ctrl:AnnotatedPDFRenderer.ContextMenu>
							<ContextMenu>
								<MenuItem Header="Copy" Command="{Binding PreviewVM.CopyToClipboard}" CommandParameter="{Binding $parent[Window]}">
									<MenuItem.Icon><ic:SymbolIcon Symbol="Clipboard"/></MenuItem.Icon>
								</MenuItem>
							</ContextMenu>
						</ctrl:AnnotatedPDFRenderer.ContextMenu>
					</ctrl:AnnotatedPDFRenderer>

					<!-- Loading overlay shown while previewer is busy -->
						<Border Grid.ColumnSpan="3" Classes="shadow" IsVisible="{Binding PreviewVM.FileWorkerBusy}"
								HorizontalAlignment="Center" VerticalAlignment="Center"
								IsHitTestVisible="True">
							<Border Classes="clip-inner" Padding="24,16">
								<StackPanel HorizontalAlignment="Center" Spacing="8">
									<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
										<ic:SymbolIcon Symbol="ArrowClockwise" FontSize="16" Opacity="0.7"/>
										<TextBlock Text="{Binding PreviewVM.StatusMessage}" FontSize="13" VerticalAlignment="Center"/>
									</StackPanel>
									<!-- Indeterminate when Progress is 0 (file open); determinate when caching -->
									<ProgressBar Width="200" Height="4" Minimum="0" Maximum="100"
												 Value="{Binding PreviewVM.Progress}"
												 IsIndeterminate="{Binding PreviewVM.IsProgressIndeterminate}"/>
									<Button Content="Cancel" Click="OnCancelFileLoad" Padding="16,3" HorizontalAlignment="Center"
											Background="Transparent" FontSize="12"
											BorderThickness="1" CornerRadius="{DynamicResource AppCornerRadius}"/>
								</StackPanel>
							</Border>
						</Border>
				</Grid>
			</LayoutTransformControl>

			<!-- Mode banner: Dual File (only for user-initiated, not diff side-by-side) -->
			<Border Name="DualFileBanner" Classes="shadow" IsVisible="{Binding PreviewVM.IsUserDualFileMode}" IsHitTestVisible="True"
					HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0">
				<Border Classes="clip-inner" Padding="10,6">
				<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
					<ic:SymbolIcon Symbol="BookAdd" IconVariant="Regular" FontSize="14" Opacity="0.7"/>
					<TextBlock Text="Dual File — use View Left / Right to set files" FontSize="11" VerticalAlignment="Center" Opacity="0.7"/>
					<Button Padding="6,3" MinWidth="0" MinHeight="0"
							ToolTip.Tip="Exit Dual File mode (Esc)" Click="OnCloseDualFileMode"
							Background="{DynamicResource AppControlSurfaceBrush}"
							BorderThickness="1" BorderBrush="{DynamicResource AppControlBorderBrush}"
							CornerRadius="4">
						<StackPanel Orientation="Horizontal" Spacing="5">
							<ic:SymbolIcon Symbol="Dismiss" FontSize="11"/>
							<TextBlock Text="Exit" FontSize="11" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
				</StackPanel>
				</Border>
			</Border>

			<!-- Mode banner: Version Preview -->
			<Border Name="VersionBanner" Classes="shadow" IsVisible="{Binding PreviewVM.IsViewingVersion}" IsHitTestVisible="True"
					HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0">
				<Border Classes="clip-inner" Padding="10,6">
				<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
					<ic:SymbolIcon Symbol="History" IconVariant="Regular" FontSize="14" Opacity="0.7"/>
					<TextBlock Text="Viewing version" FontSize="11" VerticalAlignment="Center" Opacity="0.7"/>
					<Button Padding="6,3" MinWidth="0" MinHeight="0"
							ToolTip.Tip="Return to original file (Esc)" Click="OnReturnToOriginal"
							Background="{DynamicResource AppControlSurfaceBrush}"
							BorderThickness="1" BorderBrush="{DynamicResource AppControlBorderBrush}"
							CornerRadius="4">
						<StackPanel Orientation="Horizontal" Spacing="5">
							<ic:SymbolIcon Symbol="Dismiss" FontSize="11"/>
							<TextBlock Text="Return" FontSize="11" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
				</StackPanel>
				</Border>
			</Border>

			<!-- Mode banner: Diff Comparison -->
			<Border Name="DiffModeBanner" Classes="shadow" IsVisible="{Binding PreviewVM.DiffOverlayActive}" IsHitTestVisible="True"
					HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0">
				<Border Classes="clip-inner" Padding="10,6">
				<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
					<ic:SymbolIcon Symbol="DocumentPageBreak" IconVariant="Regular" FontSize="14" Opacity="0.7"/>
					<TextBlock Text="{Binding PreviewVM.DiffSummary}" FontSize="11" VerticalAlignment="Center" Opacity="0.7"/>
					<Button Padding="6,3" MinWidth="0" MinHeight="0"
							ToolTip.Tip="Close diff comparison (Esc)" Click="OnCloseDiffMode"
							Background="{DynamicResource AppControlSurfaceBrush}"
							BorderThickness="1" BorderBrush="{DynamicResource AppControlBorderBrush}"
							CornerRadius="4">
						<StackPanel Orientation="Horizontal" Spacing="5">
							<ic:SymbolIcon Symbol="Dismiss" FontSize="11"/>
							<TextBlock Text="Exit" FontSize="11" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
				</StackPanel>
				</Border>
			</Border>

			<!-- Mode banner: Screenshot capture -->
			<Border Name="ScreenshotModeBanner" Classes="shadow" IsVisible="False" IsHitTestVisible="True"
					HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0">
				<Border Classes="clip-inner" Padding="10,6">
				<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
					<ic:SymbolIcon Symbol="Screenshot" IconVariant="Regular" FontSize="14" Opacity="0.7"/>
					<TextBlock Text="Drag to capture — Esc to cancel" FontSize="11" VerticalAlignment="Center" Opacity="0.7"/>
					<Button Padding="6,3" MinWidth="0" MinHeight="0"
							ToolTip.Tip="Cancel screenshot (Esc)" Click="OnScreenshotToolClick"
							Background="{DynamicResource AppControlSurfaceBrush}"
							BorderThickness="1" BorderBrush="{DynamicResource AppControlBorderBrush}"
							CornerRadius="4">
						<StackPanel Orientation="Horizontal" Spacing="5">
							<ic:SymbolIcon Symbol="Dismiss" FontSize="11"/>
							<TextBlock Text="Cancel" FontSize="11" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
				</StackPanel>
				</Border>
			</Border>

			<!-- Annotation toolbar + status hint: stacked vertically at top of preview -->
			<StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0" Spacing="4">
			<Border Name="AnnotateToolbar" Classes="shadow" IsVisible="False" IsHitTestVisible="True"
								HorizontalAlignment="Center" Padding="4,2">
				<Border.Background>
					<SolidColorBrush Color="{DynamicResource SystemRegionColor}"/>
				</Border.Background>
				<Border.Resources>
					<ControlTheme x:Key="OverlayFlyout" TargetType="FlyoutPresenter" BasedOn="{StaticResource {x:Type FlyoutPresenter}}">
						<Setter Property="Background" Value="Transparent"/>
						<Setter Property="BorderThickness" Value="0"/>
						<Setter Property="Padding" Value="0"/>
						<Setter Property="MinWidth" Value="0"/>
						<Setter Property="MinHeight" Value="0"/>
						<Setter Property="CornerRadius" Value="0"/>
					</ControlTheme>
				</Border.Resources>
				<Border Background="{DynamicResource AppFlyoutSurfaceBrush}" Margin="-4,-2" Padding="4,2"
						CornerRadius="{DynamicResource AppCornerRadius}" ClipToBounds="True">
					   <Grid RowDefinitions="Auto,Auto">
							<!-- Row 0: Drawing Tools -->
							<StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="1" HorizontalAlignment="Center">
								<Button ToolTip.Tip="Select / Move (V)" Width="26" Height="26" Padding="0" Tag="Select" Click="OnAnnotateToolSelect" BorderThickness="0">
									<ic:SymbolIcon Symbol="Cursor" IconVariant="Regular" FontSize="14"/>
								</Button>
								<Border Width="2" Background="{DynamicResource AppToolbarSeparatorBrush}" Margin="3,4" CornerRadius="1" Opacity="0.7"/>
								<Button ToolTip.Tip="Draw (1)" Width="26" Height="26" Padding="0" Tag="Draw" Click="OnAnnotateToolSelect" BorderThickness="0">
									<ic:SymbolIcon Symbol="Pen" IconVariant="Regular" FontSize="14"/>
								</Button>
								<Button ToolTip.Tip="Highlight (2)" Width="26" Height="26" Padding="0" Tag="Highlight" Click="OnAnnotateToolSelect" BorderThickness="0">
									<ic:SymbolIcon Symbol="Highlight" IconVariant="Regular" FontSize="14"/>
								</Button>
								<Button ToolTip.Tip="Polyline (P)" Width="26" Height="26" Padding="0" Tag="Polyline" Click="OnAnnotateToolSelect" BorderThickness="0">
									<ic:SymbolIcon Symbol="Flowchart" IconVariant="Regular" FontSize="14"/>
								</Button>
								<Button ToolTip.Tip="Dot (D)" Width="26" Height="26" Padding="0" Tag="Dot" Click="OnAnnotateToolSelect" BorderThickness="0">
									<Ellipse Width="8" Height="8" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
								</Button>
								<Border Width="2" Background="{DynamicResource AppToolbarSeparatorBrush}" Margin="3,4" CornerRadius="1" Opacity="0.7"/>
								<Button ToolTip.Tip="Rectangle (3)" Width="26" Height="26" Padding="0" Tag="Rectangle" Click="OnAnnotateToolSelect" BorderThickness="0">
									<ic:SymbolIcon Symbol="Square" IconVariant="Regular" FontSize="14"/>
								</Button>
								<Button ToolTip.Tip="Ellipse (4)" Width="26" Height="26" Padding="0" Tag="Ellipse" Click="OnAnnotateToolSelect" BorderThickness="0">
									<ic:SymbolIcon Symbol="Circle" IconVariant="Regular" FontSize="14"/>
								</Button>
								<Button ToolTip.Tip="Line (5)" Width="26" Height="26" Padding="0" Tag="Line" Click="OnAnnotateToolSelect" BorderThickness="0">
									<ic:SymbolIcon Symbol="Line" IconVariant="Regular" FontSize="14"/>
								</Button>
								<Button ToolTip.Tip="Arrow (6)" Width="26" Height="26" Padding="0" Tag="Arrow" Click="OnAnnotateToolSelect" BorderThickness="0">
									<ic:SymbolIcon Symbol="ArrowRight" IconVariant="Regular" FontSize="14"/>
								</Button>
								<Button ToolTip.Tip="Revision Cloud" Width="26" Height="26" Padding="0" Tag="RevisionCloud" Click="OnAnnotateToolSelect" BorderThickness="0">
									<ic:SymbolIcon Symbol="Cloud" IconVariant="Regular" FontSize="14"/>
								</Button>
								<Border Width="2" Background="#50888888" Margin="3,4" CornerRadius="1"/>
								<Button ToolTip.Tip="Comment (7)" Width="26" Height="26" Padding="0" Tag="Text" Click="OnAnnotateToolSelect" BorderThickness="0">
									<ic:SymbolIcon Symbol="TextFont" IconVariant="Regular" FontSize="14"/>
								</Button>
								<Button ToolTip.Tip="Arrow Comment (8)" Width="26" Height="26" Padding="0" Tag="ArrowText" Click="OnAnnotateToolSelect" BorderThickness="0">
									<ic:SymbolIcon Symbol="TextDescription" IconVariant="Regular" FontSize="14"/>
								</Button>
								<Button ToolTip.Tip="Sticky Note" Width="26" Height="26" Padding="0" Tag="StickyNote" Click="OnAnnotateToolSelect" BorderThickness="0">
									<ic:SymbolIcon Symbol="Note" IconVariant="Regular" FontSize="14"/>
								</Button>
								<Border Width="2" Background="#50888888" Margin="3,4" CornerRadius="1"/>
								<Button ToolTip.Tip="Measure (9)" Width="26" Height="26" Padding="0" Tag="MeasureDistance" Click="OnAnnotateToolSelect" BorderThickness="0">
									<ic:SymbolIcon Symbol="Ruler" IconVariant="Regular" FontSize="14"/>
								</Button>
								<Button ToolTip.Tip="Area Measure (A)" Width="26" Height="26" Padding="0" Tag="MeasureArea" Click="OnAnnotateToolSelect" BorderThickness="0">
									<ic:SymbolIcon Symbol="SelectObject" IconVariant="Regular" FontSize="14"/>
								</Button>
								<Button ToolTip.Tip="Eraser (0)" Width="26" Height="26" Padding="0" Tag="Eraser" Click="OnAnnotateToolSelect" BorderThickness="0">
									<ic:SymbolIcon Symbol="Eraser" IconVariant="Regular" FontSize="14"/>
								</Button>
								<Border Width="2" Background="#50888888" Margin="3,4" CornerRadius="1"/>
                                <Button ToolTip.Tip="Start measurement calibration" Width="26" Height="26" Padding="0" Click="OnMeasureCalibrate" BorderThickness="0">
									<ic:SymbolIcon Symbol="Options" IconVariant="Regular" FontSize="14"/>
								</Button>
                                <Button Name="GridToggleBtn" ToolTip.Tip="Toggle snap to grid (G)" Width="26" Height="26" Padding="0" Click="OnToggleGrid" BorderThickness="0">
									<ic:SymbolIcon Symbol="Grid" IconVariant="Regular" FontSize="14"/>
								</Button>
                              <Button Name="StatusHintsToggleBtn" ToolTip.Tip="Toggle annotation status hints" Width="26" Height="26" Padding="0" Click="OnToggleStatusHints" BorderThickness="0">
									<ic:SymbolIcon Symbol="Info" IconVariant="Regular" FontSize="14"/>
								</Button>
							</StackPanel>

							<!-- Row 1: Properties & Actions -->
                         <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="1" HorizontalAlignment="Center">
								<!-- Color flyout -->
                               <Button Name="ColorFlyoutBtn" ToolTip.Tip="Open color palette" Width="26" Height="26" Padding="0" BorderThickness="0">
									<Button.Flyout>
										<Flyout Placement="Bottom" ShowMode="TransientWithDismissOnPointerMoveAway"
												FlyoutPresenterTheme="{StaticResource OverlayFlyout}">
											<Border Classes="shadow" Margin="0" MinHeight="0" Padding="6,4">
												<Border Background="{DynamicResource AppOverlaySurfaceBrush}" Margin="-6,-4" Padding="6,4">
													<StackPanel Orientation="Vertical" Spacing="2">
														<StackPanel Orientation="Horizontal" Spacing="2">
															<Button ToolTip.Tip="Red" Width="22" Height="22" Padding="0" MinWidth="0" MinHeight="0"
																Background="#D64045" Opacity="0.85" Tag="Red" Click="OnAnnotateColor" CornerRadius="11"/>
															<Button ToolTip.Tip="Blue" Width="22" Height="22" Padding="0" MinWidth="0" MinHeight="0"
																Background="#3B82D9" Opacity="0.85" Tag="Blue" Click="OnAnnotateColor" CornerRadius="11"/>
															<Button ToolTip.Tip="Green" Width="22" Height="22" Padding="0" MinWidth="0" MinHeight="0"
																Background="#3DA35F" Opacity="0.85" Tag="Green" Click="OnAnnotateColor" CornerRadius="11"/>
															<Button ToolTip.Tip="Black" Width="22" Height="22" Padding="0" MinWidth="0" MinHeight="0"
																Background="#222222" Opacity="0.85" Tag="Black" Click="OnAnnotateColor" CornerRadius="11"/>
															<Button ToolTip.Tip="Orange" Width="22" Height="22" Padding="0" MinWidth="0" MinHeight="0"
																Background="#E87D2F" Opacity="0.85" Tag="Orange" Click="OnAnnotateColor" CornerRadius="11"/>
														</StackPanel>
														<StackPanel Orientation="Horizontal" Spacing="2">
															<Button ToolTip.Tip="Purple" Width="22" Height="22" Padding="0" MinWidth="0" MinHeight="0"
																Background="#8B5CF6" Opacity="0.85" Tag="Purple" Click="OnAnnotateColor" CornerRadius="11"/>
															<Button ToolTip.Tip="Yellow" Width="22" Height="22" Padding="0" MinWidth="0" MinHeight="0"
																Background="#F5C332" Opacity="0.85" Tag="Yellow" Click="OnAnnotateColor" CornerRadius="11"/>
															<Button ToolTip.Tip="Teal" Width="22" Height="22" Padding="0" MinWidth="0" MinHeight="0"
																Background="#26A69A" Opacity="0.85" Tag="Teal" Click="OnAnnotateColor" CornerRadius="11"/>
															<Button ToolTip.Tip="Pink" Width="22" Height="22" Padding="0" MinWidth="0" MinHeight="0"
																Background="#EC407A" Opacity="0.85" Tag="Pink" Click="OnAnnotateColor" CornerRadius="11"/>
															<Button ToolTip.Tip="Brown" Width="22" Height="22" Padding="0" MinWidth="0" MinHeight="0"
																Background="#8D6E63" Opacity="0.85" Tag="Brown" Click="OnAnnotateColor" CornerRadius="11"/>
														</StackPanel>
														<Button ToolTip.Tip="Custom Color" Width="22" Height="22" Padding="0" MinWidth="0" MinHeight="0"
															BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Click="OnAnnotateCustomColor" CornerRadius="11" HorizontalAlignment="Left">
															<ic:SymbolIcon Symbol="ColorLine" IconVariant="Regular" FontSize="12"/>
														</Button>
													</StackPanel>
												</Border>
											</Border>
										</Flyout>
									</Button.Flyout>
									<Ellipse Name="ColorFlyoutIndicator" Width="18" Height="18" Fill="#D64045"/>
								</Button>

								<!-- Brush size flyout -->
                                <Button ToolTip.Tip="Open brush size menu" Width="26" Height="26" Padding="0" BorderThickness="0">
									<Button.Flyout>
										<Flyout Placement="Bottom" ShowMode="TransientWithDismissOnPointerMoveAway"
												FlyoutPresenterTheme="{StaticResource OverlayFlyout}">
											<Border Classes="shadow" Margin="0" MinHeight="0" Padding="6,4">
												<Border.Background>
													<SolidColorBrush Color="{DynamicResource SystemRegionColor}"/>
												</Border.Background>
												<Border Background="{DynamicResource TextControlBackground}" Margin="-6,-4" Padding="6,4">
													<StackPanel Orientation="Vertical" Spacing="2">
														<Button ToolTip.Tip="Thin 1px" Width="22" Height="22" Padding="0" Tag="1" Click="OnAnnotateWidth" BorderThickness="0">
															<Ellipse Width="4" Height="4" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
														</Button>
														<Button ToolTip.Tip="Medium 2px" Width="22" Height="22" Padding="0" Tag="2" Click="OnAnnotateWidth" BorderThickness="0">
															<Ellipse Width="6" Height="6" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
														</Button>
														<Button ToolTip.Tip="Thick 4px" Width="22" Height="22" Padding="0" Tag="4" Click="OnAnnotateWidth" BorderThickness="0">
															<Ellipse Width="9" Height="9" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
														</Button>
													</StackPanel>
												</Border>
											</Border>
										</Flyout>
									</Button.Flyout>
									<Ellipse Name="BrushSizeIndicator" Width="6" Height="6" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
								</Button>

								<!-- Dash pattern flyout -->
                                <Button ToolTip.Tip="Open dash pattern menu" Width="26" Height="26" Padding="0" BorderThickness="0" VerticalContentAlignment="Center">
									<Button.Flyout>
										<Flyout Placement="Bottom" ShowMode="TransientWithDismissOnPointerMoveAway"
												FlyoutPresenterTheme="{StaticResource OverlayFlyout}">
											<Border Classes="shadow" Margin="0" MinHeight="0" Padding="6,4">
												<Border.Background>
													<SolidColorBrush Color="{DynamicResource SystemRegionColor}"/>
												</Border.Background>
												<Border Background="{DynamicResource TextControlBackground}" Margin="-6,-4" Padding="6,4">
													<StackPanel Orientation="Vertical" Spacing="2">
														<Button ToolTip.Tip="Solid" Width="50" Height="24" Padding="0" Tag="Solid" Click="OnAnnotateDashPattern" BorderThickness="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
															<Line StartPoint="0,1" EndPoint="42,1" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="2" VerticalAlignment="Center"/>
														</Button>
														<Button ToolTip.Tip="Dashed" Width="50" Height="24" Padding="0" Tag="Dashed" Click="OnAnnotateDashPattern" BorderThickness="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
															<Line StartPoint="0,1" EndPoint="42,1" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="2" StrokeDashArray="4,3" VerticalAlignment="Center"/>
														</Button>
														<Button ToolTip.Tip="Dotted" Width="50" Height="24" Padding="0" Tag="Dotted" Click="OnAnnotateDashPattern" BorderThickness="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
															<Line StartPoint="0,1" EndPoint="42,1" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="2" StrokeDashArray="1,2" VerticalAlignment="Center"/>
														</Button>
														<Button ToolTip.Tip="Dash-dot" Width="50" Height="24" Padding="0" Tag="DashDot" Click="OnAnnotateDashPattern" BorderThickness="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
															<Line StartPoint="0,1" EndPoint="42,1" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="2" StrokeDashArray="4,2,1,2" VerticalAlignment="Center"/>
														</Button>
													</StackPanel>
												</Border>
											</Border>
										</Flyout>
									</Button.Flyout>
									<Line Name="DashIndicator" StartPoint="0,1" EndPoint="22,1" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="2" VerticalAlignment="Center"/>
								</Button>

								<!-- Corner radius flyout -->
                             <Button ToolTip.Tip="Open corner radius menu" Width="26" Height="26" Padding="0" BorderThickness="0">
									<Button.Flyout>
										<Flyout Placement="Bottom" ShowMode="TransientWithDismissOnPointerMoveAway"
												FlyoutPresenterTheme="{StaticResource OverlayFlyout}">
											<Border Classes="shadow" Margin="0" MinHeight="0" Padding="6,4">
												<Border.Background>
													<SolidColorBrush Color="{DynamicResource SystemRegionColor}"/>
												</Border.Background>
												<Border Background="{DynamicResource TextControlBackground}" Margin="-6,-4" Padding="6,4">
													<StackPanel Orientation="Vertical" Spacing="2">
														<Button ToolTip.Tip="Sharp corners" Width="26" Height="26" Padding="0" Tag="0" Click="OnAnnotateCornerRadius" BorderThickness="0">
															<Border Width="14" Height="14" BorderThickness="1.5" BorderBrush="{DynamicResource SystemControlForegroundBaseHighBrush}" CornerRadius="0"/>
														</Button>
														<Button ToolTip.Tip="Small radius" Width="26" Height="26" Padding="0" Tag="2" Click="OnAnnotateCornerRadius" BorderThickness="0">
															<Border Width="14" Height="14" BorderThickness="1.5" BorderBrush="{DynamicResource SystemControlForegroundBaseHighBrush}" CornerRadius="2"/>
														</Button>
														<Button ToolTip.Tip="Medium radius" Width="26" Height="26" Padding="0" Tag="5" Click="OnAnnotateCornerRadius" BorderThickness="0">
															<Border Width="14" Height="14" BorderThickness="1.5" BorderBrush="{DynamicResource SystemControlForegroundBaseHighBrush}" CornerRadius="5"/>
														</Button>
														<Button ToolTip.Tip="Large radius" Width="26" Height="26" Padding="0" Tag="10" Click="OnAnnotateCornerRadius" BorderThickness="0">
															<Border Width="14" Height="14" BorderThickness="1.5" BorderBrush="{DynamicResource SystemControlForegroundBaseHighBrush}" CornerRadius="7"/>
														</Button>
													</StackPanel>
												</Border>
											</Border>
										</Flyout>
									</Button.Flyout>
									<Border Name="CornerIndicator" Width="14" Height="14" BorderThickness="1.5" BorderBrush="{DynamicResource SystemControlForegroundBaseHighBrush}" CornerRadius="0"/>
								</Button>

								<Border Width="2" Background="#50888888" Margin="3,4" CornerRadius="1"/>
								<!-- Fill toggle -->
                             <Button Name="FillToggleBtn" ToolTip.Tip="Toggle fill for the current tool or selection" Width="26" Height="26" Padding="0" Click="OnToggleFill" BorderThickness="0">
									<ic:SymbolIcon Symbol="PaintBucket" IconVariant="Regular" FontSize="14"/>
								</Button>
								<!-- Opacity -->
								<Slider Name="OpacitySlider" ToolTip.Tip="Opacity" Minimum="0.1" Maximum="1" Value="1" Width="60"
									VerticalAlignment="Top" Padding="0" Height="35" Margin="0,-10,0,0"/>
								<Border Width="2" Background="#50888888" Margin="3,4" CornerRadius="1"/>
								<!-- Font size -->
								<Button ToolTip.Tip="Decrease font size (−)" Width="18" Height="18" Padding="0" MinWidth="0" MinHeight="0" Click="OnFontSizeDecrease" BorderThickness="0" FontSize="12" Content="−"/>
								<TextBlock Name="FontSizeLabel" Text="10pt" FontSize="12" VerticalAlignment="Center" Margin="2,0"
									ToolTip.Tip="Text font size (−/+ to adjust)" Opacity="0.6"/>
								<Button ToolTip.Tip="Increase font size (+)" Width="18" Height="18" Padding="0" MinWidth="0" MinHeight="0" Click="OnFontSizeIncrease" BorderThickness="0" FontSize="12" Content="+"/>
								<Border Width="2" Background="#50888888" Margin="3,4" CornerRadius="1"/>
								<!-- Undo / Redo / Clear -->
								<Button Name="UndoBtn" ToolTip.Tip="Undo (Ctrl+Z)" Width="26" Height="26" Padding="0" Click="OnAnnotateUndo" BorderThickness="0">
									<ic:SymbolIcon Symbol="ArrowUndo" IconVariant="Regular" FontSize="14"/>
								</Button>
								<Button Name="SaveSketchBtn" ToolTip.Tip="Save Sketch" Width="26" Height="26" Padding="0" Click="OnSaveSketch" BorderThickness="0" IsVisible="{Binding PreviewVM.WhiteboardMode}">
									<ic:SymbolIcon Symbol="Save" IconVariant="Regular" FontSize="14"/>
								</Button>
								<Button Name="RedoBtn" ToolTip.Tip="Redo (Ctrl+Y)" Width="26" Height="26" Padding="0" Click="OnAnnotateRedo" BorderThickness="0">
									<ic:SymbolIcon Symbol="ArrowRedo" IconVariant="Regular" FontSize="14"/>
								</Button>
								<Button ToolTip.Tip="Clear Page" Width="26" Height="26" Padding="0" Click="OnAnnotateClear" BorderThickness="0">
									<ic:SymbolIcon Symbol="Delete" IconVariant="Regular" FontSize="14"/>
								</Button>
								<Border Width="2" Background="#50888888" Margin="3,4" CornerRadius="1"/>
								<!-- Annotated pages list -->
                             <Button Name="AnnotationPagesBtn" ToolTip.Tip="Show annotated pages list" Width="26" Height="26" Padding="0" Click="OnToggleAnnotationPageList" BorderThickness="0">
									<ic:SymbolIcon Symbol="DocumentBulletList" IconVariant="Regular" FontSize="14"/>
								</Button>
								<Border Width="2" Background="#50888888" Margin="3,4" CornerRadius="1"/>
								<!-- Export -->
									<Button ToolTip.Tip="Screenshot region (Ctrl+Shift+S)" Width="26" Height="26" Padding="0" Click="OnScreenshotToolClick" BorderThickness="0" IsEnabled="{Binding PreviewVM.CanUseScreenshotTool}">
										<ic:SymbolIcon Symbol="Screenshot" IconVariant="Regular" FontSize="14"/>
									</Button>
								<Button ToolTip.Tip="Copy (Ctrl+C)" Width="26" Height="26" Padding="0" Click="OnAnnotateCopy" BorderThickness="0">
									<ic:SymbolIcon Symbol="Clipboard" IconVariant="Regular" FontSize="14"/>
								</Button>
								<Button ToolTip.Tip="Export Review" Width="26" Height="26" Padding="0" Click="OnAnnotateExportReview" BorderThickness="0">
									<ic:SymbolIcon Symbol="ArrowExportUp" IconVariant="Regular" FontSize="14"/>
								</Button>
								<Border Width="2" Background="#50888888" Margin="3,4" CornerRadius="1"/>
								<TextBlock Name="AnnotationCountBadge" Text="" FontSize="9" VerticalAlignment="Center" Margin="3,0"
									Foreground="{DynamicResource AppMutedForegroundBrush}"/>
								<Border Width="2" Background="{DynamicResource AppToolbarSeparatorBrush}" Margin="3,4" CornerRadius="1" Opacity="0.7"/>
								<Button Name="LayerPickerBtn" ToolTip.Tip="Active layer — click to switch" Height="26" Padding="4,0" Click="OnLayerPickerClick" BorderThickness="0">
									<StackPanel Orientation="Horizontal" Spacing="3">
										<ic:SymbolIcon Symbol="Layer" IconVariant="Regular" FontSize="12"/>
									<TextBlock Name="ActiveLayerLabel" Text="Layer 1" FontSize="9" VerticalAlignment="Center" Foreground="{DynamicResource AppMutedForegroundBrush}" MaxWidth="60" TextTrimming="CharacterEllipsis"/>
									</StackPanel>
								</Button>
								<Button Name="LayerVisBtn" ToolTip.Tip="Toggle active layer visibility" Width="26" Height="26" Padding="0" Click="OnToggleLayerVisibility" BorderThickness="0">
									<ic:SymbolIcon Symbol="Eye" IconVariant="Regular" FontSize="14"/>
								</Button>
								<Button Name="LayerLockBtn" ToolTip.Tip="Toggle active layer lock" Width="26" Height="26" Padding="0" Click="OnToggleLayerLock" BorderThickness="0">
									<ic:SymbolIcon Symbol="LockOpen" IconVariant="Regular" FontSize="14"/>
								</Button>
							</StackPanel>
								 </Grid>
							 </Border>
						 </Border>
						<Border Name="AnnotationStatusBorder" IsVisible="False" HorizontalAlignment="Center"
								Padding="10,4" IsHitTestVisible="False"
								Background="#AA111111" CornerRadius="6">
							<TextBlock Name="AnnotationStatusText" FontSize="11" TextWrapping="Wrap"
								HorizontalAlignment="Center" TextAlignment="Center"
								Foreground="White" MaxWidth="520" Opacity="0.92"/>
						</Border>
						</StackPanel>

								<!-- Diff toolbar: floating overlay at bottom of preview, separate from annotation toolbar -->
			<Border Name="DiffToolbar" Classes="shadow" IsVisible="{Binding PreviewVM.ShowDiffToolbar}" IsHitTestVisible="True"
					HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6"
					Padding="6,3">
				<Border Classes="clip-inner" Padding="6,3">
				<StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
					<!-- Mode buttons — radio-style (OneWay + Click ensures one is always selected) -->
					<ToggleButton Classes="ghost" ToolTip.Tip="A/B Toggle — swap between original and revised" Height="30" Width="30" Padding="0" IsChecked="{Binding PreviewVM.IsToggleMode, Mode=OneWay}" Click="OnDiffModeToggle">
						<ic:SymbolIcon Symbol="ArrowSwap" IconVariant="Regular" FontSize="16"/>
					</ToggleButton>
					<ToggleButton Classes="ghost" ToolTip.Tip="Side-by-side comparison" Height="30" Width="30" Padding="0" IsChecked="{Binding PreviewVM.IsSideBySideMode, Mode=OneWay}" Click="OnDiffModeSBS">
						<ic:SymbolIcon Symbol="SplitHorizontal" IconVariant="Regular" FontSize="16"/>
					</ToggleButton>

					<Border Width="1"
							Height="16"
							Background="{DynamicResource AppToolbarSeparatorBrush}"
							Opacity="0.55"/>

					<!-- A/B switch (visible in Toggle mode) -->
					<ToggleButton Classes="ghost" Name="DiffABToggle" Height="30" MinWidth="56" Padding="6,0"
								  IsChecked="{Binding PreviewVM.DiffShowingOriginal, Mode=TwoWay}"
								  IsVisible="{Binding PreviewVM.ShowDiffToggle}"
								  ToolTip.Tip="Toggle A/B (Ctrl+Shift+T)"
								  VerticalAlignment="Center">
						<StackPanel Orientation="Horizontal" Spacing="4">
							<ic:SymbolIcon Symbol="ArrowSwap" IconVariant="Regular" FontSize="14"/>
							<TextBlock Name="DiffABLabel" Classes="h2" Text="B" VerticalAlignment="Center"/>
						</StackPanel>
					</ToggleButton>

					<Border Width="1"
							Height="16"
							Background="{DynamicResource AppToolbarSeparatorBrush}"
							Opacity="0.55"
							IsVisible="{Binding PreviewVM.ShowDiffToggle}"/>

					<TextBlock Text="{Binding PreviewVM.DiffSummary}" FontSize="11" Foreground="{DynamicResource AppMutedForegroundBrush}" VerticalAlignment="Center"/>

					<Border Width="1"
							Height="16"
							Background="{DynamicResource AppToolbarSeparatorBrush}"
							Opacity="0.55"/>

					<!-- Run pixel comparison -->
						<ToggleButton Classes="ghost" ToolTip.Tip="Run pixel comparison" Height="30" Padding="8,0" BorderThickness="0" Click="OnRunDiffComparison" IsEnabled="{Binding !PreviewVM.DiffBusy}" IsChecked="{Binding PreviewVM.HasPixelDiffResults, Mode=OneWay}">
							<StackPanel Orientation="Horizontal" Spacing="4">
								<ic:SymbolIcon Symbol="ScanDash" IconVariant="Regular" FontSize="16"/>
								<TextBlock Text="Pixel" FontSize="11" VerticalAlignment="Center"/>
							</StackPanel>
						</ToggleButton>
						<!-- Run text (word-level) comparison -->
						<ToggleButton Classes="ghost" ToolTip.Tip="Run word-level text comparison" Height="30" Padding="8,0" BorderThickness="0" Click="OnRunTextDiff" IsEnabled="{Binding !PreviewVM.DiffBusy}" IsChecked="{Binding PreviewVM.HasTextDiffResults, Mode=OneWay}">
							<StackPanel Orientation="Horizontal" Spacing="4">
								<ic:SymbolIcon Symbol="TextDescription" IconVariant="Regular" FontSize="16"/>
								<TextBlock Text="Text" FontSize="11" VerticalAlignment="Center"/>
							</StackPanel>
						</ToggleButton>

					<!-- Tolerance slider (only after pixel diff) -->
					<Border Width="1" Height="16" Background="{DynamicResource AppToolbarSeparatorBrush}" Margin="2,0" Opacity="0.55" IsVisible="{Binding PreviewVM.HasPixelDiffResults}"/>
					<TextBlock Text="Tolerance" FontSize="10" Foreground="{DynamicResource AppMutedForegroundBrush}" VerticalAlignment="Center" IsVisible="{Binding PreviewVM.HasPixelDiffResults}"/>
					<Slider Width="80" Height="35" Minimum="0" Maximum="1000" Value="{Binding PreviewVM.DiffTolerance}" TickFrequency="50" IsSnapToTickEnabled="False" VerticalAlignment="Top" Margin="0,-10,0,0" IsVisible="{Binding PreviewVM.HasPixelDiffResults}"/>
					<TextBlock Text="{Binding PreviewVM.DiffTolerance}" FontSize="10" Width="28" Foreground="{DynamicResource AppMutedForegroundBrush}" VerticalAlignment="Center" IsVisible="{Binding PreviewVM.HasPixelDiffResults}"/>

					<Border Width="1" Height="16" Background="{DynamicResource AppToolbarSeparatorBrush}" Margin="2,0" Opacity="0.55" IsVisible="{Binding PreviewVM.HasDiffResults}"/>

						<Button Classes="ghost" ToolTip.Tip="Toggle diff page list" Height="30" Width="30" Padding="0" BorderThickness="0" Click="OnToggleDiffPageList" IsVisible="{Binding PreviewVM.HasDiffResults}">
							<ic:SymbolIcon Symbol="TextBulletListSquare" IconVariant="Regular" FontSize="16"/>
						</Button>

					<!-- Header/Footer exclusion zone heights (pt) — text diff only -->
					<Border Width="1" Height="16" Background="{DynamicResource AppToolbarSeparatorBrush}" Margin="2,0" Opacity="0.55" IsVisible="{Binding PreviewVM.HasTextDiffResults}"/>
					<TextBlock Classes="caption" Text="H" Foreground="{DynamicResource AppSubtleForegroundBrush}" VerticalAlignment="Center" IsVisible="{Binding PreviewVM.HasTextDiffResults}" ToolTip.Tip="Header exclusion height (pt). Text in this zone is ignored during text diff. 0 = include everything."/>
					<TextBox Width="36" Height="22" MinHeight="0" FontSize="10" Padding="4,2" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderThickness="0"
							 Text="{Binding PreviewVM.DiffHeaderHeight}" IsVisible="{Binding PreviewVM.HasTextDiffResults}" ToolTip.Tip="Header zone height in PDF points (0 = none)"/>
					<TextBlock Classes="caption" Text="F" Foreground="{DynamicResource AppSubtleForegroundBrush}" VerticalAlignment="Center" Margin="4,0,0,0" IsVisible="{Binding PreviewVM.HasTextDiffResults}" ToolTip.Tip="Footer exclusion height (pt). Text in this zone is ignored during text diff. 0 = include everything."/>
					<TextBox Width="36" Height="22" MinHeight="0" FontSize="10" Padding="4,2" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderThickness="0"
							 Text="{Binding PreviewVM.DiffFooterHeight}" IsVisible="{Binding PreviewVM.HasTextDiffResults}" ToolTip.Tip="Footer zone height in PDF points (0 = none)"/>
					<Button Classes="ghost" ToolTip.Tip="Re-run text diff with current header/footer zones" Height="22" Padding="6,0" FontSize="10" BorderThickness="0"
							Click="OnRerunTextDiffWithZones" IsVisible="{Binding PreviewVM.HasTextDiffResults}" IsEnabled="{Binding PreviewVM.CanRerunDiff}">
						<ic:SymbolIcon Symbol="ArrowSync" IconVariant="Regular" FontSize="12"/>
					</Button>

							</StackPanel>
						</Border>
						</Border>

			<!-- Calibration input overlay -->

			<Canvas Name="CalibrationCanvas" IsVisible="False" IsHitTestVisible="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
				<Border Name="CalibrationBorder" Classes="shadow" Padding="8">
					<Border Background="{DynamicResource AppOverlaySurfaceBrush}" Margin="-8" Padding="8" BorderBrush="{DynamicResource AppFlyoutBorderBrush}" BorderThickness="1" CornerRadius="4">
					<StackPanel Spacing="6">
						<TextBlock Name="CalibrationPromptText" Classes="body" Text="Enter real-world distance for the last measurement:" TextWrapping="Wrap" MaxWidth="220"/>
						<StackPanel Orientation="Horizontal" Spacing="4">
							<TextBox Name="CalibrationValueBox" Width="120" PlaceholderText="e.g. 210" KeyDown="OnCalibrationKeyDown"/>
							<TextBlock Classes="body" Text="mm" VerticalAlignment="Center"/>
						</StackPanel>
						<StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
							<Button Classes="body" Content="Apply" Click="OnCalibrationApply" Padding="8,2"/>
							<Button Classes="body" Content="Cancel" Click="OnCalibrationCancel" Padding="8,2"/>
						</StackPanel>
					</StackPanel>
					</Border>
				</Border>
			</Canvas>

			<!-- Color input overlay -->
				<Canvas Name="ColorInputCanvas" IsVisible="False" IsHitTestVisible="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
					<Border Classes="shadow" Padding="8"
							Canvas.Left="80" Canvas.Top="40">
						<Border Background="{DynamicResource AppOverlaySurfaceBrush}" Margin="-8" Padding="8" BorderThickness="1" BorderBrush="{DynamicResource AppFlyoutBorderBrush}" CornerRadius="4">
						<StackPanel Spacing="6">
							<TextBlock Classes="body" Text="Enter hex color:"/>
							<TextBox Name="ColorInputBox" Width="120" PlaceholderText="#FF6600" KeyDown="OnColorInputKeyDown"/>
							<StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
								<Button Classes="body" Content="Apply" Click="OnColorInputApply" Padding="8,2"/>
								<Button Classes="body" Content="Cancel" Click="OnColorInputCancel" Padding="8,2"/>
							</StackPanel>
						</StackPanel>
						</Border>
					</Border>
				</Canvas>

				<!-- Shape property panel (double-click to edit) -->
               <Canvas Name="PropertyPanelCanvas" IsVisible="False" IsHitTestVisible="True" Background="Transparent"
						HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
						PointerPressed="OnPropertyPanelBackgroundClick">
					<Border Name="PropertyPanelBorder" Classes="shadow" Padding="8,6">
						<Border Background="{DynamicResource AppOverlaySurfaceBrush}" Margin="-8,-6" Padding="8,6" BorderThickness="1" BorderBrush="{DynamicResource AppFlyoutBorderBrush}" CornerRadius="4">
                        <StackPanel Spacing="4" KeyboardNavigation.TabNavigation="Cycle">
							<StackPanel Orientation="Horizontal" Spacing="2">
								<Button ToolTip.Tip="Red" Width="22" Height="22" Padding="0" MinWidth="0" MinHeight="0"
									Background="#D64045" Opacity="0.85" Tag="Red" Click="OnPropertyColor" CornerRadius="11"/>
								<Button ToolTip.Tip="Blue" Width="22" Height="22" Padding="0" MinWidth="0" MinHeight="0"
									Background="#3B82D9" Opacity="0.85" Tag="Blue" Click="OnPropertyColor" CornerRadius="11"/>
								<Button ToolTip.Tip="Green" Width="22" Height="22" Padding="0" MinWidth="0" MinHeight="0"
									Background="#3DA35F" Opacity="0.85" Tag="Green" Click="OnPropertyColor" CornerRadius="11"/>
								<Button ToolTip.Tip="Black" Width="22" Height="22" Padding="0" MinWidth="0" MinHeight="0"
									Background="#222222" Opacity="0.85" Tag="Black" Click="OnPropertyColor" CornerRadius="11"/>
								<Button ToolTip.Tip="Orange" Width="22" Height="22" Padding="0" MinWidth="0" MinHeight="0"
									Background="#E87D2F" Opacity="0.85" Tag="Orange" Click="OnPropertyColor" CornerRadius="11"/>
								<Button ToolTip.Tip="Purple" Width="22" Height="22" Padding="0" MinWidth="0" MinHeight="0"
									Background="#8B5CF6" Opacity="0.85" Tag="Purple" Click="OnPropertyColor" CornerRadius="11"/>
								<Button ToolTip.Tip="Yellow" Width="22" Height="22" Padding="0" MinWidth="0" MinHeight="0"
									Background="#F5C332" Opacity="0.85" Tag="Yellow" Click="OnPropertyColor" CornerRadius="11"/>
								<Button ToolTip.Tip="Teal" Width="22" Height="22" Padding="0" MinWidth="0" MinHeight="0"
									Background="#26A69A" Opacity="0.85" Tag="Teal" Click="OnPropertyColor" CornerRadius="11"/>
								<Button ToolTip.Tip="Pink" Width="22" Height="22" Padding="0" MinWidth="0" MinHeight="0"
									Background="#EC407A" Opacity="0.85" Tag="Pink" Click="OnPropertyColor" CornerRadius="11"/>
								<Button ToolTip.Tip="Brown" Width="22" Height="22" Padding="0" MinWidth="0" MinHeight="0"
									Background="#8D6E63" Opacity="0.85" Tag="Brown" Click="OnPropertyColor" CornerRadius="11"/>
							</StackPanel>
							<StackPanel Name="PropertyStrokeRow" Orientation="Horizontal" Spacing="1">
							<Button Classes="ghost" ToolTip.Tip="Thin" Width="20" Height="20" Padding="0" Tag="1" Click="OnPropertyWidth" BorderThickness="0">
									<Ellipse Width="4" Height="4" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
								</Button>
							<Button Classes="ghost" ToolTip.Tip="Medium" Width="20" Height="20" Padding="0" Tag="2" Click="OnPropertyWidth" BorderThickness="0">
									<Ellipse Width="6" Height="6" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
								</Button>
							<Button Classes="ghost" ToolTip.Tip="Thick" Width="20" Height="20" Padding="0" Tag="4" Click="OnPropertyWidth" BorderThickness="0">
									<Ellipse Width="9" Height="9" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
								</Button>
									<StackPanel Name="PropertyDashRow" Orientation="Horizontal" Spacing="1">
									<Border Width="1" Background="{DynamicResource AppToolbarSeparatorBrush}" Margin="2,3" CornerRadius="1" Opacity="0.7"/>
								<Button Classes="ghost" ToolTip.Tip="Solid" Width="24" Height="20" Padding="0" Tag="Solid" Click="OnPropertyDash" BorderThickness="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
											<Line StartPoint="0,1" EndPoint="20,1" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="2" VerticalAlignment="Center"/>
										</Button>
								<Button Classes="ghost" ToolTip.Tip="Dashed" Width="24" Height="20" Padding="0" Tag="Dashed" Click="OnPropertyDash" BorderThickness="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
											<Line StartPoint="0,1" EndPoint="20,1" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="2" StrokeDashArray="4,3" VerticalAlignment="Center"/>
										</Button>
								<Button Classes="ghost" ToolTip.Tip="Dotted" Width="24" Height="20" Padding="0" Tag="Dotted" Click="OnPropertyDash" BorderThickness="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
											<Line StartPoint="0,1" EndPoint="20,1" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="2" StrokeDashArray="1,2" VerticalAlignment="Center"/>
										</Button>
								<Button Classes="ghost" ToolTip.Tip="Dash-Dot" Width="24" Height="20" Padding="0" Tag="DashDot" Click="OnPropertyDash" BorderThickness="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
											<Line StartPoint="0,1" EndPoint="20,1" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" StrokeThickness="2" StrokeDashArray="4,2,1,2" VerticalAlignment="Center"/>
										</Button>
									</StackPanel>
								<Border Width="1" Background="{DynamicResource AppToolbarSeparatorBrush}" Margin="2,3" CornerRadius="1" Opacity="0.7"/>
                         <Button Classes="ghost" Name="PropertyFillBtn" ToolTip.Tip="Toggle fill" Width="26" Height="26" Padding="0" Click="OnPropertyFill" BorderThickness="0">
									<ic:SymbolIcon Symbol="PaintBucket" IconVariant="Regular" FontSize="14"/>
								</Button>
								</StackPanel>
								<StackPanel Name="PropertyCornerRadiusRow" Orientation="Horizontal" Spacing="1">
							<Button Classes="ghost" ToolTip.Tip="Sharp corners" Width="26" Height="26" Padding="0" Tag="0" Click="OnPropertyCornerRadius" BorderThickness="0">
									<Border Width="13" Height="13" BorderThickness="1.5" BorderBrush="{DynamicResource SystemControlForegroundBaseHighBrush}" CornerRadius="0"/>
								</Button>
							<Button Classes="ghost" ToolTip.Tip="Small radius" Width="26" Height="26" Padding="0" Tag="2" Click="OnPropertyCornerRadius" BorderThickness="0">
									<Border Width="13" Height="13" BorderThickness="1.5" BorderBrush="{DynamicResource SystemControlForegroundBaseHighBrush}" CornerRadius="2"/>
								</Button>
							<Button Classes="ghost" ToolTip.Tip="Medium radius" Width="26" Height="26" Padding="0" Tag="5" Click="OnPropertyCornerRadius" BorderThickness="0">
									<Border Width="13" Height="13" BorderThickness="1.5" BorderBrush="{DynamicResource SystemControlForegroundBaseHighBrush}" CornerRadius="3"/>
								</Button>
							<Button Classes="ghost" ToolTip.Tip="Large radius" Width="26" Height="26" Padding="0" Tag="10" Click="OnPropertyCornerRadius" BorderThickness="0">
									<Border Width="13" Height="13" BorderThickness="1.5" BorderBrush="{DynamicResource SystemControlForegroundBaseHighBrush}" CornerRadius="4"/>
								</Button>
								</StackPanel>
								<StackPanel Name="PropertyOpacityRow" Orientation="Horizontal" Spacing="4">
									<TextBlock Text="Opacity" FontSize="9" VerticalAlignment="Center" Foreground="{DynamicResource AppSubtleForegroundBrush}"/>
									<Slider Name="PropertyOpacitySlider" Minimum="0.1" Maximum="1" Value="1" Width="80"
										VerticalAlignment="Top" Padding="0" Height="35" Margin="0,-10,0,0"/>
								</StackPanel>
								<!-- Inline text editor (visible for text annotations and new text placement) -->
								<StackPanel Name="PropertyTextRow" IsVisible="False" Spacing="2">
								<Border Height="1" Background="{DynamicResource AppDividerBrush}" Margin="0,2" Opacity="0.5"/>
									<TextBox Name="PropertyTextBox" MinWidth="180" MinHeight="34" AcceptsReturn="True" TextWrapping="Wrap" PlaceholderText="Enter text..." HorizontalAlignment="Stretch"/>
								</StackPanel>
								<Border Height="1" Background="{DynamicResource AppDividerBrush}" Margin="0,2" Opacity="0.5"/>
								<StackPanel Name="PropertyActionsRow" Orientation="Horizontal" Spacing="1">
                            <Button Classes="ghost" Name="PropertyClosePolyBtn" ToolTip.Tip="Close polyline" Width="26" Height="26" Padding="0" Click="OnPropertyClosePolyline" BorderThickness="0">
									<ic:SymbolIcon Symbol="Flowchart" IconVariant="Regular" FontSize="14"/>
								</Button>
								<Border Width="1" Background="{DynamicResource AppToolbarSeparatorBrush}" Margin="2,3" CornerRadius="1" Opacity="0.7"/>
                          <Button Classes="ghost" ToolTip.Tip="Match style" Width="26" Height="26" Padding="0" Click="OnPropertyMatchStyle" BorderThickness="0">
									<ic:SymbolIcon Symbol="ColorLine" IconVariant="Regular" FontSize="14"/>
								</Button>
                         <Button Classes="ghost" ToolTip.Tip="Duplicate annotation" Width="26" Height="26" Padding="0" Click="OnPropertyDuplicate" BorderThickness="0">
									<ic:SymbolIcon Symbol="Copy" IconVariant="Regular" FontSize="14"/>
								</Button>
								<Border Width="1" Background="{DynamicResource AppToolbarSeparatorBrush}" Margin="2,3" CornerRadius="1" Opacity="0.7"/>
                         <Button Classes="ghost" ToolTip.Tip="Bring annotation to front" Width="26" Height="26" Padding="0" Click="OnPropertyBringToFront" BorderThickness="0">
									<ic:SymbolIcon Symbol="ArrowCircleUp" IconVariant="Regular" FontSize="14"/>
								</Button>
                         <Button Classes="ghost" ToolTip.Tip="Send annotation to back" Width="26" Height="26" Padding="0" Click="OnPropertySendToBack" BorderThickness="0">
									<ic:SymbolIcon Symbol="ArrowCircleDown" IconVariant="Regular" FontSize="14"/>
								</Button>
								<Border Width="1" Background="{DynamicResource AppToolbarSeparatorBrush}" Margin="2,3" CornerRadius="1" Opacity="0.7"/>
                           <Button Classes="ghost" ToolTip.Tip="Delete annotation" Width="26" Height="26" Padding="0" Click="OnPropertyDelete" BorderThickness="0">
									<ic:SymbolIcon Symbol="Delete" IconVariant="Regular" FontSize="14" Foreground="#E05050"/>
								</Button>
								</StackPanel>
							</StackPanel>
						</Border>
					</Border>
				</Canvas>

				<!-- Review export name overlay -->
					<Grid Name="ReviewExportCanvas" IsVisible="False" IsHitTestVisible="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
						<Border Classes="shadow" Padding="8"
								HorizontalAlignment="Center" VerticalAlignment="Center">
							<Border Background="{DynamicResource AppOverlaySurfaceBrush}" Margin="-8" Padding="8" BorderBrush="{DynamicResource AppFlyoutBorderBrush}" BorderThickness="1" CornerRadius="4">
							<StackPanel Spacing="6">
								<TextBlock Text="Enter review name:" Classes="body"/>
								<TextBox Name="ReviewNameBox" Width="180" PlaceholderText="e.g. Draft review" KeyDown="OnReviewNameKeyDown"/>
								<TextBlock Name="ReviewExportStatus" Classes="caption" Text="" Foreground="{DynamicResource AppMutedForegroundBrush}" TextWrapping="Wrap" MaxWidth="260"/>
								<StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
									<Button Content="Export" Click="OnReviewExportConfirm" Padding="8,2" Classes="body"/>
									<Button Content="Cancel" Click="OnReviewExportCancel" Padding="8,2" Classes="body"/>
								</StackPanel>
							</StackPanel>
							</Border>
						</Border>
					</Grid>

					<!-- Annotation keyboard cheat-sheet overlay -->
					<Grid Name="AnnotateShortcutsCanvas" IsVisible="False" IsHitTestVisible="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
						<Border Classes="shadow" Padding="8" HorizontalAlignment="Center" VerticalAlignment="Center" PointerPressed="OnAnnotateShortcutsBackgroundClick">
							<Border Background="{DynamicResource AppOverlaySurfaceBrush}" Margin="-8" Padding="10" BorderBrush="{DynamicResource AppFlyoutBorderBrush}" BorderThickness="1" CornerRadius="6">
								<StackPanel Spacing="4" MaxWidth="420">
									<TextBlock Text="Annotation Shortcuts" FontSize="14" FontWeight="SemiBold"/>
									<TextBlock Text="V Select · P Polyline · A Area · D Dot · 1-0 Tools" FontSize="12"/>
									<TextBlock Text="Enter finish polyline · Esc cancel/exit · Shift axis constrain" FontSize="12"/>
									<TextBlock Text="Ctrl+C / Ctrl+V copy-paste · Ctrl+D duplicate · Ctrl+A select all" FontSize="12"/>
									<TextBlock Text="Arrows nudge (Shift = 10) · [ ] width · -/+ text size · G grid snap" FontSize="12"/>
									<TextBlock Text="Press ? to toggle this help" FontSize="11" Foreground="{DynamicResource AppSubtleForegroundBrush}"/>
								</StackPanel>
							</Border>
						</Border>
					</Grid>
				</Grid>

		<Grid Name="SearchGrid" MinWidth="0" Grid.Column="1" ClipToBounds="False" Width="200" IsVisible="{Binding PreviewVM.SearchMode}">
			<Border Name="SearchGridBorder" Classes="shadow" Grid.Row="0" Margin="5">
				<Grid RowDefinitions="Auto,Auto,*">

					<!-- Header area: same surface as DataGrid headers -->
					<Border Grid.Row="0" Background="{DynamicResource AppHeaderSurfaceBrush}"
							CornerRadius="10,10,0,0" Padding="6,6,6,0">
						<Grid RowDefinitions="Auto,36">

							<!-- Text search input (hidden during diff page list mode) -->
							<Border Grid.Row="0" Width="170" HorizontalAlignment="Center" FlowDirection="LeftToRight">
								<Border.IsVisible>
									<MultiBinding Converter="{x:Static BoolConverters.And}">
										<Binding Path="!PreviewVM.DiffPageListMode"/>
										<Binding Path="!PreviewVM.AnnotationPageListMode"/>
									</MultiBinding>
								</Border.IsVisible>
								<Grid ColumnDefinitions="*,30,30" Margin="-5 0 -5 0">
									<Border Grid.Column="0" Classes="shadow">
										<TextBox PlaceholderText="Search text..." Name="SearchRegex" KeyDown="OnStartSearhRegex"/>
									</Border>
									<Button Grid.Column="1" Margin="0" Click="OnSeachRegex" BorderThickness="0" IsEnabled="{Binding !PreviewVM.SearchBusy}">
										<ic:SymbolIcon Symbol="Search" IconVariant="Regular" FontSize="16"/>
									</Button>
									<Button Grid.Column="2" Margin="0" Click="OnClearSearch" BorderThickness="0">
										<ic:SymbolIcon Symbol="Dismiss" IconVariant="Regular" FontSize="16"/>
									</Button>
								</Grid>
							</Border>

							<!-- Diff page list header (shown during diff page list mode) -->
							<Border Grid.Row="0" IsVisible="{Binding PreviewVM.DiffPageListMode}" Padding="8,4">
								<StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
									<ic:SymbolIcon Symbol="DocumentPageBreak" IconVariant="Regular" FontSize="14" Foreground="{DynamicResource AppMutedForegroundBrush}"/>
									<TextBlock Text="Changed Pages" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
								</StackPanel>
							</Border>

							<!-- Annotation page list header (shown during annotation page list mode) -->
							<Border Grid.Row="0" IsVisible="{Binding PreviewVM.AnnotationPageListMode}" Padding="8,4">
								<StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
									<ic:SymbolIcon Symbol="DrawText" IconVariant="Regular" FontSize="14" Foreground="{DynamicResource AppMutedForegroundBrush}"/>
									<TextBlock Text="Annotated Pages" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
								</StackPanel>
							</Border>

							<!-- Prev/Next nav row -->
							<Border Grid.Row="1" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource AppStrongBorderBrush}">
								<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
									<Button ToolTip.Tip="Previous Result" ToolTip.Placement="Right" Width="28" Height="28" Padding="0" BorderThickness="0" Command="{Binding PreviewVM.PrevSearchPage}">
										<ic:SymbolIcon Symbol="ArrowPrevious" IconVariant="Regular" FontSize="16"/>
									</Button>
									<Button ToolTip.Tip="Next Result" ToolTip.Placement="Right" Width="28" Height="28" Padding="0" BorderThickness="0" Command="{Binding PreviewVM.NextSearchPage}">
										<ic:SymbolIcon Symbol="ArrowNext" IconVariant="Regular" FontSize="16"/>
									</Button>
									<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
										<Label Content="{Binding PreviewVM.SearchPageIndex, Converter={StaticResource AddOneConverter}}" VerticalAlignment="Center"/>
										<Label Content="/" VerticalAlignment="Center"/>
										<Label Content="{Binding PreviewVM.SearchItems}" VerticalAlignment="Center"/>
									</StackPanel>
								</StackPanel>
							</Border>
						</Grid>
					</Border>

					<!-- Body area: same surface as DataGrids -->
					<ListBox Name="SearchResultList" Grid.Row="2" ItemsSource="{Binding PreviewVM.SearchPagesText}" Background="{DynamicResource AppPanelSurfaceBrush}" SelectedIndex="{Binding PreviewVM.SearchPageIndex}" FontSize="13">
						<ListBox.Styles>
							<Style Selector="ListBoxItem">
								<Setter Property="Height" Value="25"/>
								<Setter Property="Padding" Value="10,0,0,0"/>
								<Setter Property="VerticalContentAlignment" Value="Center"/>
							</Style>
						</ListBox.Styles>
					</ListBox>

				</Grid>
			</Border>
		</Grid>

		<Grid ColumnDefinitions="*,Auto,*" Grid.Row="1" Grid.ColumnSpan="2">
			<Border Classes="shadow" Grid.Column="1" Background="{DynamicResource AppPanelSurfaceBrush}" Padding="5,2">
				<StackPanel FlowDirection="LeftToRight" Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center" Margin="10 0 10 0" DataContext="{Binding PreviewVM}">

					<Slider Name="ScrollSlider" FlowDirection="LeftToRight" Width="200" Height="35" Margin="0 -11 0 0" Minimum="1" IsSnapToTickEnabled="True" VerticalAlignment="Top"
                            TickFrequency="1" Maximum="{Binding Pagecount}" Value="{Binding RequestPage1, Mode=OneWay, Converter={StaticResource AddOneConverter}}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
						<Label Content="{Binding CurrentPage1, Converter={StaticResource AddOneConverter}}" Width="40" HorizontalContentAlignment="Right" VerticalAlignment="Center"/>
						<Label Content="/" VerticalAlignment="Center"/>
						<Label Content="{Binding Pagecount}" VerticalAlignment="Center"/>
					</StackPanel>

					<Button Classes="ghost" ToolTip.Tip="Previous Page (Left)" FontWeight="Normal" ToolTip.Placement="Right" BorderThickness="0" Command="{Binding PrevPage}" CommandParameter="false">
						<ic:SymbolIcon Symbol="ArrowPrevious" IconVariant="Regular" FontSize="16"/>
					</Button>

					<Button Classes="ghost" ToolTip.Tip="Next Page (Right)" FontWeight="Normal" ToolTip.Placement="Right" BorderThickness="0" Command="{Binding NextPage}" CommandParameter="false">
							<ic:SymbolIcon Symbol="ArrowNext" IconVariant="Regular" FontSize="16"/>
						</Button>

						<Border Width="1" Background="{DynamicResource AppToolbarSeparatorBrush}" Margin="4,6" Opacity="0.5"/>

						<Button Classes="ghost" ToolTip.Tip="Rotate Left" FontWeight="Normal" ToolTip.Placement="Right" BorderThickness="0" Click="RotateLeft"
								IsVisible="{Binding !DualFileMode}">
							<ic:SymbolIcon Symbol="RotateLeft" IconVariant="Regular" FontSize="16"/>
						</Button>

						<Button Classes="ghost" ToolTip.Tip="Rotate Right" FontWeight="Normal" ToolTip.Placement="Right" BorderThickness="0" Click="RotateRight"
								IsVisible="{Binding !DualFileMode}">
							<ic:SymbolIcon Symbol="RotateRight" IconVariant="Regular" FontSize="16"/>
						</Button>

						<Border Width="1" Background="{DynamicResource AppToolbarSeparatorBrush}" Margin="4,6" Opacity="0.5"/>

						<!-- Cache source indicator: shows origin of the loaded file.
							 HardDrive = local file, Database = from cache, Cloud = from server, ArrowSync = cache refreshed -->
						<ic:SymbolIcon Symbol="{Binding CacheSourceIcon}" IconVariant="Regular" FontSize="16"
									   IsVisible="{Binding CacheSourceIcon, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
									   Foreground="{DynamicResource AppMutedForegroundBrush}"
									   Opacity="0.75" Width="30" Height="30"
									   ToolTip.Tip="{Binding CacheSourceTooltip}"/>

						<ToggleButton Classes="ghost" ToolTip.Tip="Invert Colors (Ctrl+G)" Width="30" Height="30" FontWeight="Normal" BorderThickness="0" Name="DimmedMode" IsChecked="{Binding DarkMode}" ToolTip.Placement="Right">
							<ic:SymbolIcon Symbol="DarkTheme" IconVariant="Regular" FontSize="16"/>
						</ToggleButton>

						<ToggleButton Classes="ghost" ToolTip.Tip="Dual Page (Ctrl+D)" Width="30" Height="30" FontWeight="Normal" BorderThickness="0" ToolTip.Placement="Right" Name="DualMode" IsChecked="{Binding TwopageMode}" IsVisible="{Binding !DualFileMode}" IsEnabled="{Binding CanToggleLayout}">
							<ic:SymbolIcon Symbol="BookOpen" IconVariant="Regular" FontSize="16"/>
						</ToggleButton>

						<ToggleButton Classes="ghost" ToolTip.Tip="Dual File" Width="30" Height="30" FontWeight="Normal" BorderThickness="0" ToolTip.Placement="Right" IsChecked="{Binding DualFileMode}" IsEnabled="{Binding CanToggleLayout}" IsVisible="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).UI.SuperuserMode}">
							<ic:SymbolIcon Symbol="BookAdd" IconVariant="Regular" FontSize="16"/>
						</ToggleButton>

						<ToggleButton Classes="ghost" ToolTip.Tip="Linked Pages (Ctrl+L)" Width="30" Height="30" FontWeight="Normal" BorderThickness="0" ToolTip.Placement="Right" Name="LinkedPageMode" IsVisible="{Binding ShowLinkedPageButton}" IsChecked="{Binding LinkedPageMode}">
							<ic:SymbolIcon Symbol="Link" IconVariant="Regular" FontSize="16"/>
						</ToggleButton>

						<Border Width="1" Background="{DynamicResource AppToolbarSeparatorBrush}" Margin="4,6" Opacity="0.5"/>

						<ToggleButton Classes="ghost" ToolTip.Tip="Search (Ctrl+F)" Width="30" Height="30" FontWeight="Normal" BorderThickness="0" ToolTip.Placement="Right" Name="SearchMode" IsChecked="{Binding SearchMode}" IsEnabled="{Binding CanSearch}">
							<ic:SymbolIcon Symbol="Search" IconVariant="Regular" FontSize="16"/>
						</ToggleButton>

						<ToggleButton Classes="ghost" Name="AnnotateToggle" ToolTip.Tip="Annotate (Esc to exit)" Width="30" Height="30" FontWeight="Normal" BorderThickness="0" ToolTip.Placement="Right" Click="OnToggleAnnotate" IsEnabled="{Binding CanAnnotate}">
							<ic:SymbolIcon Symbol="Pen" IconVariant="Regular" FontSize="16"/>
						</ToggleButton>

						<ToggleButton Classes="ghost" Name="ScreenshotToggle" ToolTip.Tip="Screenshot region (Ctrl+Shift+S)" Width="30" Height="30" FontWeight="Normal" BorderThickness="0" ToolTip.Placement="Right" Click="OnScreenshotToolClick" IsEnabled="{Binding CanUseScreenshotTool}">
							<ic:SymbolIcon Symbol="Screenshot" IconVariant="Regular" FontSize="16"/>
						</ToggleButton>

						<Button Classes="ghost" Name="CompareVersionsBtn" ToolTip.Tip="Compare Versions" Width="30" Height="30" FontWeight="Normal" ToolTip.Placement="Right" BorderThickness="0" Click="OnOpenVersionCompareDialog">
							<Button.IsVisible>
								<MultiBinding Converter="{x:Static BoolConverters.And}">
									<Binding Path="CanCompareVersions"/>
									<Binding Path="$parent[UserControl].((vm:MainViewModel)DataContext).UI.SuperuserMode"/>
								</MultiBinding>
							</Button.IsVisible>
							<ic:SymbolIcon Symbol="ArrowSwap" IconVariant="Regular" FontSize="16"/>
						</Button>

					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10 0 5 0" IsVisible="False">
						<ic:SymbolIcon Symbol="Checkmark" IconVariant="Regular" FontSize="16" IsVisible="{Binding !FileWorkerBusy}"/>
						<ic:SymbolIcon Symbol="ArrowClockwise" IconVariant="Regular" FontSize="16" IsVisible="{Binding FileWorkerBusy}"/>
					</StackPanel>
			
					<Slider Name="ScrollSliderSecondary" FlowDirection="LeftToRight" Width="200" Height="35" Margin="0 -11 0 0" Minimum="1" IsSnapToTickEnabled="True" VerticalAlignment="Top"
						TickFrequency="1" Maximum="{Binding SecondaryPagecount}" IsVisible="{Binding ShowSecondaryControls}" Value="{Binding RequestPage2, Mode=OneWay, Converter={StaticResource AddOneConverter}}"/>
			
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" IsVisible="{Binding ShowSecondaryControls}">
						<Label Content="{Binding CurrentPage2, Converter={StaticResource AddOneConverter}}" Width="40" HorizontalContentAlignment="Right" VerticalAlignment="Center"/>
						<Label Content="/" VerticalAlignment="Center"/>
						<Label Content="{Binding SecondaryPagecount}" VerticalAlignment="Center"/>
					</StackPanel>

					<Button Classes="ghost" FontWeight="Normal" BorderThickness="0" IsVisible="{Binding ShowSecondaryControls}" Command="{Binding PrevPage}" CommandParameter="true">
						<ic:SymbolIcon Symbol="ArrowPrevious" IconVariant="Regular" FontSize="16"/>
					</Button>

					<Button Classes="ghost" FontWeight="Normal" BorderThickness="0" IsVisible="{Binding ShowSecondaryControls}" Command="{Binding NextPage}" CommandParameter="true">
						<ic:SymbolIcon Symbol="ArrowNext" IconVariant="Regular" FontSize="16"/>
					</Button>

				</StackPanel>
			</Border>
		</Grid>
			</Grid>

		</UserControl>
