<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:Finn.ViewModels"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:views="clr-namespace:Finn.Views"
		mc:Ignorable="d"
		MinWidth="1600"
		MinHeight="800"
		x:Class="Finn.Views.MainWindow"
		Icon="/Assets/folder.ico"
		WindowStartupLocation="CenterScreen"
		ExtendClientAreaToDecorationsHint="True"
		ExtendClientAreaTitleBarHeightHint="35"
		Title="">

	<Window.Styles>


		<!-- Color tag rows with consistent lower opacity for readability -->
		<Style Selector="DataGridRow.Yellow">
			<Setter Property="Background">
				<Setter.Value>
					<SolidColorBrush Color="#E5A820" Opacity="0.35"/>
				</Setter.Value>
			</Setter>
		</Style>

		<Style Selector="DataGridRow.Orange">
			<Setter Property="Background">
				<Setter.Value>
					<SolidColorBrush Color="#E06830" Opacity="0.35"/>
				</Setter.Value>
			</Setter>
		</Style>

		<Style Selector="DataGridRow.Brown">
			<Setter Property="Background">
				<Setter.Value>
					<SolidColorBrush Color="#9C6B3C" Opacity="0.35"/>
				</Setter.Value>
			</Setter>
		</Style>

		<Style Selector="DataGridRow.Green">
			<Setter Property="Background">
				<Setter.Value>
					<SolidColorBrush Color="#3DA35F" Opacity="0.35"/>
				</Setter.Value>
			</Setter>
		</Style>

		<Style Selector="DataGridRow.Blue">
			<Setter Property="Background">
				<Setter.Value>
					<SolidColorBrush Color="#3B82D9" Opacity="0.35"/>
				</Setter.Value>
			</Setter>
		</Style>

		<Style Selector="DataGridRow.Red">
			<Setter Property="Background">
				<Setter.Value>
					<SolidColorBrush Color="#D64045" Opacity="0.35"/>
				</Setter.Value>
			</Setter>
		</Style>

		<Style Selector="DataGridRow.Magenta">
			<Setter Property="Background">
				<Setter.Value>
					<SolidColorBrush Color="#9B5FC0" Opacity="0.35"/>
				</Setter.Value>
			</Setter>
		</Style>

		<Style Selector="DataGridRow.RedForeground">
			<Setter Property="Foreground" Value="#FF6B6B"/>
			<Setter Property="FontStyle" Value="Italic"/>
		</Style>

		<Style Selector="DataGridRow.Placeholder">
			<Setter Property="FontStyle" Value="Italic"/>
			<Setter Property="Opacity" Value="0.55"/>
		</Style>

		<Style Selector="DataGridRow.AppendedRow">
			<Setter Property="FontStyle" Value="Italic"/>
			<Setter Property="Opacity" Value="0.85"/>
		</Style>

		<!-- Hide vertical separator lines in DataGrid column headers -->
		<Style Selector="DataGridColumnHeader">
			<Setter Property="SeparatorBrush" Value="Transparent"/>
		</Style>

	</Window.Styles>

	<Grid>
		<views:MainView/>
	</Grid>

</Window>


