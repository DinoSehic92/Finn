<Application xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 x:CompileBindings="True"
			 x:Class="Finn.App">

	<Application.Resources>
		<CornerRadius x:Key="AppCornerRadius">10</CornerRadius>
		<BoxShadow x:Key="AppShadow">0 0 0 0 Transparent</BoxShadow>
		<Thickness x:Key="AppBorderThickness">0</Thickness>

		<!-- Named tag/color-dot palette used by color picker flyout, context menus and To-Do -->
		<SolidColorBrush x:Key="TagColorYellow"  Color="#E5A820"/>
		<SolidColorBrush x:Key="TagColorOrange"  Color="#E06830"/>
		<SolidColorBrush x:Key="TagColorBrown"   Color="#9C6B3C"/>
		<SolidColorBrush x:Key="TagColorGreen"   Color="#3DA35F"/>
		<SolidColorBrush x:Key="TagColorBlue"    Color="#3B82D9"/>
		<SolidColorBrush x:Key="TagColorRed"     Color="#D64045"/>
		<SolidColorBrush x:Key="TagColorMagenta" Color="#9B5FC0"/>
	</Application.Resources>

	<Application.Styles>
       <FluentTheme>
			<FluentTheme.Palettes>
				<!-- Light mode: neutral surfaces with a vivid blue accent -->
              <ColorPaletteResources x:Key="Light" Accent="#0066C0" RegionColor="#E9EEF5" />
				<!-- Dark mode: deep charcoal surfaces with a brighter accent for contrast -->
				<ColorPaletteResources x:Key="Dark" Accent="#0A84FF" RegionColor="#1F2933" />
			</FluentTheme.Palettes>
		</FluentTheme>

		<StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
		<StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml"/>
		<StyleInclude Source="/Styles/DialogStyles.axaml"/>


		<Style Selector="FlyoutPresenter.mySpecialClass">
			<Setter Property="MaxWidth" Value="999" />
			<Setter Property="Padding" Value="4" />
			<Setter Property="CornerRadius" Value="8" />
		</Style>

		<Style Selector="TreeViewItem">
			<Setter Property="Margin" Value="0"/>
			<Setter Property="Padding" Value="2,1"/>
			<Setter Property="MinHeight" Value="26"/>
			<Setter Property="Transitions">
				<Transitions>
					<DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
				</Transitions>
			</Setter>
		</Style>

		<!-- Chevron: dim when collapsed, full opacity when expanded or hovered -->
		<Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron">
			<Setter Property="Opacity" Value="0.65"/>
			<Setter Property="Transitions">
				<Transitions>
					<DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="TreeViewItem:expanded /template/ ToggleButton#PART_ExpandCollapseChevron">
			<Setter Property="Opacity" Value="1.0"/>
		</Style>
		<Style Selector="TreeViewItem:pointerover /template/ ToggleButton#PART_ExpandCollapseChevron">
			<Setter Property="Opacity" Value="1.0"/>
		</Style>

		<Style Selector="ListBox">
			<Setter Property="Background" Value="{DynamicResource TextControlBackground}"/>
		</Style>

		<Style Selector="Button">
			<Setter Property="MinHeight" Value="30"/>
			<Setter Property="Height" Value="30"/>
			<Setter Property="MinWidth" Value="30"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}"/>
			<Setter Property="Transitions">
				<Transitions>
					<DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
				</Transitions>
			</Setter>
		</Style>

		<Style Selector="Button:pressed">
			<Setter Property="Opacity" Value="0.7"/>
		</Style>

		<Style Selector="ToggleButton">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Transitions">
				<Transitions>
					<DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
				</Transitions>
			</Setter>
		</Style>

		<Style Selector="ToggleButton:pressed">
			<Setter Property="Opacity" Value="0.7"/>
		</Style>

		<!-- Subtle checked indicator for toggle buttons -->
		<Style Selector="ToggleButton:checked">
			<Setter Property="Opacity" Value="1.0"/>
		</Style>

		<Style Selector="ToggleButton:unchecked">
			<Setter Property="Opacity" Value="0.8"/>
		</Style>

		<!-- Disabled buttons: transparent background, faded foreground -->
		<Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<Style Selector="Button:disabled">
			<Setter Property="Opacity" Value="0.35"/>
		</Style>
		<Style Selector="ToggleButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<Style Selector="ToggleButton:disabled">
			<Setter Property="Opacity" Value="0.35"/>
		</Style>

		<Style Selector="ComboBox">
			<Setter Property="MinHeight" Value="30"/>
			<Setter Property="VerticalAlignment" Value="Top"/>
			<Setter Property="Margin" Value="0,-1,0,0"/>
			<Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}"/>
			<Setter Property="Padding" Value="12,4,0,0"/>
			<Setter Property="BorderThickness" Value="0"/>
		</Style>

		<Style Selector="TextBox">
			<Setter Property="MinHeight" Value="25"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Background" Value="{DynamicResource TextControlBackground}"/>
			<Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}"/>
			<Setter Property="Padding" Value="10,7,5,5"/>
			<Setter Property="Margin" Value="0"/>
			<Setter Property="ClipToBounds" Value="False"/>
		</Style>
		<Style Selector="TextBox /template/ Border#PART_BorderElement">
			<Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}"/>
			<Setter Property="ClipToBounds" Value="False"/>
		</Style>
		<Style Selector="Border.shadow TextBox">
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Margin" Value="0"/>
		</Style>

		<Style Selector="Label">
			<Setter Property="FontSize" Value="14"/>
		</Style>
		
		<Style Selector="MenuItem">
			<Setter Property="MinHeight" Value="0"/>
			<Setter Property="Height" Value="30"/>
		</Style>

		<!-- Separator lines in menus: subtle and thin -->
		<Style Selector="ContextMenu Separator">
			<Setter Property="Height" Value="1"/>
			<Setter Property="Margin" Value="8,4"/>
			<Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"/>
		</Style>

		<!-- Context menu container -->
		<Style Selector="ContextMenu">
			<Setter Property="Padding" Value="2,4"/>
		</Style>

		<!-- Shadow border: use Classes="shadow" on a Border to get shadow, rounded corners, and optional visible border -->
		<Style Selector="Border.shadow">
			<Setter Property="BoxShadow" Value="{DynamicResource AppShadow}"/>
			<Setter Property="BorderThickness" Value="{DynamicResource AppBorderThickness}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource DataGridGridLinesBrush}"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="MinHeight" Value="25"/>
			<Setter Property="Margin" Value="5"/>
			<Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}"/>
			<Setter Property="ClipToBounds" Value="False"/>
		</Style>
		<!-- Inner border in double-border overlay pattern: match parent's corner radius -->
		<Style Selector="Border.shadow > Border">
			<Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}"/>
		</Style>

		<Style Selector="DataGridColumnHeader">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Height" Value="24"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
			<Setter Property="FontStyle" Value="Italic"/>
			<Setter Property="Opacity" Value="0.8"/>
			<Setter Property="Padding" Value="8,0,0,0"/>
		</Style>

		<Style Selector="DataGrid">
			<Setter Property="Background" Value="{DynamicResource TextControlBackground}"/>
			<Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}"/>
			<Setter Property="BorderThickness" Value="{DynamicResource AppBorderThickness}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource DataGridGridLinesBrush}"/>
			<Setter Property="Padding" Value="5"/>
			<Setter Property="Margin" Value="0"/>
			<Setter Property="ClipToBounds" Value="False"/>
		</Style>
		<Style Selector="DataGrid /template/ Border#DataGridBorder">
			<Setter Property="BoxShadow" Value="{DynamicResource AppShadow}"/>
			<Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}"/>
			<Setter Property="BorderThickness" Value="{DynamicResource AppBorderThickness}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource SystemBaseMediumLowColor}"/>
			<Setter Property="Margin" Value="5"/>
			<Setter Property="ClipToBounds" Value="False"/>
		</Style>
		
	
		<Style Selector="TextBlock">
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<Style Selector="DataGridCell">
			<Setter Property="MinHeight" Value="22"/>
		</Style>

		<Style Selector="DataGrid:focus DataGridCell:current /template/ Grid#FocusVisual">
			<Setter Property="IsVisible" Value="True" />
		</Style>

		<!-- Refined tooltips -->
		<Style Selector="ToolTip">
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Padding" Value="8,5"/>
			<Setter Property="CornerRadius" Value="6"/>
		</Style>

		<!-- Hide the fullscreen button from all window title bars -->
		<Style Selector="WindowDrawnDecorations /template/ Button#PART_FullScreenButton">
			<Setter Property="IsVisible" Value="False"/>
			<Setter Property="Width" Value="0"/>
			<Setter Property="MinWidth" Value="0"/>
		</Style>
		<Style Selector="WindowDrawnDecorations /template/ Button#PART_PopoverFullScreenButton">
			<Setter Property="IsVisible" Value="False"/>
			<Setter Property="Width" Value="0"/>
			<Setter Property="MinWidth" Value="0"/>
		</Style>

		<!-- Hide the title text from drawn decorations so it doesn't overlap content -->
		<Style Selector="WindowDrawnDecorations">
			<Setter Property="Title" Value=""/>
		</Style>

	</Application.Styles>
		
	
</Application>



