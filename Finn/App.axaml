<Application xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 x:CompileBindings="True"
			 x:Class="Finn.App">

	<Application.Resources>
		<CornerRadius x:Key="AppCornerRadius">10</CornerRadius>
		<BoxShadow x:Key="AppShadow">0 0 0 0 Transparent</BoxShadow>
		<Thickness x:Key="AppBorderThickness">1</Thickness>
       <Thickness x:Key="AppPopupBorderThickness">1</Thickness>
		<SolidColorBrush x:Key="AppBackgroundBrush" Color="#1F2933"/>
		<SolidColorBrush x:Key="AppShellSurfaceBrush" Color="#1F2933"/>
        <SolidColorBrush x:Key="AppFlyoutSurfaceBrush" Color="#2B3742"/>
		<SolidColorBrush x:Key="AppPanelSurfaceBrush" Color="#34404B"/>
		<SolidColorBrush x:Key="AppControlSurfaceBrush" Color="#3A4754"/>
		<SolidColorBrush x:Key="AppOverlaySurfaceBrush" Color="#2B3742"/>
		<SolidColorBrush x:Key="AppHoverSurfaceBrush" Color="#42607A"/>
		<SolidColorBrush x:Key="AppSelectedSurfaceBrush" Color="#2D638F"/>
		<SolidColorBrush x:Key="AppForegroundBrush" Color="#F4F7FB"/>
		<SolidColorBrush x:Key="AppSubtleForegroundBrush" Color="#B8C3CF"/>
		<SolidColorBrush x:Key="AppDisabledForegroundBrush" Color="#7E8A96"/>
      <SolidColorBrush x:Key="AppHeaderForegroundBrush" Color="#DCE6EE"/>
		<SolidColorBrush x:Key="AppMutedForegroundBrush" Color="#9CA9B6"/>
     <SolidColorBrush x:Key="AppMenuHoverBrush" Color="#36506A"/>
     <SolidColorBrush x:Key="AppRowHoverBrush" Color="#3B5268"/>
     <SolidColorBrush x:Key="AppRowSelectionBrush" Color="#315E82"/>
		<SolidColorBrush x:Key="AppRowCurrentBrush" Color="#4677A1"/>
		<SolidColorBrush x:Key="AppDividerBrush" Color="#566473"/>
		<SolidColorBrush x:Key="AppToolbarSeparatorBrush" Color="#566473"/>
		<SolidColorBrush x:Key="AppIconBrush" Color="#9CA9B6"/>
		<SolidColorBrush x:Key="AppIconStrongBrush" Color="#F4F7FB"/>
      <SolidColorBrush x:Key="AppPanelBorderBrush" Color="#4B5B69"/>
		<SolidColorBrush x:Key="AppControlBorderBrush" Color="#516170"/>
     <SolidColorBrush x:Key="AppFlyoutBorderBrush" Color="#4B5C6A"/>
        <SolidColorBrush x:Key="AppHeaderSurfaceBrush" Color="#2C3640"/>
		<SolidColorBrush x:Key="AppDropOverlayBrush" Color="#30007ACC"/>
		<SolidColorBrush x:Key="AppDropOverlaySubtleBrush" Color="#20007ACC"/>
		<SolidColorBrush x:Key="AppDropOverlayBorderBrush" Color="#0A84FF"/>
		<SolidColorBrush x:Key="AppOverlayAccentBrush" Color="#0A84FF"/>
		<SolidColorBrush x:Key="AppWarningBrush" Color="#D4983C"/>
		<SolidColorBrush x:Key="AppDestructiveBrush" Color="#D64045"/>
      <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#2B3742"/>
       <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="#4B5C6A"/>
		<Thickness x:Key="FlyoutBorderThemeThickness">1</Thickness>
		<Thickness x:Key="FlyoutContentThemePadding">8,6</Thickness>
      <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#2B3742"/>
       <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#4B5C6A"/>
		<Thickness x:Key="MenuFlyoutPresenterBorderThemeThickness">1</Thickness>
		<Thickness x:Key="MenuFlyoutPresenterThemePadding">2,4</Thickness>
		<SolidColorBrush x:Key="AppStrongBorderBrush" Color="#607182"/>

		<!-- Named tag/color-dot palette used by color picker flyout, context menus and To-Do -->
		<SolidColorBrush x:Key="TagColorYellow"  Color="#E5A820"/>
		<SolidColorBrush x:Key="TagColorOrange"  Color="#E06830"/>
		<SolidColorBrush x:Key="TagColorBrown"   Color="#9C6B3C"/>
		<SolidColorBrush x:Key="TagColorGreen"   Color="#3DA35F"/>
		<SolidColorBrush x:Key="TagColorBlue"    Color="#3B82D9"/>
		<SolidColorBrush x:Key="TagColorRed"     Color="#D64045"/>
		<SolidColorBrush x:Key="TagColorMagenta" Color="#9B5FC0"/>

		<!-- Unified compact checkbox used throughout the whole app -->
		<ControlTheme x:Key="AppCheckBox" TargetType="CheckBox">
			<Setter Property="MinWidth" Value="0"/>
			<Setter Property="MinHeight" Value="0"/>
			<Setter Property="Padding" Value="8,0,0,0"/>
			<Setter Property="Margin" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Template">
				<ControlTemplate>
					<StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
						<Border Name="Root"
								Width="16" Height="16" CornerRadius="3"
								BorderThickness="1.5"
								BorderBrush="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"
								Background="Transparent"
								HorizontalAlignment="Center" VerticalAlignment="Center">
							<Path Name="Checkmark"
									  IsVisible="False"
									  Width="9" Height="7"
									  HorizontalAlignment="Center" VerticalAlignment="Center"
									  Stroke="White" StrokeThickness="1.5"
									  StrokeLineCap="Round"
									  Data="M 0 4 L 3 7 L 9 0"
									  Stretch="Uniform"/>
						</Border>
						<ContentPresenter Name="PART_ContentPresenter"
										  Content="{TemplateBinding Content}"
										  ContentTemplate="{TemplateBinding ContentTemplate}"
										  Padding="{TemplateBinding Padding}"
										  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
										  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
										  IsVisible="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ObjectConverters.IsNotNull}}"/>
					</StackPanel>
				</ControlTemplate>
			</Setter>

			<!-- Checked: accent fill + white checkmark -->
			<Style Selector="^:checked /template/ Border#Root">
				<Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
				<Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
			</Style>
			<Style Selector="^:checked /template/ Path#Checkmark">
				<Setter Property="IsVisible" Value="True"/>
			</Style>

			<!-- Hover: subtle border highlight -->
			<Style Selector="^:pointerover /template/ Border#Root">
				<Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
				<Setter Property="Opacity" Value="0.85"/>
			</Style>

			<!-- Disabled: fade out -->
			<Style Selector="^:disabled /template/ Border#Root">
				<Setter Property="Opacity" Value="0.4"/>
			</Style>
		</ControlTheme>
	</Application.Resources>

	<Application.Styles>
       <FluentTheme>
			<FluentTheme.Palettes>
				<!-- Light mode: neutral surfaces with a vivid blue accent -->
              <ColorPaletteResources x:Key="Light" Accent="#0066C0" RegionColor="#E9EEF5" />
				<!-- Dark mode: deep charcoal surfaces with a brighter accent for contrast -->
				<ColorPaletteResources x:Key="Dark" Accent="#0A84FF" RegionColor="#1F2933" />
			</FluentTheme.Palettes>
		</FluentTheme>

		<StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
		<StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml"/>
		<StyleInclude Source="/Styles/DialogStyles.axaml"/>

		<!-- Apply the compact checkbox theme globally to every CheckBox in the app -->
		<Style Selector="CheckBox">
			<Setter Property="Theme" Value="{StaticResource AppCheckBox}"/>
		</Style>

		<Style Selector="FlyoutPresenter.wide-flyout">
			<Setter Property="MaxWidth" Value="999"/>
			<Setter Property="Padding" Value="4"/>
			<Setter Property="CornerRadius" Value="8"/>
		</Style>

		<Style Selector="FlyoutPresenter">
			<Setter Property="Background" Value="{DynamicResource AppFlyoutSurfaceBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AppFlyoutBorderBrush}"/>
           <Setter Property="BorderThickness" Value="{DynamicResource AppPopupBorderThickness}"/>
			<Setter Property="CornerRadius" Value="8"/>
		</Style>

		<Style Selector="FlyoutPresenter /template/ Border">
			<Setter Property="Background" Value="{DynamicResource AppFlyoutSurfaceBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AppFlyoutBorderBrush}"/>
           <Setter Property="BorderThickness" Value="{DynamicResource AppPopupBorderThickness}"/>
			<Setter Property="CornerRadius" Value="8"/>
		</Style>

		<Style Selector="TreeViewItem">
			<Setter Property="Margin" Value="0"/>
			<Setter Property="Padding" Value="2,1"/>
			<Setter Property="MinHeight" Value="26"/>
			<Setter Property="Transitions">
				<Transitions>
					<DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
				</Transitions>
			</Setter>
		</Style>

		<!-- Chevron: dim when collapsed, full opacity when expanded or hovered -->
		<Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron">
			<Setter Property="Opacity" Value="0.85"/>
			<Setter Property="Foreground" Value="{DynamicResource AppIconBrush}"/>
			<Setter Property="Transitions">
				<Transitions>
					<DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="TreeViewItem:expanded /template/ ToggleButton#PART_ExpandCollapseChevron">
			<Setter Property="Opacity" Value="1.0"/>
			<Setter Property="Foreground" Value="{DynamicResource AppIconStrongBrush}"/>
		</Style>
		<Style Selector="TreeViewItem:pointerover /template/ ToggleButton#PART_ExpandCollapseChevron">
			<Setter Property="Opacity" Value="1.0"/>
			<Setter Property="Foreground" Value="{DynamicResource AppIconStrongBrush}"/>
		</Style>


		<Style Selector="ListBox">
          <Setter Property="Background" Value="{DynamicResource AppPanelSurfaceBrush}"/>
		</Style>

		<Style Selector="TreeView">
			<Setter Property="Background" Value="{DynamicResource AppPanelSurfaceBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
		</Style>

		<Style Selector="TreeView /template/ ScrollViewer">
			<Setter Property="Background" Value="{DynamicResource AppPanelSurfaceBrush}"/>
		</Style>

		<Style Selector="Window">
			<Setter Property="Background" Value="{DynamicResource AppShellSurfaceBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
		</Style>

		<Style Selector="UserControl">
			<Setter Property="Background" Value="{DynamicResource AppShellSurfaceBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
		</Style>

		<Style Selector="Button">
			<Setter Property="MinHeight" Value="30"/>
			<Setter Property="Height" Value="30"/>
			<Setter Property="MinWidth" Value="30"/>
         <Setter Property="Margin" Value="1"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Background" Value="{DynamicResource AppPanelSurfaceBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
         <Setter Property="BorderBrush" Value="{DynamicResource AppControlBorderBrush}"/>
			<Setter Property="BorderThickness" Value="{DynamicResource AppBorderThickness}"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}"/>
			<Setter Property="Transitions">
				<Transitions>
					<DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
				</Transitions>
			</Setter>
		</Style>

		<!-- Contained panel button: default contained role for dialogs/panels/flyouts -->
		<Style Selector="Button.panel-button">
			<Setter Property="Background" Value="{DynamicResource AppPanelSurfaceBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AppControlBorderBrush}"/>
			<Setter Property="BorderThickness" Value="{DynamicResource AppBorderThickness}"/>
		</Style>
		<Style Selector="Button.panel-button:pointerover">
			<Setter Property="Background" Value="{DynamicResource AppHoverSurfaceBrush}"/>
		</Style>

		<Style Selector="Border.shadow > Button">
			<Setter Property="Margin" Value="0"/>
		</Style>

		<Style Selector="Button:pointerover">
			<Setter Property="Background" Value="{DynamicResource AppHoverSurfaceBrush}"/>
		</Style>

		<Style Selector="Button.dropdown-surface">
				<Setter Property="Background" Value="{DynamicResource AppPanelSurfaceBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AppControlBorderBrush}"/>
		</Style>

		<Style Selector="Button.dropdown-surface:pointerover">
			<Setter Property="Background" Value="{DynamicResource AppHoverSurfaceBrush}"/>
		</Style>

		<!-- Ghost button: transparent background, subtle hover tint, no border -->
		<Style Selector="Button.ghost">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
		</Style>
		<Style Selector="Button.ghost:pointerover">
			<Setter Property="Background" Value="{DynamicResource AppMenuHoverBrush}"/>
		</Style>

		<Style Selector="ToggleButton.panel-button">
			<Setter Property="Background" Value="{DynamicResource AppPanelSurfaceBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AppControlBorderBrush}"/>
			<Setter Property="BorderThickness" Value="{DynamicResource AppBorderThickness}"/>
		</Style>
		<Style Selector="ToggleButton.panel-button:pointerover">
			<Setter Property="Background" Value="{DynamicResource AppHoverSurfaceBrush}"/>
		</Style>
		<Style Selector="Button.ghost:pressed">
			<Setter Property="Opacity" Value="0.7"/>
		</Style>

		<Style Selector="Button:pressed">
			<Setter Property="Opacity" Value="0.7"/>
		</Style>

		<Style Selector="ToggleButton">
			<Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
				<Setter Property="Background" Value="{DynamicResource AppPanelSurfaceBrush}"/>
         <Setter Property="BorderBrush" Value="{DynamicResource AppControlBorderBrush}"/>
			<Setter Property="BorderThickness" Value="{DynamicResource AppBorderThickness}"/>
			<Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Transitions">
				<Transitions>
					<DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
				</Transitions>
			</Setter>
		</Style>

		<Style Selector="ToggleButton:pointerover">
			<Setter Property="Background" Value="{DynamicResource AppHoverSurfaceBrush}"/>
		</Style>

		<Style Selector="ToggleButton:pressed">
			<Setter Property="Opacity" Value="0.7"/>
		</Style>

		<!-- Ghost toggle button: matches button.ghost, respects checked state -->
		<Style Selector="ToggleButton.ghost">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
		</Style>
		<Style Selector="ToggleButton.ghost:pointerover">
			<Setter Property="Background" Value="{DynamicResource AppMenuHoverBrush}"/>
		</Style>
		<Style Selector="ToggleButton.ghost:pressed">
			<Setter Property="Opacity" Value="0.7"/>
		</Style>
		<Style Selector="ToggleButton.ghost:checked">
			<Setter Property="Background" Value="{DynamicResource AppSelectedSurfaceBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Opacity" Value="1.0"/>
		</Style>

		<!-- Subtle checked indicator for toggle buttons -->
		<Style Selector="ToggleButton:checked">
			<Setter Property="Opacity" Value="1.0"/>
			<Setter Property="Background" Value="{DynamicResource AppSelectedSurfaceBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
			<Setter Property="BorderThickness" Value="1"/>
		</Style>

		<Style Selector="ToggleButton:unchecked">
			<Setter Property="Opacity" Value="0.8"/>
		</Style>

		<!-- Disabled buttons: transparent background, faded foreground -->
		<Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="{DynamicResource AppDisabledForegroundBrush}"/>
		</Style>
		<Style Selector="Button:disabled">
			<Setter Property="Opacity" Value="0.5"/>
		</Style>
		<Style Selector="ToggleButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="{DynamicResource AppDisabledForegroundBrush}"/>
		</Style>
		<Style Selector="ToggleButton:disabled">
			<Setter Property="Opacity" Value="0.5"/>
		</Style>

     <Style Selector="ComboBox">
			<Setter Property="MinHeight" Value="30"/>
			<Setter Property="VerticalAlignment" Value="Top"/>
			<Setter Property="Margin" Value="0,-1,0,0"/>
			<Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}"/>
			<Setter Property="Padding" Value="12,4,0,0"/>
			<Setter Property="BorderThickness" Value="{DynamicResource AppBorderThickness}"/>
         <Setter Property="BorderBrush" Value="{DynamicResource AppControlBorderBrush}"/>
				<Setter Property="Background" Value="{DynamicResource AppPanelSurfaceBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
		</Style>

		<Style Selector="ComboBox:pointerover">
			<Setter Property="Background" Value="{DynamicResource AppHoverSurfaceBrush}"/>
		</Style>

		<Style Selector="ComboBoxItem">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
		</Style>

		<Style Selector="ComboBoxItem:pointerover">
			<Setter Property="Background" Value="{DynamicResource AppMenuHoverBrush}"/>
		</Style>

		<Style Selector="ComboBoxItem:selected">
			<Setter Property="Background" Value="{DynamicResource AppSelectedSurfaceBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
		</Style>

		<Style Selector="Border.shadow ComboBox">
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Margin" Value="0"/>
		</Style>

		<Style Selector="TextBox">
			<Setter Property="MinHeight" Value="25"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="FontSize" Value="14"/>
				<Setter Property="Background" Value="{DynamicResource AppPanelSurfaceBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
         <Setter Property="BorderBrush" Value="{DynamicResource AppControlBorderBrush}"/>
			<Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}"/>
			<Setter Property="Padding" Value="10,7,5,5"/>
			<Setter Property="Margin" Value="0"/>
			<Setter Property="ClipToBounds" Value="False"/>
		</Style>

		<Style Selector="TextBox /template/ Border#PART_BorderElement">
			<Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}"/>
			<Setter Property="ClipToBounds" Value="False"/>
		</Style>

		<Style Selector="Border.shadow TextBox">
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Margin" Value="0"/>
		</Style>

		<Style Selector="Label">
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
		</Style>

		<Style Selector="Label /template/ ContentPresenter">
			<Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
		</Style>

		<Style Selector="MenuItem">
			<Setter Property="MinHeight" Value="0"/>
			<Setter Property="Height" Value="30"/>
           <Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
		</Style>

		<Style Selector="MenuItem /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
		</Style>

		<Style Selector="MenuItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource AppMenuHoverBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AppFlyoutBorderBrush}"/>
		</Style>

		<Style Selector="MenuItem:selected /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource AppMenuHoverBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AppFlyoutBorderBrush}"/>
		</Style>

		<Style Selector="MenuItem:open /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource AppMenuHoverBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AppFlyoutBorderBrush}"/>
		</Style>

		<!-- Separator lines in menus: subtle and thin -->
		<Style Selector="ContextMenu Separator">
			<Setter Property="Height" Value="1"/>
			<Setter Property="Margin" Value="8,4"/>
			<Setter Property="Background" Value="{DynamicResource AppDividerBrush}"/>
		</Style>

		<!-- Context menu container -->
		<Style Selector="ContextMenu">
			<Setter Property="Padding" Value="2,4"/>
          <Setter Property="Background" Value="{DynamicResource AppFlyoutSurfaceBrush}"/>
		</Style>

		<Style Selector="ContextMenu /template/ Border">
         <Setter Property="Background" Value="{DynamicResource AppFlyoutSurfaceBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AppFlyoutBorderBrush}"/>
           <Setter Property="BorderThickness" Value="{DynamicResource AppPopupBorderThickness}"/>
            <Setter Property="CornerRadius" Value="8"/>
			<Setter Property="BoxShadow" Value="{DynamicResource AppShadow}"/>
		</Style>

		<!-- Shadow border: use Classes="shadow" on a Border to get shadow, rounded corners, and optional visible border -->
		<Style Selector="Border.shadow">
			<Setter Property="BoxShadow" Value="{DynamicResource AppShadow}"/>
			<Setter Property="BorderThickness" Value="{DynamicResource AppBorderThickness}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AppPanelBorderBrush}"/>
			<Setter Property="Background" Value="{DynamicResource AppPanelSurfaceBrush}"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="MinHeight" Value="25"/>
			<Setter Property="Margin" Value="5"/>
			<Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}"/>
			<Setter Property="ClipToBounds" Value="False"/>
		</Style>
		<!-- Inner clipping border: used inside a Border.shadow to clip rounded corners without clipping the shadow -->
		<Style Selector="Border.clip-inner">
			<Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}"/>
		</Style>

		<Style Selector="DataGridColumnHeader">
			<Setter Property="MinHeight" Value="26"/>
			<Setter Property="MaxHeight" Value="26"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="FontStyle" Value="Normal"/>
			<Setter Property="Foreground" Value="{DynamicResource AppHeaderForegroundBrush}"/>
			<Setter Property="Padding" Value="8,0,0,0"/>
			<Setter Property="Background" Value="{DynamicResource AppHeaderSurfaceBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AppStrongBorderBrush}"/>
			<Setter Property="BorderThickness" Value="0,0,0,1"/>
		</Style>

		<Style Selector="DataGridColumnHeader:pointerover">
			<Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
			<Setter Property="Background" Value="{DynamicResource AppHeaderSurfaceBrush}"/>
		</Style>

		<Style Selector="DataGrid">
			<Setter Property="Background" Value="{DynamicResource AppPanelSurfaceBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
			<Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Margin" Value="0"/>
		</Style>
		<Style Selector="DataGrid /template/ Border#DataGridBorder">
			<Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Margin" Value="0"/>
			<Setter Property="ClipToBounds" Value="True"/>
		</Style>

		<Style Selector="DataGrid /template/ Rectangle#PART_ColumnHeadersAndRowsSeparator">
         <Setter Property="Fill" Value="{DynamicResource AppStrongBorderBrush}"/>
		</Style>

		
	
		<Style Selector="TextBlock">
			<Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
		</Style>

		<Style Selector="TextBlock.caption">
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="Foreground" Value="{DynamicResource AppMutedForegroundBrush}"/>
		</Style>

		<Style Selector="TextBlock.metadata">
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Foreground" Value="{DynamicResource AppMutedForegroundBrush}"/>
		</Style>

		<!-- Semantic Typography Scale -->
		<Style Selector="TextBlock.h1">
			<Setter Property="FontSize" Value="18"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
		</Style>

		<Style Selector="TextBlock.h2">
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Foreground" Value="{DynamicResource AppHeaderForegroundBrush}"/>
		</Style>

		<Style Selector="TextBlock.body">
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
		</Style>

		<Style Selector="TextBlock.micro">
			<Setter Property="FontSize" Value="10"/>
			<Setter Property="Foreground" Value="{DynamicResource AppSubtleForegroundBrush}"/>
		</Style>

		<Style Selector="Menu">
			<Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
         <Setter Property="Background" Value="Transparent"/>
		</Style>

		<Style Selector="Menu /template/ Border">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
		</Style>

		<Style Selector="MenuItem:pointerover">
          <Setter Property="Background" Value="{DynamicResource AppMenuHoverBrush}"/>
		</Style>

		<Style Selector="DataGridCell">
			<Setter Property="MinHeight" Value="22"/>
				<Setter Property="BorderBrush" Value="{DynamicResource AppDividerBrush}"/>
			<Setter Property="Background" Value="Transparent"/>
		</Style>

		<Style Selector="DataGridRow:pointerover">
			  <Setter Property="Background" Value="{DynamicResource AppRowHoverBrush}"/>
		</Style>

		<Style Selector="DataGridRow:selected">
			   <Setter Property="Background" Value="{DynamicResource AppRowSelectionBrush}"/>
		</Style>

		<Style Selector="DataGridRow:selected:pointerover">
			<Setter Property="Background" Value="{DynamicResource AppRowSelectionBrush}"/>
		</Style>

		<Style Selector="DataGridCell:current">
			<Setter Property="Background" Value="Transparent"/>
		</Style>

		<!-- Refined tooltips -->
		<Style Selector="ToolTip">
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Padding" Value="8,5"/>
			<Setter Property="CornerRadius" Value="6"/>
		</Style>

		<!-- Hide the fullscreen button from all window title bars -->
		<Style Selector="WindowDrawnDecorations /template/ Button#PART_FullScreenButton">
			<Setter Property="IsVisible" Value="False"/>
			<Setter Property="Width" Value="0"/>
			<Setter Property="MinWidth" Value="0"/>
		</Style>
		<Style Selector="WindowDrawnDecorations /template/ Button#PART_PopoverFullScreenButton">
			<Setter Property="IsVisible" Value="False"/>
			<Setter Property="Width" Value="0"/>
			<Setter Property="MinWidth" Value="0"/>
		</Style>

		<!-- Hide the title text from drawn decorations so it doesn't overlap content -->
		<Style Selector="WindowDrawnDecorations">
			<Setter Property="Title" Value=""/>
		</Style>

	</Application.Styles>

</Application>