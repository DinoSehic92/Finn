<Application xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:system="clr-namespace:System;assembly=netstandard"
			 xmlns:dialogHostAvalonia="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
			 x:CompileBindings="True"
			 x:Class="Finn.App">

	<Application.Styles>
       <FluentTheme>
			<FluentTheme.Palettes>
				<!-- Light mode: neutral surfaces with a vivid blue accent -->
              <ColorPaletteResources x:Key="Light" Accent="#0066C0" RegionColor="#E9EEF5" />
				<!-- Dark mode: deep charcoal surfaces with a brighter accent for contrast -->
				<ColorPaletteResources x:Key="Dark" Accent="#0A84FF" RegionColor="#1F2933" />
			</FluentTheme.Palettes>
		</FluentTheme>

		<StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
		<StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml"/> 


		<Style Selector="FlyoutPresenter.mySpecialClass">
			<Setter Property="MaxWidth" Value="999" />
			<Setter Property="Padding" Value="4" />
			<Setter Property="CornerRadius" Value="8" />
		</Style>

		<Style Selector="TreeViewItem">
			<Setter Property="Margin" Value="0"/>
			<Setter Property="Padding" Value="2,1"/>
			<Setter Property="MaxWidth" Value="250"/>
			<Setter Property="MinHeight" Value="26"/>
			<Setter Property="Transitions">
				<Transitions>
					<DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
				</Transitions>
			</Setter>
		</Style>

		<!-- Collapsed expand chevron is dimmer -->
		<Style Selector="TreeViewItem:not(:expanded) /template/ ToggleButton#PART_ExpandCollapseChevron">
			<Setter Property="Opacity" Value="0.5"/>
		</Style>

		<Style Selector="ListBox">
			<Setter Property="Background" Value="{DynamicResource TextControlBackground}"/>
		</Style>

		<Style Selector="Button">
			<Setter Property="MinHeight" Value="30"/>
			<Setter Property="Height" Value="30"/>
			<Setter Property="MinWidth" Value="30"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="CornerRadius" Value="{ReflectionBinding UI.CornerRadius}"/>
			<Setter Property="Transitions">
				<Transitions>
					<DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
				</Transitions>
			</Setter>
		</Style>

		<Style Selector="Button:pressed">
			<Setter Property="Opacity" Value="0.7"/>
		</Style>

		<Style Selector="ToggleButton">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="{ReflectionBinding UI.CornerRadius}"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Transitions">
				<Transitions>
					<DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
				</Transitions>
			</Setter>
		</Style>

		<Style Selector="ToggleButton:pressed">
			<Setter Property="Opacity" Value="0.7"/>
		</Style>

		<!-- Subtle checked indicator for toggle buttons -->
		<Style Selector="ToggleButton:checked">
			<Setter Property="Opacity" Value="1.0"/>
		</Style>

		<Style Selector="ToggleButton:unchecked">
			<Setter Property="Opacity" Value="0.55"/>
		</Style>

		<Style Selector="ComboBox">
			<Setter Property="MinHeight" Value="30"/>
			<Setter Property="VerticalAlignment" Value="Top"/>
			<Setter Property="Margin" Value="0,-1,0,0"/>
			<Setter Property="CornerRadius" Value="{ReflectionBinding UI.CornerRadius}"/>
			<Setter Property="Padding" Value="12,4,0,0"/>
			<Setter Property="BorderThickness" Value="0"/>
		</Style>

		<Style Selector="TextBox">
			<Setter Property="MinHeight" Value="25"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Background" Value="{DynamicResource TextControlBackground}"/>
			<Setter Property="CornerRadius" Value="{ReflectionBinding UI.CornerRadius}"/>
			<Setter Property="Padding" Value="10,7,5,5"/>
			<Setter Property="Margin" Value="0"/>
			<Setter Property="ClipToBounds" Value="False"/>
		</Style>
		<Style Selector="TextBox /template/ Border#PART_BorderElement">
			<Setter Property="CornerRadius" Value="{ReflectionBinding UI.CornerRadius}"/>
			<Setter Property="ClipToBounds" Value="False"/>
		</Style>
		<Style Selector="Border.shadow TextBox">
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Margin" Value="0"/>
		</Style>

		<Style Selector="Label">
			<Setter Property="FontSize" Value="14"/>
		</Style>
		
		<Style Selector="MenuItem">
			<Setter Property="MinHeight" Value="0"/>
			<Setter Property="Height" Value="30"/>
		</Style>

		<!-- Separator lines in menus: subtle and thin -->
		<Style Selector="ContextMenu Separator">
			<Setter Property="Height" Value="1"/>
			<Setter Property="Margin" Value="8,4"/>
			<Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"/>
		</Style>

		<!-- Context menu container -->
		<Style Selector="ContextMenu">
			<Setter Property="Padding" Value="2,4"/>
		</Style>

		<Style Selector="Border">
			<Setter Property="CornerRadius" Value="{ReflectionBinding UI.CornerRadius}"/>
		</Style>

		<!-- Shadow border: use Classes="shadow" on a Border to get shadow, rounded corners, and optional visible border -->
		<Style Selector="Border.shadow">
			<Setter Property="BoxShadow" Value="{ReflectionBinding UI.Shadow}"/>
			<Setter Property="BorderThickness" Value="{ReflectionBinding UI.BorderThickness}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource DataGridGridLinesBrush}"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="MinHeight" Value="25"/>
			<Setter Property="Margin" Value="5"/>
			<Setter Property="CornerRadius" Value="{ReflectionBinding UI.CornerRadius}"/>
			<Setter Property="ClipToBounds" Value="False"/>
		</Style>

		<Style Selector="DataGridColumnHeader">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Height" Value="24"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
			<Setter Property="FontStyle" Value="Italic"/>
			<Setter Property="Opacity" Value="0.8"/>
			<Setter Property="Padding" Value="8,0,0,0"/>
		</Style>

		<Style Selector="DataGrid">
			<Setter Property="Background" Value="{DynamicResource TextControlBackground}"/>
			<Setter Property="CornerRadius" Value="{ReflectionBinding UI.CornerRadius}"/>
			<Setter Property="BorderThickness" Value="{ReflectionBinding UI.BorderThickness}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource DataGridGridLinesBrush}"/>
			<Setter Property="Padding" Value="5"/>
			<Setter Property="Margin" Value="0"/>
			<Setter Property="ClipToBounds" Value="False"/>
		</Style>
		<Style Selector="DataGrid /template/ Border#DataGridBorder">
			<Setter Property="BoxShadow" Value="{ReflectionBinding UI.Shadow}"/>
			<Setter Property="CornerRadius" Value="{ReflectionBinding UI.CornerRadius}"/>
			<Setter Property="BorderThickness" Value="{ReflectionBinding UI.BorderThickness}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource SystemBaseMediumLowColor}"/>
			<Setter Property="Margin" Value="5"/>
			<Setter Property="ClipToBounds" Value="False"/>
		</Style>
		
	
		<Style Selector="TextBlock">
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<Style Selector="DataGridCell">
			<Setter Property="MinHeight" Value="22"/>
		</Style>

		<Style Selector="DataGrid:focus DataGridCell:current /template/ Grid#FocusVisual">
			<Setter Property="IsVisible" Value="True" />
		</Style>

		<!-- Refined tooltips -->
		<Style Selector="ToolTip">
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Padding" Value="8,5"/>
			<Setter Property="CornerRadius" Value="6"/>
		</Style>


	</Application.Styles>
		
	
</Application>



