<Styles xmlns="https://github.com/avaloniaui">
    <!-- Button variants -->
    <Style Selector="Button.accent">
        <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}"/>
        <Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="{DynamicResource AppBorderThickness}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DataGridGridLinesBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="15"/>
    </Style>
    <Style Selector="Button.normal">
        <Setter Property="Background" Value="{DynamicResource TextControlBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextControlForeground}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource AppBorderThickness}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DataGridGridLinesBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="15"/>
    </Style>
    <Style Selector="Button.default">
        <Setter Property="Background" Value="{DynamicResource TextControlBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextControlForeground}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource AppBorderThickness}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DataGridGridLinesBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="15"/>
    </Style>

    <!-- Drop zone overlay (invisible, fades in on drag) -->
    <Style Selector="Border.DropZone">
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.DropZone.DragOver">
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="IsHitTestVisible" Value="True"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Background" Value="#20007ACC"/>
    </Style>

    <!-- Drop box (visible bordered area that highlights on drag) -->
    <Style Selector="Border.DropBox">
        <Setter Property="BorderBrush" Value="{DynamicResource DataGridGridLinesBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource AppCornerRadius}"/>
        <Setter Property="Background" Value="{DynamicResource TextControlBackground}"/>
    </Style>
    <Style Selector="Border.DropBox.DragOver">
        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Background" Value="#20007ACC"/>
    </Style>

    <!-- DataGrid row utilities -->
    <Style Selector="DataGridRow.Existing">
        <Setter Property="Opacity" Value="0.45"/>
    </Style>

    <!-- Settings panel layout -->
    <Style Selector="TextBlock.SectionHeader">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Opacity" Value="0.7"/>
        <Setter Property="Margin" Value="0,10,0,6"/>
    </Style>
    <Style Selector="Grid.SettingRow">
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Height" Value="36"/>
    </Style>
    <Style Selector="Grid.SettingRow > Label">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="Grid.SettingRow > ToggleSwitch">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,-4,0,0"/>
        <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="Grid.SettingRow > ColorPicker">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Grid.SettingRow > Slider">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Grid.SettingRow > Border">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
</Styles>
