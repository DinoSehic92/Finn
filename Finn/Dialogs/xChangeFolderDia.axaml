<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d"
		Width="500" Height="260"
		MinWidth="400" MinHeight="240"
		MaxHeight="300"
		xmlns:ic="using:FluentIcons.Avalonia"
		x:Class="Finn.Dialogs.xChangeFolderDia"
		Title="Change Folder Directory"
		xmlns:vm="clr-namespace:Finn.ViewModels"
		CanResize="False"
		WindowStartupLocation="CenterScreen"
		ExtendClientAreaToDecorationsHint="True"
		x:DataType="vm:MainViewModel">
	<Window.Styles>
		<Style Selector="Button.accent">
			<Setter Property="CornerRadius" Value="{Binding UI.CornerRadius}"/>
			<Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
			<Setter Property="BorderThickness" Value="{Binding UI.BorderThickness}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource DataGridGridLinesBrush}"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="FontSize" Value="15"/>
		</Style>
		<Style Selector="Button.normal">
			<Setter Property="Background" Value="{DynamicResource TextControlBackground}"/>
			<Setter Property="Foreground" Value="{DynamicResource TextControlForeground}"/>
			<Setter Property="BorderThickness" Value="{Binding UI.BorderThickness}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource DataGridGridLinesBrush}"/>
			<Setter Property="CornerRadius" Value="{Binding UI.CornerRadius}"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="FontSize" Value="15"/>
		</Style>
	</Window.Styles>

	<Grid RowDefinitions="30,*" Margin="0">
		<Panel Grid.Row="0" IsHitTestVisible="False"/>
		<StackPanel Grid.Row="1" Orientation="Vertical" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20,0">
			<StackPanel Orientation="Vertical" HorizontalAlignment="Center" Spacing="6" Margin="0,10,0,10">
				<Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource SystemAccentColor}" HorizontalAlignment="Center">
					<ContentControl>
						<ic:SymbolIcon Symbol="FolderArrowRight" FontSize="32" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</ContentControl>
				</Border>
				<TextBlock Name="HeaderText" Text="Change Folder Directory" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
				<TextBlock Name="SubHeaderText" Text="Select a new directory for this sync folder." FontSize="12" Opacity="0.7" HorizontalAlignment="Center"/>
			</StackPanel>

			<Grid ColumnDefinitions="*,Auto" Width="420">
				<TextBox Name="PathBox" Grid.Column="0" IsReadOnly="True" FontSize="13" Watermark="No folder selected"/>
				<Button Grid.Column="1" Width="36" Height="32" Padding="0" Margin="4,0,0,0" ToolTip.Tip="Browse…" Click="OnBrowse">
					<ic:SymbolIcon Symbol="FolderOpen" FontSize="16"/>
				</Button>
			</Grid>

			<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20" Margin="0,10,0,0">
				<Button Classes="accent" Content="Accept" Width="90" HotKey="Enter" Click="OnAccept"/>
				<Button Classes="normal" Content="Cancel" Width="90" HotKey="Escape" Click="OnCancel"/>
			</StackPanel>
		</StackPanel>
	</Grid>
</Window>
