<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d" d:DesignWidth="540" d:DesignHeight="690"
		Width="540" MinWidth="540" MaxWidth="540"
		Height="780" MinHeight="780" MaxHeight="780"
		xmlns:ic="using:FluentIcons.Avalonia"
		x:Class="Finn.Dialogs.xColorDia"
		Title="UI Settings"
		xmlns:vm="clr-namespace:Finn.ViewModels"
		xmlns:icxt="using:FluentIcons.Avalonia.MarkupExtensions"
		CanResize="False"
		WindowStartupLocation="CenterScreen"
		ExtendClientAreaToDecorationsHint="True"
		x:DataType="vm:MainViewModel">

	<Window.Styles>
		<Style Selector="Button.accent">
			<Setter Property="CornerRadius" Value="{Binding UI.CornerRadius}"/>
			<Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="FontSize" Value="15"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="BorderThickness" Value="{Binding UI.BorderThickness}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource DataGridGridLinesBrush}"/>
		</Style>
		<Style Selector="TextBlock.SectionHeader">
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Opacity" Value="0.7"/>
			<Setter Property="Margin" Value="0,10,0,6"/>
		</Style>
		<Style Selector="Grid.SettingRow">
			<Setter Property="Margin" Value="0,2"/>
			<Setter Property="Height" Value="36"/>
		</Style>
		<Style Selector="Grid.SettingRow > Label">
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Padding" Value="0"/>
		</Style>
		<Style Selector="Grid.SettingRow > ToggleSwitch">
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Margin" Value="0,-4,0,0"/>
			<Setter Property="MinHeight" Value="0"/>
		</Style>
		<Style Selector="Grid.SettingRow > ColorPicker">
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style Selector="Grid.SettingRow > Slider">
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style Selector="Grid.SettingRow > Border">
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
	</Window.Styles>

	<Grid RowDefinitions="30,Auto,*,Auto" Margin="0">
		<Panel Grid.Row="0" IsHitTestVisible="False"/>

		<!-- Centered header matching other dialogs -->
		<StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center" Spacing="6" Margin="0,10,0,10">
			<Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource SystemAccentColor}" HorizontalAlignment="Center">
				<ContentControl>
					<ic:SymbolIcon Symbol="Settings" FontSize="32" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
				</ContentControl>
			</Border>
			<TextBlock Text="UI Settings" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
		</StackPanel>

		<!-- Two-column content -->
		<Grid Grid.Row="2" ColumnDefinitions="*,Auto,*" Margin="20,0,20,0">

			<!-- ═══════ Left Column: Colors + Fonts ═══════ -->
			<StackPanel Grid.Column="0" Orientation="Vertical" Spacing="0">

				<!-- Dark Theme -->
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
					<TextBlock Classes="SectionHeader" Text="Dark Theme"/>
					<Button Click="ResetDark" BorderBrush="Transparent" Height="24" Width="24" MinHeight="0" MinWidth="0" Padding="0" Margin="0,8,0,0">
						<ic:SymbolIcon Symbol="ArrowReset" FontSize="15"/>
					</Button>
				</StackPanel>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*">
					<Label Content="Background"/><ColorPicker Grid.Column="1" Color="{Binding UI.Color1}" Width="80" HorizontalAlignment="Left" Name="BackgroundColorPickerDark"/>
				</Grid>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*">
					<Label Content="Accent"/><ColorPicker Grid.Column="1" Color="{Binding UI.Color2}" Width="80" HorizontalAlignment="Left" Name="AccentColorPickerDark"/>
				</Grid>

				<!-- Light Theme -->
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
					<TextBlock Classes="SectionHeader" Text="Light Theme"/>
					<Button Click="ResetLight" BorderBrush="Transparent" Height="24" Width="24" MinHeight="0" MinWidth="0" Padding="0" Margin="0,8,0,0">
						<ic:SymbolIcon Symbol="ArrowReset" FontSize="15"/>
					</Button>
				</StackPanel>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*">
					<Label Content="Background"/><ColorPicker Grid.Column="1" Color="{Binding UI.Color3}" Width="80" HorizontalAlignment="Left" Name="BackgroundColorPickerLight"/>
				</Grid>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*">
					<Label Content="Accent"/><ColorPicker Grid.Column="1" Color="{Binding UI.Color4}" Width="80" HorizontalAlignment="Left" Name="AccentColorPickerLight"/>
				</Grid>

				<!-- Fonts -->
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
					<TextBlock Classes="SectionHeader" Text="Fonts"/>
					<Button Click="ResetFonts" BorderBrush="Transparent" Height="24" Width="24" MinHeight="0" MinWidth="0" Padding="0" Margin="0,8,0,0">
						<ic:SymbolIcon Symbol="ArrowReset" FontSize="15"/>
					</Button>
				</StackPanel>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*">
					<Label Content="Font"/>
					<Border Grid.Column="1" Classes="shadow" Margin="0" MinHeight="0" HorizontalAlignment="Left">
						<ComboBox Name="FontCombo" Width="120" SelectedValue="{Binding UI.Font}" VerticalAlignment="Center"/>
					</Border>
				</Grid>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*">
					<Label Content="Size"/>
					<Border Grid.Column="1" Classes="shadow" Margin="0" MinHeight="0" HorizontalAlignment="Left">
						<ComboBox Name="FontSizeCombo" Width="120" SelectedValue="{Binding UI.FontSize}" VerticalAlignment="Center"/>
					</Border>
				</Grid>

				<!-- Layout -->
				<TextBlock Classes="SectionHeader" Text="Layout" HorizontalAlignment="Center"/>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*">
					<Label Content="Tree Width"/><Slider Grid.Column="1" Minimum="250" Maximum="350" Value="{Binding UI.TreeViewWidth}" IsSnapToTickEnabled="True" TickFrequency="10" Width="120" HorizontalAlignment="Left"/>
				</Grid>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*">
					<Label Content="Tray Width"/><Slider Grid.Column="1" Minimum="300" Maximum="400" Value="{Binding UI.TrayWidth}" IsSnapToTickEnabled="True" TickFrequency="10" Width="120" HorizontalAlignment="Left"/>
				</Grid>

				<!-- PDF Preview -->
				<TextBlock Classes="SectionHeader" Text="PDF Preview" HorizontalAlignment="Center"/>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*">
					<Label Content="Tint"/>
					<Border Grid.Column="1" Classes="shadow" Margin="0" MinHeight="0" HorizontalAlignment="Left">
						<ComboBox Name="DarkTintCombo" Width="120" ItemsSource="{x:Static vm:PreviewViewModel.DarkModeTintOptions}" SelectedValue="{Binding UI.PreviewDarkModeTint}" VerticalAlignment="Center"/>
					</Border>
				</Grid>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*">
						<Label Content="Tint Intensity"/><Slider Grid.Column="1" Minimum="0" Maximum="50" Value="{Binding UI.PreviewTintIntensity}" IsSnapToTickEnabled="True" TickFrequency="1" Width="120" HorizontalAlignment="Left"/>
				</Grid>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*">
					<Label Content="Paper"/>
					<Border Grid.Column="1" Classes="shadow" Margin="0" MinHeight="0" HorizontalAlignment="Left">
						<ComboBox Name="LightPaperCombo" Width="120" ItemsSource="{x:Static vm:PreviewViewModel.LightPaperOptions}" SelectedValue="{Binding UI.PreviewLightPaper}" VerticalAlignment="Center"/>
					</Border>
				</Grid>

			</StackPanel>

			<!-- Vertical separator -->
			<Border Grid.Column="1" Width="1" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Opacity="0.3" Margin="14,6,14,6"/>

			<!-- ═══════ Right Column: Toggles + Layout ═══════ -->
			<StackPanel Grid.Column="2" Orientation="Vertical" Spacing="0">

				<!-- Appearance -->
				<TextBlock Classes="SectionHeader" Text="Appearance" HorizontalAlignment="Center"/>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*">
					<Label Content="Dark Mode"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding UI.DarkMode}" HorizontalAlignment="Left"/>
				</Grid>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*">
					<Label Content="Shadows"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding UI.ShadowVal}" HorizontalAlignment="Left"/>
				</Grid>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*">
					<Label Content="Rounded"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding UI.CornerRadiusVal}" HorizontalAlignment="Left"/>
				</Grid>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*">
					<Label Content="Borders"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding UI.ShowBorders}" HorizontalAlignment="Left"/>
				</Grid>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*">
					<Label Content="Color Dots"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding UI.ColorTagDot}" HorizontalAlignment="Left"/>
				</Grid>

				<!-- View Toggles -->
				<TextBlock Classes="SectionHeader" Text="View Toggles" HorizontalAlignment="Center"/>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*">
					<Label Content="Icons"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding UI.ShowIcons}" HorizontalAlignment="Left"/>
				</Grid>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*">
					<Label Content="Action Bar"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding UI.ShowActionBar}" HorizontalAlignment="Left"/>
				</Grid>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*">
					<Label Content="Thumbnails"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding UI.ShowThumbnails}" HorizontalAlignment="Left"/>
				</Grid>

				<!-- PDF Preview -->
				<TextBlock Classes="SectionHeader" Text="PDF Preview" HorizontalAlignment="Center"/>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*">
					<Label Content="Dark Default"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding UI.PreviewDarkMode}" HorizontalAlignment="Left"/>
				</Grid>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*">
					<Label Content="Auto Cache"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding UI.AutoCacheNetworkFiles}" HorizontalAlignment="Left"/>
				</Grid>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*">
						<Label Content="Read Bytes" ToolTip.Tip="Read entire file into memory before opening. Avoids file locks on network shares but uses more memory."/><ToggleSwitch Grid.Column="1" IsChecked="{Binding UI.ReadBytesMode}" HorizontalAlignment="Left"/>
					</Grid>

					<!-- Folder Sync -->
					<TextBlock Classes="SectionHeader" Text="Folder Sync" HorizontalAlignment="Center"/>
					<Grid Classes="SettingRow" ColumnDefinitions="90,*">
						<Label Content="Auto Watch" ToolTip.Tip="Monitor sync folders for changes and check for differences at startup."/><ToggleSwitch Grid.Column="1" IsChecked="{Binding UI.FolderWatchEnabled}" HorizontalAlignment="Left"/>
					</Grid>
			</StackPanel>

		</Grid>

		<!-- Footer buttons pinned at bottom -->
		<StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,8,0,14">
			<Button Classes="accent" Width="80" Content="Save" Click="OnSave" Background="{DynamicResource TextControlBackground}"/>
			<Button Classes="accent" Width="80" Content="Close" Click="OnClose" Background="{DynamicResource TextControlBackground}"/>
		</StackPanel>
	</Grid>

</Window>
