<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d" d:DesignWidth="540" d:DesignHeight="690"
		Width="540" MinWidth="540" MaxWidth="540"
		SizeToContent="Height"
		xmlns:ic="using:FluentIcons.Avalonia"
		x:Class="Finn.Dialogs.xColorDia"
		Title=""
		xmlns:vm="clr-namespace:Finn.ViewModels"
		xmlns:icxt="using:FluentIcons.Avalonia.MarkupExtensions"
		CanResize="False"
		WindowStartupLocation="CenterScreen"
		ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="30"
		xmlns:controls="clr-namespace:Finn.Controls"
		x:DataType="vm:MainViewModel"
		Foreground="{DynamicResource AppForegroundBrush}"
		Background="{DynamicResource AppShellSurfaceBrush}">

	<Window.Styles>
		<Style Selector="Label">
			<Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
		</Style>
		<Style Selector="Label /template/ ContentPresenter">
			<Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
		</Style>
	</Window.Styles>

	<Grid RowDefinitions="30,Auto,*,Auto" Margin="0">
		<Panel Grid.Row="0" IsHitTestVisible="False"/>

		<!-- Centered header matching other dialogs -->
		<controls:DialogHeader Grid.Row="1" Icon="Settings" Title="UI Settings"/>

		<!-- Two-column content -->
		<Grid Grid.Row="2" ColumnDefinitions="*,Auto,*" Margin="20,0,20,0">

			<!-- ═══════ Left Column: Colors + Fonts ═══════ -->
			<StackPanel Grid.Column="0" Orientation="Vertical" Spacing="0" Name="ColorPickerPanel">

				<!-- Dark Theme -->
				<TextBlock Classes="SectionHeader" Text="Dark Theme" HorizontalAlignment="Center"/>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*">
					<Label Content="Preset"/>
					<Border Grid.Column="1" Classes="shadow" Margin="0" MinHeight="0" HorizontalAlignment="Left">
						<ComboBox Name="DarkPresetCombo" Width="120" VerticalAlignment="Center"/>
					</Border>
				</Grid>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*">
					<Label Content="Background"/>
					<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
						<ColorPicker Color="{Binding UI.Color1}" Width="80" HorizontalAlignment="Left" Name="BackgroundColorPickerDark"/>
						<Button Content="Auto" Click="OnAutoGenerateDark" Height="24" Padding="6,0" MinWidth="0" FontSize="11"
								ToolTip.Tip="Auto-generate Text, Grid and Border colors from this background"/>
					</StackPanel>
				</Grid>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*">
					<Label Content="Accent"/><ColorPicker Grid.Column="1" Color="{Binding UI.Color2}" Width="80" HorizontalAlignment="Left" Name="AccentColorPickerDark"/>
				</Grid>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*">
					<Label Content="Text"/>
					<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
						<ToggleSwitch IsChecked="{Binding UI.DarkTextColorEnabled}" OnContent="" OffContent="" Width="42" Padding="0" HorizontalAlignment="Left"/>
						<ColorPicker Color="{Binding UI.DarkTextColor}" Width="80" HorizontalAlignment="Left" Name="TextColorPickerDark"/>
					</StackPanel>
				</Grid>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*">
					<Label Content="Grid"/>
					<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
						<ToggleSwitch IsChecked="{Binding UI.DarkPanelColorEnabled}" OnContent="" OffContent="" Width="42" Padding="0" HorizontalAlignment="Left"/>
						<ColorPicker Color="{Binding UI.DarkPanelColor}" Width="80" HorizontalAlignment="Left" Name="PanelColorPickerDark"/>
					</StackPanel>
				</Grid>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*">
					<Label Content="Border"/>
					<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
						<ToggleSwitch IsChecked="{Binding UI.DarkBorderColorEnabled}" OnContent="" OffContent="" Width="42" Padding="0" HorizontalAlignment="Left"/>
						<ColorPicker Color="{Binding UI.DarkBorderColor}" Width="80" HorizontalAlignment="Left" Name="BorderColorPickerDark"/>
					</StackPanel>
				</Grid>

				<!-- Light Theme -->
				<TextBlock Classes="SectionHeader" Text="Light Theme" HorizontalAlignment="Center"/>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*">
					<Label Content="Preset"/>
					<Border Grid.Column="1" Classes="shadow" Margin="0" MinHeight="0" HorizontalAlignment="Left">
						<ComboBox Name="LightPresetCombo" Width="120" VerticalAlignment="Center"/>
					</Border>
				</Grid>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*">
					<Label Content="Background"/>
					<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
						<ColorPicker Color="{Binding UI.Color3}" Width="80" HorizontalAlignment="Left" Name="BackgroundColorPickerLight"/>
						<Button Content="Auto" Click="OnAutoGenerateLight" Height="24" Padding="6,0" MinWidth="0" FontSize="11"
								ToolTip.Tip="Auto-generate Text, Grid and Border colors from this background"/>
					</StackPanel>
				</Grid>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*">
					<Label Content="Accent"/><ColorPicker Grid.Column="1" Color="{Binding UI.Color4}" Width="80" HorizontalAlignment="Left" Name="AccentColorPickerLight"/>
				</Grid>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*">
					<Label Content="Text"/>
					<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
						<ToggleSwitch IsChecked="{Binding UI.LightTextColorEnabled}" OnContent="" OffContent="" Width="42" Padding="0" HorizontalAlignment="Left"/>
						<ColorPicker Color="{Binding UI.LightTextColor}" Width="80" HorizontalAlignment="Left" Name="TextColorPickerLight"/>
					</StackPanel>
				</Grid>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*">
					<Label Content="Grid"/>
					<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
						<ToggleSwitch IsChecked="{Binding UI.LightPanelColorEnabled}" OnContent="" OffContent="" Width="42" Padding="0" HorizontalAlignment="Left"/>
						<ColorPicker Color="{Binding UI.LightPanelColor}" Width="80" HorizontalAlignment="Left" Name="PanelColorPickerLight"/>
					</StackPanel>
				</Grid>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*">
					<Label Content="Border"/>
					<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
						<ToggleSwitch IsChecked="{Binding UI.LightBorderColorEnabled}" OnContent="" OffContent="" Width="42" Padding="0" HorizontalAlignment="Left"/>
						<ColorPicker Color="{Binding UI.LightBorderColor}" Width="80" HorizontalAlignment="Left" Name="BorderColorPickerLight"/>
					</StackPanel>
				</Grid>

				<!-- Fonts -->
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4" IsVisible="{Binding UI.SuperuserMode}">
						<TextBlock Classes="SectionHeader" Text="Fonts"/>
						<Button Click="ResetFonts" BorderBrush="Transparent" Height="24" Width="24" MinHeight="0" MinWidth="0" Padding="0" Margin="0,8,0,0">
							<ic:SymbolIcon Symbol="ArrowReset" FontSize="15"/>
						</Button>
					</StackPanel>
					<Grid Classes="SettingRow" ColumnDefinitions="90,*" IsVisible="{Binding UI.SuperuserMode}">
						<Label Content="Font"/>
						<Border Grid.Column="1" Classes="shadow" Margin="0" MinHeight="0" HorizontalAlignment="Left">
							<ComboBox Name="FontCombo" Width="120" SelectedValue="{Binding UI.Font}" VerticalAlignment="Center"/>
						</Border>
					</Grid>
					<Grid Classes="SettingRow" ColumnDefinitions="90,*" IsVisible="{Binding UI.SuperuserMode}">
						<Label Content="Size"/>
						<Border Grid.Column="1" Classes="shadow" Margin="0" MinHeight="0" HorizontalAlignment="Left">
							<ComboBox Name="FontSizeCombo" Width="120" SelectedValue="{Binding UI.FontSize}" VerticalAlignment="Center"/>
						</Border>
					</Grid>

				<!-- Layout -->
				<TextBlock Classes="SectionHeader" Text="Layout" HorizontalAlignment="Center" IsVisible="{Binding UI.SuperuserMode}"/>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*" IsVisible="{Binding UI.SuperuserMode}">
					<Label Content="Tree Width"/><Slider Grid.Column="1" Minimum="250" Maximum="350" Value="{Binding UI.TreeViewWidth}" IsSnapToTickEnabled="True" TickFrequency="10" Width="120" HorizontalAlignment="Left"/>
				</Grid>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*" IsVisible="{Binding UI.SuperuserMode}">
					<Label Content="Tray Width"/><Slider Grid.Column="1" Minimum="300" Maximum="400" Value="{Binding UI.TrayWidth}" IsSnapToTickEnabled="True" TickFrequency="10" Width="120" HorizontalAlignment="Left"/>
				</Grid>

				<!-- PDF Preview -->
				<TextBlock Classes="SectionHeader" Text="PDF Preview" HorizontalAlignment="Center" IsVisible="{Binding UI.SuperuserMode}"/>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*" IsVisible="{Binding UI.SuperuserMode}">
					<Label Content="Tint"/>
					<Border Grid.Column="1" Classes="shadow" Margin="0" MinHeight="0" HorizontalAlignment="Left">
						<ComboBox Name="DarkTintCombo" Width="120" ItemsSource="{x:Static vm:PreviewViewModel.DarkModeTintOptions}" SelectedValue="{Binding UI.PreviewDarkModeTint}" VerticalAlignment="Center"/>
					</Border>
				</Grid>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*" IsVisible="{Binding UI.SuperuserMode}">
						<Label Content="Tint Intensity"/><Slider Grid.Column="1" Minimum="0" Maximum="50" Value="{Binding UI.PreviewTintIntensity}" IsSnapToTickEnabled="True" TickFrequency="1" Width="120" HorizontalAlignment="Left"/>
				</Grid>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*" IsVisible="{Binding UI.SuperuserMode}">
					<Label Content="Paper"/>
					<Border Grid.Column="1" Classes="shadow" Margin="0" MinHeight="0" HorizontalAlignment="Left">
						<ComboBox Name="LightPaperCombo" Width="120" ItemsSource="{x:Static vm:PreviewViewModel.LightPaperOptions}" SelectedValue="{Binding UI.PreviewLightPaper}" VerticalAlignment="Center"/>
					</Border>
				</Grid>

			</StackPanel>

			<!-- Vertical separator -->
			<Border Grid.Column="1" Width="1" Background="{DynamicResource AppDividerBrush}" Opacity="0.5" Margin="14,6,14,6"/>

			<!-- ═══════ Right Column: Toggles + Layout ═══════ -->
			<StackPanel Grid.Column="2" Orientation="Vertical" Spacing="0">

				<!-- Mode -->
				<TextBlock Classes="SectionHeader" Text="Mode" HorizontalAlignment="Center"/>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*">
					<Label Content="Superuser" ToolTip.Tip="Show advanced features: shared projects, calendar, dual-file mode, diff comparison, metadata tools, and more."/><ToggleSwitch Grid.Column="1" IsChecked="{Binding UI.SuperuserMode}" HorizontalAlignment="Left"/>
				</Grid>

				<!-- Appearance -->
				<TextBlock Classes="SectionHeader" Text="Appearance" HorizontalAlignment="Center"/>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*">
					<Label Content="Dark Mode"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding UI.DarkMode}" HorizontalAlignment="Left"/>
				</Grid>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*">
					<Label Content="Shadows"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding UI.ShadowVal}" HorizontalAlignment="Left"/>
				</Grid>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*">
					<Label Content="Rounded"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding UI.CornerRadiusVal}" HorizontalAlignment="Left"/>
				</Grid>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*">
					<Label Content="Borders"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding UI.ShowBorders}" HorizontalAlignment="Left"/>
				</Grid>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*" IsVisible="{Binding UI.SuperuserMode}">
						<Label Content="Color Dots"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding UI.ColorTagDot}" HorizontalAlignment="Left"/>
					</Grid>
					<Grid Classes="SettingRow" ColumnDefinitions="90,*" IsVisible="{Binding UI.SuperuserMode}">
						<Label Content="Alt. Rows" ToolTip.Tip="Alternating background shading on grid rows for readability"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding UI.AlternatingRowShading}" HorizontalAlignment="Left"/>
					</Grid>

				<!-- View Toggles -->
				<TextBlock Classes="SectionHeader" Text="View Toggles" HorizontalAlignment="Center" IsVisible="{Binding UI.SuperuserMode}"/>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*" IsVisible="{Binding UI.SuperuserMode}">
					<Label Content="Icons"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding UI.ShowIcons}" HorizontalAlignment="Left"/>
				</Grid>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*" IsVisible="{Binding UI.SuperuserMode}">
					<Label Content="Action Bar"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding UI.ShowActionBar}" HorizontalAlignment="Left"/>
				</Grid>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*" IsVisible="{Binding UI.SuperuserMode}">
					<Label Content="Thumbnails"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding UI.ShowThumbnails}" HorizontalAlignment="Left"/>
				</Grid>

				<!-- PDF Preview -->
				<TextBlock Classes="SectionHeader" Text="PDF Preview" HorizontalAlignment="Center" IsVisible="{Binding UI.SuperuserMode}"/>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*" IsVisible="{Binding UI.SuperuserMode}">
					<Label Content="Dark Default"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding UI.PreviewDarkMode}" HorizontalAlignment="Left"/>
				</Grid>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*" IsVisible="{Binding UI.SuperuserMode}">
					<Label Content="Auto Cache"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding UI.AutoCacheNetworkFiles}" HorizontalAlignment="Left"/>
				</Grid>
				<Grid Classes="SettingRow" ColumnDefinitions="90,*" IsVisible="{Binding UI.SuperuserMode}">
						<Label Content="Read Bytes" ToolTip.Tip="Read entire file into memory before opening. Avoids file locks on network shares but uses more memory."/><ToggleSwitch Grid.Column="1" IsChecked="{Binding UI.ReadBytesMode}" HorizontalAlignment="Left"/>
					</Grid>

					<!-- Folder Sync -->
					<TextBlock Classes="SectionHeader" Text="Folder Sync" HorizontalAlignment="Center" IsVisible="{Binding UI.SuperuserMode}"/>
					<Grid Classes="SettingRow" ColumnDefinitions="90,*" IsVisible="{Binding UI.SuperuserMode}">
						<Label Content="Auto Watch" ToolTip.Tip="Monitor sync folders for changes and check for differences at startup."/><ToggleSwitch Grid.Column="1" IsChecked="{Binding UI.FolderWatchEnabled}" HorizontalAlignment="Left"/>
					</Grid>
			</StackPanel>

		</Grid>

		<!-- Footer buttons pinned at bottom -->
		<StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,8,0,14">
			<Button Classes="accent" Width="80" Content="Save" Click="OnSave" Background="{DynamicResource TextControlBackground}"/>
           <Button Classes="normal" Width="80" Content="Cancel" Click="OnClose"/>
		</StackPanel>
	</Grid>

</Window>
