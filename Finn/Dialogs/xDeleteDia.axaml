<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="160"
		MinWidth="300"
		MinHeight="160"
		MaxWidth="300"
		MaxHeight="160"
		xmlns:ic="using:FluentIcons.Avalonia"
        x:Class="Finn.Dialogs.xDeleteDia"
        Title=""
		xmlns:vm="clr-namespace:Finn.ViewModels"
		CanResize="False"
		WindowStartupLocation="CenterScreen"
		ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="30"
		xmlns:controls="clr-namespace:Finn.Controls"
		x:DataType="vm:MainViewModel">

	<Grid RowDefinitions="30,*" ColumnDefinitions="*" VerticalAlignment="Top" Margin="0">
		<Panel Grid.Row="0" IsHitTestVisible="False"/>
		<StackPanel Grid.Row="1" Orientation="Vertical" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Top">
			<controls:DialogHeader Icon="Warning" Title="Remove?"/>
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
				<Button Name="ConfirmButton" HotKey="Enter" Width="80" Classes="accent" Content="Confirm" Click="OnConfirm"/>
				<Button Name="CancelButton" HotKey="Escape" Width="80" Classes="normal" Content="Cancel" Click="OnCancel"/>
			</StackPanel>
		</StackPanel>
	</Grid>

</Window>