<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Finn.Controls"
        x:Class="Finn.Dialogs.AnalogWatchDialog"
        Width="250" Height="270"
        Title="Analog Clock"
        CanResize="False"
        xmlns:vm="clr-namespace:Finn.ViewModels"
        ExtendClientAreaToDecorationsHint="True"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource TextControlBackground}">
    <Grid >
        <controls:AnalogWatchControl Width="220" Height="220" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</Window>
