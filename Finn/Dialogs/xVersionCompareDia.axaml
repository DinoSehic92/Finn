<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ic="using:FluentIcons.Avalonia"
        xmlns:vm="clr-namespace:Finn.ViewModels"
        mc:Ignorable="d" d:DesignWidth="340" d:DesignHeight="460"
        Width="340" SizeToContent="Height"
        x:Class="Finn.Dialogs.xVersionCompareDia"
        x:DataType="vm:MainViewModel"
        Title="Compare Versions"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True">

    <Window.Styles>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="{Binding UI.CornerRadius}"/>
            <Setter Property="BorderThickness" Value="{Binding UI.BorderThickness}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DataGridGridLinesBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style Selector="Button.normal">
            <Setter Property="Background" Value="{DynamicResource TextControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextControlForeground}"/>
            <Setter Property="CornerRadius" Value="{Binding UI.CornerRadius}"/>
            <Setter Property="BorderThickness" Value="{Binding UI.BorderThickness}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DataGridGridLinesBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="30,Auto,*,Auto" Margin="12">
        <Panel Grid.Row="0" IsHitTestVisible="False"/>

        <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center" Spacing="6" Margin="0,10,0,16">
            <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource SystemAccentColor}" HorizontalAlignment="Center">
                <ContentControl>
                    <ic:SymbolIcon Symbol="ItemCompare" FontSize="32" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </ContentControl>
            </Border>
            <TextBlock Text="Compare Versions" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Select two versions to compare." FontSize="13" FontStyle="Italic" Opacity="0.6" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Version list — Classes="shadow" applies UI.CornerRadius, UI.Shadow and UI.BorderThickness from App.axaml global styles -->
        <Border Grid.Row="2" Classes="shadow" Padding="6,4" MinHeight="80" Margin="0,0,0,0" Background="{DynamicResource TextControlBackground}">
            <StackPanel Spacing="2">
                <Grid ColumnDefinitions="28,28,*" Margin="0,2,0,6">
                    <TextBlock Text="A" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Opacity="0.5"/>
                    <TextBlock Text="B" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Grid.Column="1" Opacity="0.5"/>
                    <TextBlock Text="Version" FontSize="11" FontWeight="SemiBold" Grid.Column="2" Margin="6,0,0,0" Opacity="0.5"/>
                </Grid>
                <StackPanel Name="VersionRows" Spacing="2"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Vertical" Spacing="8" Margin="0,12,0,4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                <Button Content="Cancel" Width="90" Padding="16,6" Classes="normal" Click="OnCancel" HotKey="Escape"/>
                <Button Name="CompareBtn" Content="Compare" Width="105" Padding="16,6" Click="OnCompare" Classes="accent" HotKey="Enter"/>
            </StackPanel>
            <Button Name="DiagnoseBtn" Content="🔍 Run Stripping Diagnostics on A" Width="280" Padding="8,4"
                    Classes="normal" Click="OnDiagnose"
                    FontSize="12" Opacity="0.7" IsVisible="False"
                    ToolTip.Tip="Dumps header/footer zone words, fingerprints and per-page strip results to a temp file"/>
        </StackPanel>
    </Grid>
</Window>
