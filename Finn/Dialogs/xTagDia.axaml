<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="220"
        MinWidth="280"
        MinHeight="220"
        MaxWidth="280"
        MaxHeight="220"
        xmlns:ic="using:FluentIcons.Avalonia"
        x:Class="Finn.Dialogs.xTagDia"
        Title=""
        xmlns:vm="clr-namespace:Finn.ViewModels"
        xmlns:controls="clr-namespace:Finn.Controls"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="30"
        x:DataType="vm:MainViewModel">

    <Grid RowDefinitions="30,*" ColumnDefinitions="*" VerticalAlignment="Top" Margin="0">
        <Panel Grid.Row="0" IsHitTestVisible="False"/>
        <StackPanel Grid.Row="1" Orientation="Vertical" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Top">
            <controls:DialogHeader Icon="TagQuestionMark" Title="Edit Tag"/>
            <TextBox Name="TagMenuInput" HorizontalContentAlignment="Center" Width="220"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,8,0,16">
                <Button Name="TagAccept" HotKey="Enter" Content="Accept" Width="80" Classes="accent" Click="OnSetTag"/>
                <Button Name="TagCancel" Content="Cancel" Width="80" Classes="normal" Click="OnCancel"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>