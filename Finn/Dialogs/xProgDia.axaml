<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d" d:DesignWidth="350" d:DesignHeight="320"
		MinWidth="350"
		MaxWidth="350"
		xmlns:ic="using:FluentIcons.Avalonia"
		x:Class="Finn.Dialogs.xProgDia"
		Title="Info"
		xmlns:vm="clr-namespace:Finn.ViewModels"
		CanResize="False"
		WindowStartupLocation="CenterScreen"
		ExtendClientAreaToDecorationsHint="True"
		SizeToContent="Height"
		x:DataType="vm:MainViewModel">

		<Grid RowDefinitions="30,*" ColumnDefinitions="*" VerticalAlignment="Top" Margin="0">
			<Panel Grid.Row="0" IsHitTestVisible="False"/>
			<StackPanel Grid.Row="1" Width="300" Orientation="Vertical" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,18">
			<StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" Margin="0,10,0,16">
				<Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource SystemAccentColor}" HorizontalAlignment="Center">
					<ContentControl>
						<ic:SymbolIcon Symbol="Info" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</ContentControl>
				</Border>
				<TextBlock Text="Info" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
			</StackPanel>
				<Grid Name="Info" HorizontalAlignment="Center" ColumnDefinitions="150,150" RowDefinitions="35,35,35">

					<Label Grid.Row="0" Grid.Column="0" Content="Compiled Date" VerticalAlignment="Center"/>
					<Label Grid.Row="1" Grid.Column="0" Content="Last Saved" VerticalAlignment="Center"/>
					<Label Grid.Row="2" Grid.Column="0" Content="Nr Files" VerticalAlignment="Center"/>

					<Label Name="CompiledDate" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center"/>
					<Label Name="LastSaved" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"/>
					<Label Name="NrFiles" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"/>

				</Grid>

				<!-- Cache info section -->
				<Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DataGridGridLinesBrush}" Padding="0,10,0,0" Margin="0,4,0,0">
					<Grid HorizontalAlignment="Center" ColumnDefinitions="150,150" RowDefinitions="28,28,Auto">
						<StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
							<ic:SymbolIcon Symbol="Database" IconVariant="Regular" FontSize="13" Opacity="0.6"/>
							<TextBlock Text="Cached Files" VerticalAlignment="Center"/>
						</StackPanel>
						<Label Name="CacheCountLabel" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center"/>

						<TextBlock Grid.Row="1" Grid.Column="0" Text="Cache Size" VerticalAlignment="Center"/>
						<Label Name="CacheSizeLabel" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"/>

						<Button Name="ClearCacheBtn" Grid.Row="2" Grid.ColumnSpan="2" Content="Clear Cache"
								HorizontalAlignment="Center" Margin="0,6,0,0" Padding="12,4"
								Click="OnClearCache" BorderThickness="0"/>
					</Grid>
				</Border>
			</StackPanel>
		</Grid>


</Window>
